<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>WheelSetupCollector</AssemblyName>
    <RootNamespace>WheelSetupCollector</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No EnableCompressionInSingleFile: compressed single-file payloads are
         a common silent-block false positive for third-party antivirus.
         Uncompressed is larger but far less likely to be eaten. -->

    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
