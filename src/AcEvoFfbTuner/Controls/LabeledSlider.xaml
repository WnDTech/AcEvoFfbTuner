<UserControl x:Class="AcEvoFfbTuner.Controls.LabeledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <Border x:Name="GlowBorder" CornerRadius="{DynamicResource UiR4}" Padding="0,0" Margin="0,0"
            BorderThickness="0" BorderBrush="Transparent">
        <StackPanel x:Name="RootPanel" PreviewMouseWheel="OnPreviewMouseWheel">
            <TextBlock x:Name="PART_LabelAbove"
                       FontSize="15"
                       Text=""
                       Visibility="Collapsed"
                       Margin="0,2,0,0" />
            <TextBlock x:Name="PART_Description"
                       FontSize="13"
                       Foreground="{DynamicResource UiTextDim}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
            <DockPanel x:Name="SliderRow" Margin="0,4,0,0">
                <CheckBox x:Name="PART_CheckBox"
                          DockPanel.Dock="Left"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Visibility="Collapsed" />

                <TextBlock x:Name="PART_Label"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           FontSize="15"
                           TextWrapping="Wrap"
                           Text="" />

                <Button x:Name="PART_ResetButton"
                        DockPanel.Dock="Right"
                        Width="24" Height="24"
                        VerticalAlignment="Center"
                        Margin="2,0,0,0"
                        Cursor="Hand"
                        Visibility="Hidden"
                        Click="OnResetClick"
                        ToolTip="Reset to default value">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ResetBd" Background="Transparent" CornerRadius="{DynamicResource UiR3}" Padding="2">
                                <TextBlock Text="&#x21BA;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource UiTextDim}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ResetBd" Property="Background" Value="{DynamicResource UiHover2}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBox x:Name="PART_ValueTextBox"
                         DockPanel.Dock="Right"
                         MinWidth="72"
                         VerticalAlignment="Center"
                         FontSize="14"
                         TextAlignment="Right"
                         Margin="8,0,0,0"
                         Padding="4,2"
                         IsReadOnly="False"
                         GotFocus="OnTextBoxGotFocus"
                         LostFocus="OnTextBoxLostFocus"
                         KeyDown="OnTextBoxKeyDown">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="{DynamicResource UiInput}" />
                            <Setter Property="Foreground" Value="{DynamicResource UiText}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource UiInputBorder}" />
                            <Setter Property="CaretBrush" Value="{DynamicResource UiAccent}" />
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontFamily" Value="{DynamicResource UiValueFont}" />
                            <Setter Property="ToolTip" Value="Click to type a value" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource UiInputBorderHover}" />
                                    <Setter Property="Background" Value="{DynamicResource UiInputHoverBg}" />
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource UiInputFocusBg}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource UiAccent}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <StackPanel x:Name="SliderColumn" VerticalAlignment="Center">
                <Grid>
                <Slider x:Name="PART_Slider"
                        VerticalAlignment="Center"
                        Height="36"
                        Minimum="0"
                        Maximum="10000"
                        SmallChange="1"
                        LargeChange="100"
                        ValueChanged="OnSliderValueChanged"
                        PreviewMouseDown="OnSliderPreviewMouseDown"
                        PreviewMouseUp="OnSliderPreviewMouseUp"
                        Template="{DynamicResource UiLabeledSliderTemplate}">
                </Slider>
                <!-- Default-position marker (placed in code-behind) -->
                <Canvas x:Name="PART_DefaultCanvas" IsHitTestVisible="False" Height="36" VerticalAlignment="Center">
                    <Border x:Name="PART_DefaultMarker" Width="2" Height="20" Canvas.Top="8"
                            Background="{DynamicResource UiDefaultMarker}" CornerRadius="{DynamicResource UiR1}" Visibility="Collapsed" />
                </Canvas>
                </Grid>
                <Grid x:Name="PART_EndsRow" Margin="4,0,4,0" Visibility="Collapsed">
                    <TextBlock x:Name="PART_LowLabel" HorizontalAlignment="Left" FontSize="11.5"
                               Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" MaxWidth="260" />
                    <TextBlock x:Name="PART_HighLabel" HorizontalAlignment="Right" FontSize="11.5"
                               Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" TextAlignment="Right" MaxWidth="260" />
                </Grid>
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="PART_Meaning"
                       FontSize="12"
                       Foreground="{DynamicResource UiMeaning}"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis"
                       Height="17"
                       Margin="0,6,30,0"
                       Visibility="Collapsed" />

        </StackPanel>
    </Border>
</UserControl>
