<Window x:Class="AcEvoFfbTuner.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AC Evo FFB Tuner"
        Width="620" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <!-- Splash runs on its own UI thread: block the app-wide implicit
         styles (owned by the main thread) from being looked up here. -->
    <Window.Resources>
        <Style TargetType="Window" />
        <Style TargetType="TextBlock" />
        <Style TargetType="Border" />
    </Window.Resources>

    <Grid x:Name="RootLayer" Opacity="0">
    <!-- Glow lives on a separate STATIC layer (bitmap-cached) so the blur is
         rendered once instead of re-blurring the whole window every frame
         while the wheel and border animate. -->
    <Border x:Name="GlowLayer" CornerRadius="14" Margin="10"
            Background="{DynamicResource BgDark}">
        <Border.CacheMode>
            <BitmapCache />
        </Border.CacheMode>
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="40" ShadowDepth="0"
                              Opacity="0.25" />
        </Border.Effect>
    </Border>
    <Border x:Name="RootBorder" CornerRadius="14" Margin="10"
            BorderBrush="{DynamicResource AccentGlow}" BorderThickness="1"
            Background="{DynamicResource BgDark}">

        <Grid>
            <Border x:Name="DashBorder" CornerRadius="14" BorderThickness="2"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Panel.ZIndex="1">
                <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                <Border.RenderTransform>
                    <RotateTransform x:Name="DashRotation" Angle="0" />
                </Border.RenderTransform>
            </Border>

            <Grid Margin="30" Panel.ZIndex="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" HorizontalAlignment="Center"
                      VerticalAlignment="Center" x:Name="WheelHost"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="WheelScale"
                                            ScaleX="0.7" ScaleY="0.7"
                                            CenterX="100" CenterY="100" />
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid x:Name="WheelContainer" Width="200" Height="200"
                          RenderTransformOrigin="0.5,0.5">
                        <!-- Rasterize the wheel once; rotation then just
                             transforms the cached texture on the GPU. -->
                        <Grid.CacheMode>
                            <BitmapCache RenderAtScale="1.5" />
                        </Grid.CacheMode>
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="WheelRotation" Angle="0" />
                                <TranslateTransform x:Name="WheelShake" X="0" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Image x:Name="WheelImage"
                               RenderOptions.BitmapScalingMode="Linear"
                               Width="200" Height="200" />
                    </Grid>
                </Grid>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0,10,0,0"
                            x:Name="TitlePanel"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="TitleSlide" Y="12" />
                    </StackPanel.RenderTransform>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="AC EVO" FontSize="36" FontWeight="Black"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="Segoe UI" />
                        <TextBlock Text=" FFB TUNER" FontSize="36" FontWeight="Light"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Segoe UI" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="VersionBadge" Grid.Row="2"
                        HorizontalAlignment="Center" Margin="0,8,0,0"
                        CornerRadius="10" Padding="12,4"
                        Background="{DynamicResource AccentDimBg}"
                        BorderBrush="{DynamicResource AccentGlow}"
                        BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="VersionSlide" Y="8" />
                    </Border.RenderTransform>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="12"
                                   FontWeight="SemiBold" FontFamily="Segoe UI"
                                   Foreground="{DynamicResource AccentHoverBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="  " FontSize="12" />
                        <Border Background="#22FFFFFF" CornerRadius="4"
                                Padding="5,1" VerticalAlignment="Center"
                                Margin="2,0,0,0">
                            <TextBlock x:Name="CommitText" FontSize="10"
                                       FontWeight="Normal"
                                       FontFamily="Cascadia Mono,Consolas"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" Grid.Row="3"
                           Text="Starting up..." FontSize="15"
                           Foreground="{DynamicResource TextDimBrush}"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI" Margin="0,10,0,0" />

                <Grid Grid.Row="4" Margin="0,8,0,0" x:Name="ProgressContainer">
                    <Border Background="{DynamicResource BgInput}" Height="4"
                            CornerRadius="2" />
                    <Border x:Name="ProgressFill" Height="4"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                    <Canvas ClipToBounds="True" Height="4">
                        <Border x:Name="ShimmerHighlight" Width="80" Height="4"
                                CornerRadius="2" Canvas.Top="0" Canvas.Left="-80"
                                Opacity="0.35">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="#FFFFFFFF" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
