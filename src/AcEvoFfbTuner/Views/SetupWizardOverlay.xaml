<Window x:Class="AcEvoFfbTuner.Views.SetupWizardOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFB Tuner — Setup Wizard"
        Width="560"
        Height="760"
        MinWidth="420"
        MinHeight="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <Window.Resources>
        <Style x:Key="WizardButton" TargetType="Button">
            <Setter Property="Background" Value="#FF30363D" />
            <Setter Property="Foreground" Value="#FFE6EDF3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE6EDF3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF161B22" />
            <Setter Property="BorderBrush" Value="#FF30363D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8B949E" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF0883E" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFE6EDF3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE6EDF3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" Padding="1" Background="#55F0883E" MouseWheel="Window_MouseWheel">
        <Border CornerRadius="7" Background="#F00D1117">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ═══ HEADER ═══ -->
                <Border Grid.Row="0" Background="#FF161B22" CornerRadius="7,7,0,0" Padding="14,10" MouseDown="Window_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SETUP WIZARD" FontSize="11" FontWeight="Bold" Foreground="#FFF0883E" />
                            <TextBlock x:Name="StepTitleText" Text="Game" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="StepProgressText" Text="1 / 5" FontSize="13" Foreground="#FF8B949E"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Grid.Column="2" Content="✕" FontSize="14" Width="30" Height="30" Style="{StaticResource WizardButton}"
                                Padding="0" Background="#44FF4444" Click="OnCloseWizard"
                                ToolTip="Close — discards everything the wizard changed" />
                    </Grid>
                </Border>

                <!-- ═══ STEP DOTS ═══ -->
                <Border Grid.Row="1" Background="#FF0D1117" Padding="14,8">
                    <UniformGrid x:Name="StepDots" Rows="1" Columns="5" />
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,6,14,6">
                    <Grid>

                        <!-- ═══ STEP 1: GAME ═══ -->
                        <StackPanel x:Name="PanelGame">
                            <TextBlock Margin="0,0,0,10" FontSize="13" Foreground="#FFC9D1D9"
                                       Text="This wizard builds a clean starting profile for your wheel, game and accessories. Nothing is saved until the last step — closing the wizard puts everything back how it was." />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="GAME" />
                                    <TextBlock x:Name="GameDetectedText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Set up for:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF8B949E" />
                                        <ComboBox x:Name="GameCombo" Width="220" SelectionChanged="OnGameComboChanged">
                                            <ComboBoxItem Content="AC EVO" Tag="AcEvo" />
                                            <ComboBoxItem Content="RaceRoom" Tag="Raceroom" />
                                            <ComboBoxItem Content="Assetto Corsa" Tag="AssettoCorsa" />
                                            <ComboBoxItem Content="Le Mans Ultimate" Tag="LeMansUltimate" />
                                            <ComboBoxItem Content="Assetto Corsa Competizione" Tag="AssettoCorsaCompetizione" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock x:Name="GameLockedHint" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"
                                               Text="The game is running, so the wizard uses it. Close the game to set up a different one." />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="IN-GAME SETTINGS" />
                                    <TextBlock x:Name="InGameSettingsText" FontSize="13" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="You can do the whole wizard from the menus. Driving is only needed for the optional strength calibration in step 4." />
                        </StackPanel>

                        <!-- ═══ STEP 2: WHEELBASE ═══ -->
                        <StackPanel x:Name="PanelWheel" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="WHEELBASE" />
                                    <TextBlock x:Name="WheelStatusText" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <ComboBox x:Name="DeviceCombo" Width="280" DisplayMemberPath="ProductName" />
                                        <Button Content="Connect" Style="{StaticResource WizardButton}" Margin="8,0,0,0" Click="OnConnectDevice" />
                                        <Button Content="↻" Style="{StaticResource WizardButton}" Margin="6,0,0,0" Click="OnRefreshDevices"
                                                ToolTip="Rescan devices" />
                                    </StackPanel>
                                    <TextBlock x:Name="WheelWarningText" Foreground="#FFFFB74D" FontSize="12" Margin="0,4,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="PEAK TORQUE" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SliderTorque" Minimum="1" Maximum="32" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                ValueChanged="OnTorqueChanged" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" x:Name="LblTorque" FontSize="15" FontWeight="Bold" Foreground="#FFFFD600"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock x:Name="TorqueHint" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="FORCE DIRECTION TEST" />
                                    <TextBlock FontSize="13" Margin="0,0,0,6"
                                               Text="Let go of the wheel, then press Test. The app sends a gentle push that should turn the wheel to the LEFT. Tell us which way it went." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button x:Name="BtnTestDirection" Content="▶  Test direction" Style="{StaticResource WizardButton}"
                                                Background="#FF1F6FEB" Click="OnTestDirection" />
                                    </StackPanel>
                                    <StackPanel x:Name="DirectionAnswerPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
                                        <Button Content="◀  It turned LEFT" Style="{StaticResource WizardButton}" Click="OnDirectionLeft" Margin="0,0,6,0" />
                                        <Button Content="It turned RIGHT  ▶" Style="{StaticResource WizardButton}" Click="OnDirectionRight" Margin="0,0,6,0" />
                                        <Button Content="It didn't move" Style="{StaticResource WizardButton}" Click="OnDirectionNone" />
                                    </StackPanel>
                                    <TextBlock x:Name="DirectionResultText" FontSize="13" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ STEP 3: ACCESSORIES ═══ -->
                        <StackPanel x:Name="PanelAccessories" Visibility="Collapsed">
                            <TextBlock Margin="0,0,0,10" FontSize="13" Foreground="#FFC9D1D9"
                                       Text="Your wheel baseline is now applied. Here's what else the app found. Switch on what you use — anything you don't have can be ignored." />
                            <StackPanel x:Name="AccessoryRows" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="WHEEL EFFECTS (KERBS · ROAD · ABS · SLIP)" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SliderEffects" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                ValueChanged="OnEffectsChanged" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" x:Name="LblEffects" FontWeight="Bold" Foreground="#FFFFD600"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Vibration effects mixed into the steering force. 0 = pure steering feel." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ STEP 4: STRENGTH ═══ -->
                        <StackPanel x:Name="PanelStrength" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="HOW STRONG?" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RbLight" GroupName="Feel" Content="Light" Margin="0,3,18,3" Checked="OnFeelChanged" />
                                        <RadioButton x:Name="RbBalanced" GroupName="Feel" Content="Balanced" Margin="0,3,18,3" Checked="OnFeelChanged" />
                                        <RadioButton x:Name="RbStrong" GroupName="Feel" Content="Strong" Margin="0,3,18,3" Checked="OnFeelChanged" />
                                    </StackPanel>
                                    <TextBlock x:Name="StrengthSummary" FontSize="13" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="CALIBRATE ON TRACK (OPTIONAL — RECOMMENDED)" />
                                    <TextBlock FontSize="13" Margin="0,0,0,8"
                                               Text="Press Start and drive about a lap at normal pace through some proper corners. The wizard measures your peak steering force and sets the gain so the strongest corners use your chosen share of the wheel's range — no clipping." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button x:Name="BtnCalStart" Content="▶  Start" Style="{StaticResource WizardButton}" Background="#FF1F6FEB"
                                                Click="OnCalStart" Margin="0,0,6,0" />
                                        <Button x:Name="BtnCalReset" Content="Reset" Style="{StaticResource WizardButton}" Click="OnCalReset" />
                                    </StackPanel>
                                    <ProgressBar x:Name="CalProgress" Height="8" Minimum="0" Maximum="1" Foreground="#FF3FB950"
                                                 Background="#FF21262D" BorderThickness="0" Margin="0,0,0,6" />
                                    <TextBlock x:Name="CalStatusText" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="BASELINE APPLIED" />
                                    <TextBlock x:Name="BaselineSummary" FontSize="12" Foreground="#FFC9D1D9" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ STEP 5: SAVE ═══ -->
                        <StackPanel x:Name="PanelSave" Visibility="Collapsed">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="WHEN SHOULD THIS PROFILE LOAD?" />
                                    <RadioButton x:Name="ScopeGame" GroupName="Scope" Checked="OnScopeChanged" />
                                    <RadioButton x:Name="ScopeClass" GroupName="Scope" Checked="OnScopeChanged" />
                                    <RadioButton x:Name="ScopeCar" GroupName="Scope" Checked="OnScopeChanged" />
                                    <RadioButton x:Name="ScopeCarTrack" GroupName="Scope" Checked="OnScopeChanged" />
                                    <RadioButton x:Name="ScopeGeneral" GroupName="Scope" Checked="OnScopeChanged"
                                                 Content="Every game — manual use only (never auto-loads)" />
                                    <StackPanel x:Name="MatchPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                        <StackPanel x:Name="RowClass" Margin="0,0,0,4">
                                            <TextBlock Style="{StaticResource Hint}" Text="Car class (as the game reports it)" />
                                            <TextBox x:Name="TxtMatchClass" FontSize="14" Padding="6,3" Background="#FF0D1117" Foreground="#FFE6EDF3"
                                                     BorderBrush="#FF30363D" TextChanged="OnMatchChanged" />
                                        </StackPanel>
                                        <StackPanel x:Name="RowCar" Margin="0,0,0,4">
                                            <TextBlock Style="{StaticResource Hint}" Text="Car (as the game reports it)" />
                                            <TextBox x:Name="TxtMatchCar" FontSize="14" Padding="6,3" Background="#FF0D1117" Foreground="#FFE6EDF3"
                                                     BorderBrush="#FF30363D" TextChanged="OnMatchChanged" />
                                        </StackPanel>
                                        <StackPanel x:Name="RowTrack" Margin="0,0,0,4">
                                            <TextBlock Style="{StaticResource Hint}" Text="Track (as the game reports it)" />
                                            <TextBox x:Name="TxtMatchTrack" FontSize="14" Padding="6,3" Background="#FF0D1117" Foreground="#FFE6EDF3"
                                                     BorderBrush="#FF30363D" TextChanged="OnMatchChanged" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="ScopeHint" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionLabel}" Text="PROFILE NAME" />
                                    <TextBox x:Name="TxtProfileName" FontSize="15" Padding="6,4" Background="#FF0D1117" Foreground="#FFE6EDF3"
                                             BorderBrush="#FF30363D" TextChanged="OnNameChanged" />
                                    <TextBlock x:Name="NameHint" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="SaveErrorText" Foreground="#FFFF7B72" FontSize="13" Visibility="Collapsed" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Fine-tune any time on the FFB Tuning page. Re-run this wizard from Home whenever you change wheelbase, game or accessories." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ═══ FOOTER ═══ -->
                <Border Grid.Row="3" Background="#FF161B22" CornerRadius="0,0,7,7" Padding="12,10">
                    <Grid>
                        <TextBlock x:Name="FooterStatus" FontSize="12" Foreground="#FF8B949E" VerticalAlignment="Center"
                                   Margin="0,0,200,0" Text="Changes are live — nothing is saved yet" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnBack" Style="{StaticResource WizardButton}" Content="Back" Click="OnBack" Margin="0,0,8,0" />
                            <Button x:Name="BtnNext" Style="{StaticResource WizardButton}" Content="Next" Click="OnNext" Background="#FF238636" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
