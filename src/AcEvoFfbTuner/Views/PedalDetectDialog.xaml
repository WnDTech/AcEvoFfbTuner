<Window x:Class="AcEvoFfbTuner.Views.PedalDetectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AcEvoFfbTuner.Converters"
        Title="Find my pedals"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDark}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Find my pedals" FontSize="18" FontWeight="Bold" Foreground="#FF7EE787" Margin="0,0,0,4" />
        <TextBlock Text="Press each pedal when asked — the app finds the live axis on any wheelbase or USB set. Watch the bars to confirm." FontSize="13" Foreground="#FF8B949E" Margin="0,0,0,16" TextWrapping="Wrap" />

        <!-- Live hardware bars -->
        <Border Background="#FF1C2128" CornerRadius="6" Padding="12,10" BorderThickness="1" BorderBrush="#FF30363D" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Gas" Width="60" FontSize="13" Foreground="#FF8B949E" VerticalAlignment="Center" />
                    <ProgressBar Value="{Binding SetupPedalGas, Mode=OneWay}" Minimum="0" Maximum="1" Height="14" Width="280" Foreground="#FF4CAF50" />
                    <TextBlock Text="{Binding SetupPedalGas, Mode=OneWay, StringFormat=' {0:P0}'}" FontSize="13" Foreground="#FF4CAF50" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Brake" Width="60" FontSize="13" Foreground="#FF8B949E" VerticalAlignment="Center" />
                    <ProgressBar Value="{Binding SetupPedalBrake, Mode=OneWay}" Minimum="0" Maximum="1" Height="14" Width="280" Foreground="#FFE53935" />
                    <TextBlock Text="{Binding SetupPedalBrake, Mode=OneWay, StringFormat=' {0:P0}'}" FontSize="13" Foreground="#FFE53935" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Clutch" Width="60" FontSize="13" Foreground="#FF8B949E" VerticalAlignment="Center" />
                    <ProgressBar Value="{Binding SetupPedalClutch, Mode=OneWay}" Minimum="0" Maximum="1" Height="14" Width="280" Foreground="#FFFF9800" />
                    <TextBlock Text="{Binding SetupPedalClutch, Mode=OneWay, StringFormat=' {0:P0}'}" FontSize="13" Foreground="#FFFF9800" />
                </StackPanel>
                <TextBlock FontSize="11" Foreground="#FF8B949E" Margin="0,6,0,0">
                    <Run Text="Reading from: " /><Run Text="{Binding SetupPedalSource, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Per-pedal rows -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Throttle" Width="90" FontSize="14" Foreground="#FFE6EDF3" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PedalGasAxis, Mode=OneWay}" Width="90" FontSize="13" Foreground="#FF8B949E" VerticalAlignment="Center" />
            <Button Content="Detect" Command="{Binding DetectSinglePedalCommand}" CommandParameter="gas"
                    Width="90" Padding="10,4" Margin="0,0,8,0" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand" />
            <Button Content="Undo" Command="{Binding UndoPedalAxisCommand}" CommandParameter="gas"
                    Width="70" Padding="10,4" Margin="0,0,8,0" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand" />
            <Button Content="Clear" Command="{Binding ClearPedalAxisCommand}" CommandParameter="gas"
                    Width="70" Padding="10,4" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Brake" Width="90" FontSize="14" Foreground="#FFE6EDF3" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PedalBrakeAxis, Mode=OneWay}" Width="90" FontSize="13" Foreground="#FF8B949E" VerticalAlignment="Center" />
            <Button Content="Detect" Command="{Binding DetectSinglePedalCommand}" CommandParameter="brake"
                    Width="90" Padding="10,4" Margin="0,0,8,0" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand" />
            <Button Content="Undo" Command="{Binding UndoPedalAxisCommand}" CommandParameter="brake"
                    Width="70" Padding="10,4" Margin="0,0,8,0" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand" />
            <Button Content="Clear" Command="{Binding ClearPedalAxisCommand}" CommandParameter="brake"
                    Width="70" Padding="10,4" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Clutch" Width="90" FontSize="14" Foreground="#FFE6EDF3" VerticalAlignment="Center" />
            <TextBlock Text="{Binding PedalClutchAxis, Mode=OneWay}" Width="90" FontSize="13" Foreground="#FF8B949E" VerticalAlignment="Center" />
            <Button Content="Detect" Command="{Binding DetectSinglePedalCommand}" CommandParameter="clutch"
                    Width="90" Padding="10,4" Margin="0,0,8,0" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand" />
            <Button Content="Undo" Command="{Binding UndoPedalAxisCommand}" CommandParameter="clutch"
                    Width="70" Padding="10,4" Margin="0,0,8,0" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand" />
            <Button Content="Clear" Command="{Binding ClearPedalAxisCommand}" CommandParameter="clutch"
                    Width="70" Padding="10,4" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Detect all three" Command="{Binding StartPedalDetectionCommand}"
                    Width="140" Padding="10,6" Margin="0,0,8,0" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand" FontSize="13" />
            <Button Content="Skip" Command="{Binding SkipPedalDetectStepCommand}"
                    Width="80" Padding="10,6" Margin="0,0,8,0" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand"
                    Visibility="{Binding IsPedalDetectRunning, Converter={StaticResource BoolToVis}}" />
            <Button Content="Cancel" Command="{Binding CancelPedalDetectionCommand}"
                    Width="80" Padding="10,6" Background="#FF21262D" Foreground="#FFE6EDF3" BorderThickness="0" Cursor="Hand"
                    Visibility="{Binding IsPedalDetectRunning, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <TextBlock Text="{Binding PedalDetectStatus}" FontSize="13" Foreground="#FF7EE787" TextWrapping="Wrap" Margin="0,0,0,16"
                   Visibility="{Binding PedalDetectStatus, Converter={StaticResource NotEmptyToVis}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Done" Width="100" Padding="16,6" IsCancel="True"
                    Style="{StaticResource OutlinedButton}" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</Window>
