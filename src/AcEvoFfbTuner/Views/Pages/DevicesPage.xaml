                                    <TextBlock Text="★ SOURCE" FontSize="11" FontWeight="Bold" Foreground="#FFD2A8FF"
                                               VerticalAlignment="Center" Visibility="{Binding Hf8IsCopySource4, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Copy →" FontSize="11" Padding="6,1" Cursor="Hand"
                                            Background="#33D2A8FF" BorderThickness="0" Foreground="#FFD2A8FF" Margin="4,0,0,0"
                                            Visibility="{Binding Hf8CanCopyTo4, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding Hf8CopyToZoneCommand}" CommandParameter="4">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#77D2A8FF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                                <controls:LabeledSlider Value="{Binding Hf8ZoneGain4, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                    Label="Zone Intensity" StringFormat="{}{0:F2}" ValueWidth="52" SectionColor="#FFE08040" />
                                <CheckBox IsChecked="{Binding Hf8ZoneEnabled4}" Content="Enabled" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,4" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcSusp4, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Suspension" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFE08040" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcSlip4, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Tire Slip" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFE08040" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcKerb4, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Kerbs" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFE08040" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcLatG4, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Lateral G" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFE08040" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcEngine4, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Engine RPM" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFE08040" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ROW 4: BACK UPPER — M2 UL (left) | M1 UR (right) -->
                    <TextBlock Text="BACK UPPER" FontSize="12" FontWeight="Bold" Foreground="#FFF0883E" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,12"
                                BorderThickness="1" BorderBrush="#33F0883E">
                            <StackPanel>
                                <TextBlock Text="Back Upper Left" FontSize="11" FontWeight="SemiBold" Foreground="#FFC9D1D9" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                    <Button Content="Copy from here" FontSize="11" Padding="6,1" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0" Foreground="#FFF0883E"
                                            Visibility="{Binding Hf8CopyActive, Converter={StaticResource InvertBoolToVis}}"
                                            Command="{Binding Hf8SetCopySourceCommand}" CommandParameter="7">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Text="★ SOURCE" FontSize="11" FontWeight="Bold" Foreground="#FFD2A8FF"
                                               VerticalAlignment="Center" Visibility="{Binding Hf8IsCopySource7, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Copy →" FontSize="11" Padding="6,1" Cursor="Hand"
                                            Background="#33D2A8FF" BorderThickness="0" Foreground="#FFD2A8FF" Margin="4,0,0,0"
                                            Visibility="{Binding Hf8CanCopyTo7, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding Hf8CopyToZoneCommand}" CommandParameter="7">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#77D2A8FF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                                <controls:LabeledSlider Value="{Binding Hf8ZoneGain7, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                    Label="Zone Intensity" StringFormat="{}{0:F2}" ValueWidth="52" SectionColor="#FFF0883E" />
                                <CheckBox IsChecked="{Binding Hf8ZoneEnabled7}" Content="Enabled" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,4" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcSusp7, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Suspension" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFF0883E" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcSlip7, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Tire Slip" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFF0883E" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcKerb7, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Kerbs" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFF0883E" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcLatG7, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Lateral G" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFF0883E" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcEngine7, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Engine RPM" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFF0883E" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,12"
                                BorderThickness="1" BorderBrush="#33F0883E">
                            <StackPanel>
                                <TextBlock Text="Back Upper Right" FontSize="11" FontWeight="SemiBold" Foreground="#FFC9D1D9" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                    <Button Content="Copy from here" FontSize="11" Padding="6,1" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0" Foreground="#FFF0883E"
                                            Visibility="{Binding Hf8CopyActive, Converter={StaticResource InvertBoolToVis}}"
                                            Command="{Binding Hf8SetCopySourceCommand}" CommandParameter="6">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Text="★ SOURCE" FontSize="11" FontWeight="Bold" Foreground="#FFD2A8FF"
                                               VerticalAlignment="Center" Visibility="{Binding Hf8IsCopySource6, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Copy →" FontSize="11" Padding="6,1" Cursor="Hand"
                                            Background="#33D2A8FF" BorderThickness="0" Foreground="#FFD2A8FF" Margin="4,0,0,0"
                                            Visibility="{Binding Hf8CanCopyTo6, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding Hf8CopyToZoneCommand}" CommandParameter="6">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#77D2A8FF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                                <controls:LabeledSlider Value="{Binding Hf8ZoneGain6, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                    Label="Zone Intensity" StringFormat="{}{0:F2}" ValueWidth="52" SectionColor="#FFF0883E" />
                                <CheckBox IsChecked="{Binding Hf8ZoneEnabled6}" Content="Enabled" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,4" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcSusp6, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Suspension" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFF0883E" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcSlip6, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Tire Slip" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFF0883E" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcKerb6, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Kerbs" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFF0883E" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcLatG6, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Lateral G" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFF0883E" />
                                <controls:LabeledSlider Value="{Binding Hf8SrcEngine6, Mode=TwoWay}" Minimum="0" Maximum="3" TickFrequency="0.05"
                                    Label="Engine RPM" StringFormat="{}{0:F2}" ValueWidth="48" SectionColor="#FFF0883E" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- MOTOR TEST BUTTON -->
                    <Button Content="&#x2699; Test Motors"
                            Click="OnOpenMotorTest"
                            Background="#FF333355" Foreground="#FFFF9800" BorderThickness="0"
                            Padding="16,10" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                            HorizontalAlignment="Left" Margin="0,0,0,16"
                            ToolTip="Test individual haptic pad motors">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}"
                                        BorderThickness="1" BorderBrush="#44FF9800">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#44FF9800" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- CONNECTION INFO PANEL -->
                    <Border Background="#FF1A1A2E" CornerRadius="6" Padding="14,10" Margin="0,0,0,0"
                            BorderThickness="1" BorderBrush="#333355">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="USB" FontSize="11" FontWeight="Bold" Foreground="#FF6666AA" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#FF9999CC" VerticalAlignment="Center">
                                <Run Text="Connect the HF8 / HF8 Pro via USB. Close the NLR HFS software before use — it holds exclusive HID access." />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════ -->
            <!-- PANEL 3: PEDALS                            -->
            <!-- ═══════════════════════════════════════════ -->
            <ScrollViewer x:Name="PedalPanel" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed">
                <StackPanel>
                    <!-- Pedals setup flow: 1 Input → 2 Calibrate → 3 Haptic hardware → 4 Tune -->
                    <Border Background="#FF1E2227" CornerRadius="6" Padding="14,10" Margin="0,0,0,20"
                            BorderThickness="1" BorderBrush="#3347A15C">
                        <TextBlock FontSize="12" TextWrapping="Wrap">
                            <Run Text="Setup flow:  " FontWeight="Bold" Foreground="#FF4CAF50" />
                            <Run Text="1 Input" FontWeight="Bold" Foreground="#FF56D4A0" />
                            <Run Text="  →  " Foreground="{StaticResource TextDimBrush}" />
                            <Run Text="2 Calibrate" FontWeight="Bold" Foreground="#FF79C0FF" />
                            <Run Text="  →  " Foreground="{StaticResource TextDimBrush}" />
                            <Run Text="3 Haptic hardware" FontWeight="Bold" Foreground="#FF9800" />
                            <Run Text="  →  " Foreground="{StaticResource TextDimBrush}" />
                            <Run Text="4 Tune" FontWeight="Bold" Foreground="#FFE53935" />
                            <Run Text="   — enable your pedals, check the live bars, calibrate, connect a haptic box, then tune the feel." Foreground="{StaticResource TextDimBrush}" />
                        </TextBlock>
                    </Border>

                    <!-- ═══ STEP 1 — INPUT: enable + verify live ═══ -->
                    <TextBlock Text="STEP 1 — PEDAL INPUT" FontSize="14" FontWeight="Bold" Foreground="#FF56D4A0" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="8" Padding="20,16"
                                BorderThickness="1" BorderBrush="#3356D4A0">
                            <StackPanel>
                                <DockPanel VerticalAlignment="Center" Margin="0,0,0,12">
                                    <CheckBox IsChecked="{Binding PedalInputEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Physical Pedal Input" FontSize="16" FontWeight="Bold" Foreground="#FF56D4A0" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="When enabled, pedal values come from physical devices instead of game telemetry. Keyboard (W/S/A) simulation is also available."
                                           FontSize="12" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding PedalDeviceInfo, StringFormat='Pedal device: {0}'}" FontSize="12"
                                           Foreground="#FF56D4A0" TextWrapping="Wrap" Margin="0,0,0,2" />
                                <TextBlock Text="USB pedals are handled here — no need to select them in the Device menu at the top."
                                           FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding PedalDiagnosticInfo, StringFormat='Diagnostics: {0}'}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,14"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                            <StackPanel>
                                <TextBlock Text="LIVE PEDAL STATE" FontSize="11" FontWeight="Bold" Foreground="#FF56D4A0" Margin="0,0,0,12" />

                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Source:" FontSize="13" Foreground="{StaticResource TextDimBrush}" Width="70" />
                                    <TextBlock Text="{Binding PedalLiveSource}" FontSize="13" FontWeight="Bold" Foreground="#FF56D4A0" />
                                </DockPanel>

                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Gas:" FontSize="13" Foreground="{StaticResource TextDimBrush}" Width="70" />
                                    <ProgressBar Value="{Binding PedalLiveGas}" Minimum="0" Maximum="1" Height="14" Width="120" HorizontalAlignment="Left" Foreground="#FF4CAF50" />
                                    <TextBlock Text="{Binding PedalLiveGas, StringFormat=' {0:P0}'}" FontSize="13" Foreground="#FF4CAF50" Margin="4,0,0,0" />
                                </DockPanel>

                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Brake:" FontSize="13" Foreground="{StaticResource TextDimBrush}" Width="70" />
                                    <ProgressBar Value="{Binding PedalLiveBrake}" Minimum="0" Maximum="1" Height="14" Width="120" HorizontalAlignment="Left" Foreground="#FFE53935" />
                                    <TextBlock Text="{Binding PedalLiveBrake, StringFormat=' {0:P0}'}" FontSize="13" Foreground="#FFE53935" Margin="4,0,0,0" />
                                </DockPanel>

                                <DockPanel Margin="0,4">
                                    <TextBlock Text="Clutch:" FontSize="13" Foreground="{StaticResource TextDimBrush}" Width="70" />
                                    <ProgressBar Value="{Binding PedalLiveClutch}" Minimum="0" Maximum="1" Height="14" Width="120" HorizontalAlignment="Left" Foreground="#FFFF9800" />
                                    <TextBlock Text="{Binding PedalLiveClutch, StringFormat=' {0:P0}'}" FontSize="13" Foreground="#FFFF9800" Margin="4,0,0,0" />
                                </DockPanel>

                                <TextBlock Text="Press the pedals — the bars should follow. If not, fix the axis mapping in Step 2."
                                           FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══ STEP 2 — CALIBRATE ═══ -->
                    <TextBlock Text="STEP 2 — CALIBRATE" FontSize="14" FontWeight="Bold" Foreground="#FF79C0FF" Margin="0,0,0,10" />
                    <!-- Calibration Section -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="20,16" Margin="0,0,0,20"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <StackPanel>
                            <TextBlock Text="CALIBRATION" FontSize="12" FontWeight="Bold" Foreground="#FF79C0FF" Margin="0,0,0,12" />

                            <!-- Axis Mapping -->
                            <Border Background="#FF161B22" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="PEDAL AXIS MAPPING" FontSize="11" FontWeight="Bold" Foreground="#FFFF9800" Margin="0,0,0,6" />
                                    <TextBlock Text="Select which DirectInput axis each pedal uses. If the Step 1 bars don't match your pedals, change these here." FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Find my pedals…" Command="{Binding OpenPedalDetectDialogCommand}"
                                                Height="28" Padding="10,0"
                                                Background="#FF21262D" Foreground="#FFE6EDF3"
                                                BorderThickness="0" Cursor="Hand" FontSize="12"
                                                ToolTip="Opens pedal setup: big live bars plus per-pedal Detect, Undo and Clear." />
                                        <TextBlock Text="{Binding PedalDetectStatus}" FontSize="11" Foreground="#FF7EE787"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0"
                                                   Visibility="{Binding PedalDetectStatus, Converter={StaticResource NotEmptyToVis}}" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Gas Axis" FontSize="11" Foreground="#FF4CAF50" Margin="0,0,0,2" />
                                            <ComboBox ItemsSource="{Binding PedalAvailableAxes}" SelectedItem="{Binding PedalGasAxis, Mode=TwoWay}"
                                                      FontSize="13" Padding="6,4" Background="#FF21262D" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Brake Axis" FontSize="11" Foreground="#FFE53935" Margin="0,0,0,2" />
                                            <ComboBox ItemsSource="{Binding PedalAvailableAxes}" SelectedItem="{Binding PedalBrakeAxis, Mode=TwoWay}"
                                                      FontSize="13" Padding="6,4" Background="#FF21262D" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Clutch Axis" FontSize="11" Foreground="#FFFF9800" Margin="0,0,0,2" />
                                            <ComboBox ItemsSource="{Binding PedalAvailableAxes}" SelectedItem="{Binding PedalClutchAxis, Mode=TwoWay}"
                                                      FontSize="13" Padding="6,4" Background="#FF21262D" Foreground="{DynamicResource TextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Gas Column -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="GAS" FontSize="12" FontWeight="Bold" Foreground="#FF4CAF50" Margin="0,0,0,4" />
                                    <controls:LabeledSlider Value="{Binding PedalGasDeadzone, Mode=TwoWay}" Minimum="0" Maximum="0.3" TickFrequency="0.005"
                                        Label="Deadzone" StringFormat="{}{0:F3}" SectionColor="#FF4CAF50" />
                                    <controls:LabeledSlider Value="{Binding PedalGasMin, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.005"
                                        Label="Min Range" StringFormat="{}{0:F3}" SectionColor="#FF4CAF50" />
                                    <controls:LabeledSlider Value="{Binding PedalGasMax, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.005"
                                        Label="Max Range" StringFormat="{}{0:F3}" SectionColor="#FF4CAF50" />
                                    <DockPanel Margin="0,4">
                                        <CheckBox IsChecked="{Binding PedalGasInvert, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Text="Invert" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <controls:LabeledSlider Value="{Binding PedalGasSmoothing, Mode=TwoWay}" Minimum="0" Maximum="0.99" TickFrequency="0.01"
                                        Label="Smoothing α" StringFormat="{}{0:F2}" SectionColor="#FF4CAF50" />
                                </StackPanel>

                                <!-- Brake Column -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="BRAKE" FontSize="12" FontWeight="Bold" Foreground="#FFE53935" Margin="0,0,0,4" />
                                    <controls:LabeledSlider Value="{Binding PedalBrakeDeadzone, Mode=TwoWay}" Minimum="0" Maximum="0.3" TickFrequency="0.005"
                                        Label="Deadzone" StringFormat="{}{0:F3}" SectionColor="#FFE53935" />
                                    <controls:LabeledSlider Value="{Binding PedalBrakeMin, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.005"
                                        Label="Min Range" StringFormat="{}{0:F3}" SectionColor="#FFE53935" />
                                    <controls:LabeledSlider Value="{Binding PedalBrakeMax, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.005"
                                        Label="Max Range" StringFormat="{}{0:F3}" SectionColor="#FFE53935" />
                                    <DockPanel Margin="0,4">
                                        <CheckBox IsChecked="{Binding PedalBrakeInvert, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Text="Invert" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <controls:LabeledSlider Value="{Binding PedalBrakeSmoothing, Mode=TwoWay}" Minimum="0" Maximum="0.99" TickFrequency="0.01"
                                        Label="Smoothing α" StringFormat="{}{0:F2}" SectionColor="#FFE53935" />
                                </StackPanel>

                                <!-- Clutch Column -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="CLUTCH" FontSize="12" FontWeight="Bold" Foreground="#FFFF9800" Margin="0,0,0,4" />
                                    <controls:LabeledSlider Value="{Binding PedalClutchDeadzone, Mode=TwoWay}" Minimum="0" Maximum="0.3" TickFrequency="0.005"
                                        Label="Deadzone" StringFormat="{}{0:F3}" SectionColor="#FFFF9800" />
                                    <controls:LabeledSlider Value="{Binding PedalClutchMin, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.005"
                                        Label="Min Range" StringFormat="{}{0:F3}" SectionColor="#FFFF9800" />
                                    <controls:LabeledSlider Value="{Binding PedalClutchMax, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.005"
                                        Label="Max Range" StringFormat="{}{0:F3}" SectionColor="#FFFF9800" />
                                    <DockPanel Margin="0,4">
                                        <CheckBox IsChecked="{Binding PedalClutchInvert, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <TextBlock Text="Invert" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <controls:LabeledSlider Value="{Binding PedalClutchSmoothing, Mode=TwoWay}" Minimum="0" Maximum="0.99" TickFrequency="0.01"
                                        Label="Smoothing α" StringFormat="{}{0:F2}" SectionColor="#FFFF9800" />
                                </StackPanel>
                            </Grid>

                            <Button Content="Save Pedal Configuration" x:Name="SavePedalBtn" Click="OnSavePedalConfig"
                                    Margin="0,16,0,0" Padding="16,8" HorizontalAlignment="Left"
                                    Background="{StaticResource BgInput}" Foreground="{StaticResource TextBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                    Cursor="Hand" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- ═══ STEP 3 — HAPTIC HARDWARE (pick one or both) ═══ -->
                    <TextBlock Text="STEP 3 — HAPTIC HARDWARE" FontSize="14" FontWeight="Bold" Foreground="#FF9800" Margin="0,0,0,4" />
                    <TextBlock Text="Pick one or both — the telemetry feed drives all connected hardware. Test each box below before driving."
                               FontSize="12" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                    <!-- Osoyoo Serial Pedal Haptic Device -->
                    <Border Grid.Column="0" Background="{StaticResource BgCard}" CornerRadius="8" Padding="20,16"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <StackPanel>
                            <DockPanel VerticalAlignment="Center" Margin="0,0,0,12">
                                <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Fill="#FF4CAF50"
                                         Opacity="{Binding OsoyooIsConnected, Converter={StaticResource BoolToOpacity}}" />
                                <TextBlock Text="SERIAL HAPTIC BOX" FontSize="16" FontWeight="Bold" Foreground="#FF9800" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Connect an Osoyoo Arduino Uno (or compatible serial device) for pedal vibration feedback."
                                       FontSize="12" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="Note: COM ports are for this vibration box only — your USB pedals connect as a DirectInput device (Step 1) and need no COM port."
                                       FontSize="11" Foreground="#FFFF9800" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="COM Port:" FontSize="13" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding OsoyooAvailablePorts}"
                                          SelectedItem="{Binding OsoyooSelectedPort, Mode=TwoWay}"
                                          MinWidth="120" Height="30" VerticalAlignment="Center"
                                          Background="{StaticResource BgInput}" Foreground="{StaticResource TextBrush}" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="⟳" Command="{Binding RefreshOsoyooPortsCommand}"
                                            Width="30" Height="30" Padding="0"
                                            Background="{StaticResource BgInput}" Foreground="{StaticResource TextBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                            Cursor="Hand" FontSize="16" ToolTip="Refresh COM ports" />

                                    <Button Content="Connect" Command="{Binding ConnectOsoyooCommand}"
                                            Visibility="{Binding OsoyooIsConnected, Converter={StaticResource InvertBoolToVis}}"
                                            Width="90" Height="30" Margin="6,0,0,0" Padding="8,0"
                                            Background="#FF9800" Foreground="#FF1A1D24"
                                            BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" />

                                    <Button Content="Disconnect" Command="{Binding DisconnectOsoyooCommand}"
                                            Visibility="{Binding OsoyooIsConnected, Converter={StaticResource BoolToVis}}"
                                            Width="90" Height="30" Margin="6,0,0,0" Padding="8,0"
                                            Background="#FF5252" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding OsoyooConnectionStatus}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />

                            <!-- Motor Test Panel -->
                            <Border Background="#FF1E2227" CornerRadius="6" Padding="14,12" Margin="0,14,0,0"
                                    BorderThickness="1" BorderBrush="#3347A15C">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="MOTOR TEST" FontSize="12" FontWeight="Bold" Foreground="#FF4CAF50" VerticalAlignment="Center" />
                                        <TextBlock Text="Telemetry feed is paused during tests" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Intensity:" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="5"
                                                Value="{Binding OsoyooTestIntensity, Mode=TwoWay}"
                                                VerticalAlignment="Center" Height="26" />
                                        <TextBlock Grid.Column="2" Text="{Binding OsoyooTestIntensity, StringFormat='{}{0}'}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#FF4CAF50"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" Width="36" TextAlignment="Right" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="TEST BRAKE" Command="{Binding OsoyooTestBrakeCommand}"
                                                Height="32" Padding="12,0"
                                                Background="#FFE53935" Foreground="White"
                                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" />
                                        <Button Content="TEST GAS" Command="{Binding OsoyooTestGasCommand}"
                                                Height="32" Padding="12,0" Margin="8,0,0,0"
                                                Background="#FF4CAF50" Foreground="White"
                                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" />
                                        <Button Content="STOP" Command="{Binding OsoyooStopTestCommand}"
                                                Height="32" Padding="12,0" Margin="8,0,0,0"
                                                Background="#FF525252" Foreground="White"
                                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- MOZA PHF Pedal Haptic Feedback (RS102 kit + RS103 modules) -->
                    <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="8" Padding="20,16"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <StackPanel>
                            <DockPanel VerticalAlignment="Center" Margin="0,0,0,12">
                                <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Fill="#FF4CAF50"
                                         Opacity="{Binding MozaPhfIsConnected, Converter={StaticResource BoolToOpacity}}" />
                                <TextBlock Text="MOZA PHF PEDAL HAPTICS" FontSize="16" FontWeight="Bold" Foreground="#FF9800" VerticalAlignment="Center" />
                                <CheckBox Content="Enabled" IsChecked="{Binding MozaPhfEnabled, Mode=TwoWay}"
                                          Foreground="{StaticResource TextDimBrush}" FontSize="12"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Kit (RS102: control box + 1 module) plus add-on Modules (RS103). Connect the control box to the PC via USB (direct-PC mode) and close Pit House first — it locks MOZA devices."
                                       FontSize="12" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="Tick the pedals that have a physical module fitted (kit = 1 module, each RS103 adds one). Unfitted ports stay silent."
                                       FontSize="11" Foreground="#FFFF9800" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox Content="Brake module" IsChecked="{Binding MozaPhfBrakeModule, Mode=TwoWay}"
                                          Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <CheckBox Content="Throttle module" IsChecked="{Binding MozaPhfThrottleModule, Mode=TwoWay}"
                                          Foreground="{StaticResource TextBrush}" FontSize="13" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <CheckBox Content="Clutch module" IsChecked="{Binding MozaPhfClutchModule, Mode=TwoWay}"
                                          Foreground="{StaticResource TextBrush}" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Control box:" FontSize="13" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding MozaPhfAvailableDevices}"
                                          SelectedItem="{Binding MozaPhfSelectedDevice, Mode=TwoWay}"
                                          MinWidth="120" Height="30" VerticalAlignment="Center"
                                          Background="{StaticResource BgInput}" Foreground="{StaticResource TextBrush}" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                    <Button Content="⟳" Command="{Binding RefreshMozaPhfCommand}"
                                            Width="30" Height="30" Padding="0"
                                            Background="{StaticResource BgInput}" Foreground="{StaticResource TextBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                            Cursor="Hand" FontSize="16" ToolTip="Refresh MOZA devices" />

                                    <Button Content="Connect" Command="{Binding ConnectMozaPhfCommand}"
                                            Visibility="{Binding MozaPhfIsConnected, Converter={StaticResource InvertBoolToVis}}"
                                            Width="90" Height="30" Margin="6,0,0,0" Padding="8,0"
                                            Background="#FF9800" Foreground="#FF1A1D24"
                                            BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" />

                                    <Button Content="Disconnect" Command="{Binding DisconnectMozaPhfCommand}"
                                            Visibility="{Binding MozaPhfIsConnected, Converter={StaticResource BoolToVis}}"
                                            Width="90" Height="30" Margin="6,0,0,0" Padding="8,0"
                                            Background="#FF5252" Foreground="White"
                                            BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding MozaPhfStatus}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" />

                            <!-- PHF Motor Test Panel -->
                            <Border Background="#FF1E2227" CornerRadius="6" Padding="14,12" Margin="0,14,0,0"
                                    BorderThickness="1" BorderBrush="#3347A15C">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="PHF MODULE TEST" FontSize="12" FontWeight="Bold" Foreground="#FF4CAF50" VerticalAlignment="Center" />
                                        <TextBlock Text="Telemetry feed is paused during tests" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Intensity %:" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                                                Value="{Binding MozaPhfTestIntensity, Mode=TwoWay}"
                                                VerticalAlignment="Center" Height="26" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MozaPhfTestIntensity, StringFormat='{}{0}%'}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#FF4CAF50"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" Width="44" TextAlignment="Right" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Frequency:" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                                                Value="{Binding MozaPhfTestFrequency, Mode=TwoWay}"
                                                VerticalAlignment="Center" Height="26" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MozaPhfTestFrequency, StringFormat='{}{0}Hz'}"
                                                   FontSize="12" FontWeight="Bold" Foreground="#FF4CAF50"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" Width="44" TextAlignment="Right" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="TEST BRAKE" Command="{Binding MozaPhfTestBrakeCommand}"
                                                Height="32" Padding="12,0"
                                                Background="#FFE53935" Foreground="White"
                                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" />
                                        <Button Content="TEST GAS" Command="{Binding MozaPhfTestGasCommand}"
                                                Height="32" Padding="12,0" Margin="8,0,0,0"
                                                Background="#FF4CAF50" Foreground="White"
                                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" />
                                        <Button Content="TEST CLUTCH" Command="{Binding MozaPhfTestClutchCommand}"
                                                Height="32" Padding="12,0" Margin="8,0,0,0"
                                                Background="#FF42A5F5" Foreground="White"
                                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" />
                                        <Button Content="STOP" Command="{Binding MozaPhfStopTestCommand}"
                                                Height="32" Padding="12,0" Margin="8,0,0,0"
                                                Background="#FF525252" Foreground="White"
                                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    </Grid>

                    <!-- ═══ STEP 4 — TUNE THE FEEL ═══ -->
                    <TextBlock Text="STEP 4 — TUNE THE FEEL" FontSize="14" FontWeight="Bold" Foreground="#FFE53935" Margin="0,0,0,10" />
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="20,16" Margin="0,0,0,20"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <StackPanel>
                            <TextBlock Text="EFFECT ROUTING (all hardware)" FontSize="11" FontWeight="Bold" Foreground="#FFE53935" Margin="0,0,0,4" />
                            <TextBlock Text="Each signal routes through its pedal column, then the master gain scales the whole channel (0-2x)."
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- ── BRAKE PEDAL column ── -->
                                <StackPanel Grid.Column="0">
                                    <Border Background="#26E53935" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                        <TextBlock Text="BRAKE PEDAL" FontSize="12" FontWeight="Bold" Foreground="#FFE53935" HorizontalAlignment="Center" />
                                    </Border>
                                    <controls:LabeledSlider Value="{Binding PedalMasterBrakeGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="Master Gain" StringFormat="{}{0:F2}" SectionColor="#FFE53935" />
                                    <controls:LabeledSlider Value="{Binding PedalAbsBrakeGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="ABS Pulse" StringFormat="{}{0:F2}" SectionColor="#FFE53935" Margin="0,4,0,0" />
                                    <controls:LabeledSlider Value="{Binding PedalBrakePressureGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="Brake Pressure Hum" StringFormat="{}{0:F2}" SectionColor="#FF9800" Margin="0,4,0,0" />
                                    <controls:LabeledSlider Value="{Binding PedalRoadBrakeGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="Road Texture" StringFormat="{}{0:F2}" SectionColor="#FFE53935" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- ── GAS PEDAL column ── -->
                                <StackPanel Grid.Column="2">
                                    <Border Background="#264CAF50" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                        <TextBlock Text="GAS PEDAL" FontSize="12" FontWeight="Bold" Foreground="#FF4CAF50" HorizontalAlignment="Center" />
                                    </Border>
                                    <controls:LabeledSlider Value="{Binding PedalMasterGasGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="Master Gain" StringFormat="{}{0:F2}" SectionColor="#FF4CAF50" />
                                    <controls:LabeledSlider Value="{Binding PedalTcGasGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="TC Ignition Cut" StringFormat="{}{0:F2}" SectionColor="#FF4CAF50" Margin="0,4,0,0" />
                                    <controls:LabeledSlider Value="{Binding PedalScrubGasGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="Corner Scrub" StringFormat="{}{0:F2}" SectionColor="#FF4CAF50" Margin="0,4,0,0" />
                                    <controls:LabeledSlider Value="{Binding PedalThrottlePositionGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="Throttle Position" StringFormat="{}{0:F2}" SectionColor="#FF4CAF50" Margin="0,4,0,0" />
                                    <controls:LabeledSlider Value="{Binding PedalEngineRpmGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="Engine RPM Buzz" StringFormat="{}{0:F2}" SectionColor="#FF4CAF50" Margin="0,4,0,0" />
                                    <controls:LabeledSlider Value="{Binding PedalCurbBothGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="Curb (Shared)" StringFormat="{}{0:F2}" SectionColor="#FF9800" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- ── CLUTCH PEDAL column ── -->
                                <StackPanel Grid.Column="4">
                                    <Border Background="#26FF9800" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                        <TextBlock Text="CLUTCH PEDAL" FontSize="12" FontWeight="Bold" Foreground="#FFFF9800" HorizontalAlignment="Center" />
                                    </Border>
                                    <controls:LabeledSlider Value="{Binding PedalMasterClutchGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                        Label="Master Gain" StringFormat="{}{0:F2}" SectionColor="#FFFF9800" />
                                    <TextBlock Text="Clutch position signal. Needs clutch-capable hardware (MOZA PHF clutch module — the serial box drives brake + gas only)."
                                               FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PHF Effect Frequencies (0-100 Hz per module spec) -->
                    <Border Background="#FF1E2227" CornerRadius="6" Padding="14,12" Margin="0,0,0,20"
                            BorderThickness="1" BorderBrush="#3347A15C">
                        <StackPanel>
                            <TextBlock Text="PHF EFFECT FREQUENCIES (pitch per effect — PHF hardware only)" FontSize="12" FontWeight="Bold" Foreground="#FF4CAF50" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ABS" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MozaPhfAbsFreq, Mode=TwoWay}" VerticalAlignment="Center" Height="24" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding MozaPhfAbsFreq, StringFormat='{}{0}Hz'}" FontSize="11" Foreground="#FF4CAF50" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="TC" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MozaPhfTcFreq, Mode=TwoWay}" VerticalAlignment="Center" Height="24" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MozaPhfTcFreq, StringFormat='{}{0}Hz'}" FontSize="11" Foreground="#FF4CAF50" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Curb" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MozaPhfCurbFreq, Mode=TwoWay}" VerticalAlignment="Center" Height="24" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MozaPhfCurbFreq, StringFormat='{}{0}Hz'}" FontSize="11" Foreground="#FF4CAF50" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Road" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MozaPhfRoadFreq, Mode=TwoWay}" VerticalAlignment="Center" Height="24" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding MozaPhfRoadFreq, StringFormat='{}{0}Hz'}" FontSize="11" Foreground="#FF4CAF50" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Scrub" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MozaPhfScrubFreq, Mode=TwoWay}" VerticalAlignment="Center" Height="24" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding MozaPhfScrubFreq, StringFormat='{}{0}Hz'}" FontSize="11" Foreground="#FF4CAF50" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Engine RPM" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MozaPhfRpmFreq, Mode=TwoWay}" VerticalAlignment="Center" Height="24" />
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding MozaPhfRpmFreq, StringFormat='{}{0}Hz'}" FontSize="11" Foreground="#FF4CAF50" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════ -->
            <!-- PANEL 4: BUTTONS                           -->
            <!-- ═══════════════════════════════════════════ -->
            <ScrollViewer x:Name="ButtonsPanel" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed">
                <StackPanel>

                    <TextBlock Text="Configure wheel and button box inputs for in-app actions." FontSize="14" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,20" TextWrapping="Wrap" />

                    <!-- Snapshot Button Card -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="20,16" Margin="0,0,0,16"
                            BorderThickness="1" BorderBrush="#33E3B341">
                        <StackPanel>
                            <TextBlock Text="SNAPSHOT BUTTON" FontSize="12" FontWeight="Bold" Foreground="#FFE3B341" Margin="0,0,0,4" />
                            <TextBlock Text="Press while driving to auto-save a telemetry snapshot" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Button:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SnapshotButtonNames}" SelectedIndex="{Binding SnapshotButtonComboIndex}" FontSize="14" Padding="6,4" Margin="0,0,6,0" />
                                <Button Grid.Column="2" Content="Assign" Command="{Binding AssignSnapshotButtonCommand}" Padding="12,6" FontSize="14" Style="{StaticResource OutlinedButton}" ToolTip="Listen for a button press to assign as snapshot trigger" />
                            </Grid>
                            <TextBlock Text="{Binding SnapshotAssignStatus}" FontSize="13" Foreground="#FFFFD600" FontWeight="Bold" Visibility="{Binding SnapshotAssignStatus, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Text="{Binding ButtonDetectionText}" FontSize="13" Foreground="#FFFFD600" FontWeight="Bold" />
                            <TextBlock Text="Uses your FFB wheel device. Select a button easy to reach while driving." FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Panic Stop Button Card -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="20,16" Margin="0,0,0,16"
                            BorderThickness="1" BorderBrush="#33FF7B72">
                        <StackPanel>
                            <TextBlock Text="PANIC STOP BUTTON" FontSize="12" FontWeight="Bold" Foreground="#FFFF7B72" Margin="0,0,0,4" />
                            <TextBlock Text="Assign a button on a SEPARATE device (e.g. button box) as hardware panic stop. Immediately zeros all FFB output." FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Device:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PanicDevices}" SelectedItem="{Binding SelectedPanicDevice}" FontSize="14" Padding="6,4" Margin="0,0,10,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProductName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshDevicesCommand}" Padding="12,6" FontSize="14" Style="{StaticResource OutlinedButton}" ToolTip="Refresh the list of connected devices" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Button:" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PanicButtonNames}" SelectedIndex="{Binding PanicButtonComboIndex}" FontSize="14" Padding="6,4" Margin="0,0,6,0" />
                                <Button Grid.Column="2" Content="Assign" Command="{Binding AssignPanicButtonCommand}" Padding="12,6" FontSize="14" Style="{StaticResource OutlinedButton}" ToolTip="Listen for a button press to assign as panic stop" />
                            </Grid>

                            <TextBlock Text="{Binding PanicAssignStatus}" FontSize="13" Foreground="#FFFFD600" FontWeight="Bold" Visibility="{Binding PanicAssignStatus, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Panic Info -->
                    <Border Background="#FF1A1A2E" CornerRadius="6" Padding="14,10"
                            BorderThickness="1" BorderBrush="#333355">
                        <TextBlock Text="The panic device is opened in non-exclusive mode, so it won't conflict with the game or your FFB wheel." FontSize="13" Foreground="#FF9999CC" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════════════════════════════════════ -->
            <!-- PANEL: GAME CONFIG (per-game wheel setup)   -->
            <!-- ═══════════════════════════════════════════ -->
            <ScrollViewer x:Name="GameConfigPanel" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed">
                <StackPanel>

                    <TextBlock Text="Assetto Corsa needs the one-time setup below — game doesn't need to be running. Every other game works by selecting it and driving."
                               FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <!-- Assetto Corsa: three things, done once, in order.
                         Always visible on purpose: driver install and axis
                         binding need neither the game selected nor running.
                         (Live bridge state engages on its own once AC runs.) -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,14" Margin="0,0,0,16"
                            BorderThickness="1" BorderBrush="#3347A15C">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="ASSETTO CORSA — DO ONCE, IN ORDER" FontSize="12" FontWeight="Bold" Foreground="#FF7EE787" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding GameDisplayName}" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="The game and this app can't share your wheel, so the app makes a virtual wheel for the game. Your real wheel stays plugged into the app for its force." />

                            <TextBlock Text="1. Install the virtual wheel" FontSize="13" FontWeight="Bold" Foreground="#FFE6EDF3" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                                <Button Content="Install driver" Command="{Binding InstallVJoyDriverCommand}"
                                        Height="30" Padding="12,0"
                                        Background="#FF21262D" Foreground="#FFE6EDF3"
                                        BorderThickness="0" Cursor="Hand" FontSize="12"
                                        ToolTip="Downloads the vJoy driver, checks it, and installs it (one admin prompt). Reboot afterwards." />
                                <TextBlock FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Run FontWeight="Bold">
                                        <Run.Style>
                                            <Style TargetType="Run">
                                                <Setter Property="Text" Value="✓ ready" />
                                                <Setter Property="Foreground" Value="#FF7EE787" />
                                                <Style.Triggers>
                                                <DataTrigger Binding="{Binding VJoyDriverPresent}" Value="False">
                                                    <Setter Property="Text" Value="✗ not installed yet — hit Install driver below (one admin prompt, usually no reboot)" />
                                                    <Setter Property="Foreground" Value="#FFFF7A7A" />
                                                </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Run.Style>
                                    </Run>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding VJoyDriverStatus}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       TextWrapping="Wrap" Margin="18,4,0,10"
                                       Visibility="{Binding VJoyDriverStatus, Converter={StaticResource NotEmptyToVis}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <CheckBox IsChecked="{Binding AcVJoyBridgeEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="2. Send my wheel and pedals to the game" FontSize="13" FontWeight="Bold" Foreground="#FFE6EDF3" Cursor="Hand" />
                            </StackPanel>
                            <TextBlock Text="{Binding VJoyBridgeStatus}" FontSize="12" Foreground="#FF7EE787"
                                       TextWrapping="Wrap" Margin="18,0,0,10" />

                            <TextBlock Text="3. Pedals — press each one, all three bars should move:" FontSize="13" FontWeight="Bold" Foreground="#FFE6EDF3" Margin="0,0,0,4" />
                            <StackPanel Margin="18,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Gas" Width="52" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Value="{Binding SetupPedalGas, Mode=OneWay}" Minimum="0" Maximum="1" Height="12" Width="140" Foreground="#FF4CAF50" />
                                    <TextBlock Text="{Binding SetupPedalGas, Mode=OneWay, StringFormat=' {0:P0}'}" FontSize="12" Foreground="#FF4CAF50" Margin="4,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Brake" Width="52" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Value="{Binding SetupPedalBrake, Mode=OneWay}" Minimum="0" Maximum="1" Height="12" Width="140" Foreground="#FFE53935" />
                                    <TextBlock Text="{Binding SetupPedalBrake, Mode=OneWay, StringFormat=' {0:P0}'}" FontSize="12" Foreground="#FFE53935" Margin="4,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Clutch" Width="52" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                                    <ProgressBar Value="{Binding SetupPedalClutch, Mode=OneWay}" Minimum="0" Maximum="1" Height="12" Width="140" Foreground="#FFFF9800" />
                                    <TextBlock Text="{Binding SetupPedalClutch, Mode=OneWay, StringFormat=' {0:P0}'}" FontSize="12" Foreground="#FFFF9800" Margin="4,0,0,0" />
                                </StackPanel>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,6">
                                    <Run Text="Reading from: " /><Run Text="{Binding SetupPedalSource, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="  (your min/max/deadzone from Devices → Pedals apply here too)" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Separate USB pedals:" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox ItemsSource="{Binding PedalUsbDeviceNames}" SelectedIndex="{Binding PedalUsbDeviceIndex, Mode=TwoWay}"
                                              Width="220" Height="28" FontSize="12" />
                                    <Button Content="Rescan" Command="{Binding RescanPedalUsbDevicesCommand}"
                                            Height="28" Padding="10,0" Margin="8,0,0,0"
                                            Background="#FF21262D" Foreground="#FFE6EDF3"
                                            BorderThickness="0" Cursor="Hand" FontSize="12" />
                                </StackPanel>
                                <TextBlock Text="Pedals plugged into the wheelbase are automatic — leave this on Auto." FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                    <Button Content="Find my pedals…" Command="{Binding OpenPedalDetectDialogCommand}"
                                            Height="28" Padding="10,0"
                                            Background="#FF21262D" Foreground="#FFE6EDF3"
                                            BorderThickness="0" Cursor="Hand" FontSize="12"
                                            ToolTip="Opens pedal setup: big live bars plus per-pedal Detect, Undo and Clear." />
                                </StackPanel>
                                <TextBlock Text="{Binding PedalDetectStatus}" FontSize="12" Foreground="#FF7EE787"
                                           TextWrapping="Wrap" Margin="0,4,0,10"
                                           Visibility="{Binding PedalDetectStatus, Converter={StaticResource NotEmptyToVis}}" />
                            </StackPanel>

                            <TextBlock Text="4. Tell Assetto Corsa to use the virtual wheel (game must be closed):" FontSize="13" FontWeight="Bold" Foreground="#FFE6EDF3" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                                <Button Content="Point Assetto Corsa at the virtual wheel" Command="{Binding WriteAcVJoyBindingsCommand}"
                                        Height="30" Padding="12,0"
                                        Background="#FF21262D" Foreground="#FFE6EDF3"
                                        BorderThickness="0" Cursor="Hand" FontSize="12"
                                        ToolTip="Switches steering, pedals and your assigned button tasks in the game's settings file to the virtual wheel. Keyboard lines and everything else untouched; a backup is kept." />
                            </StackPanel>
                            <TextBlock Text="{Binding VJoyBindStatus}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       TextWrapping="Wrap" Margin="18,4,0,10" />

                            <TextBlock Text="5. Wheel buttons (gears, pits, lights…) — press to assign each task, then run step 4 again to push them to the game:" FontSize="13" FontWeight="Bold" Foreground="#FFE6EDF3" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal" Margin="18,0,0,4">
                                <TextBlock Text="{Binding VJoyButtonsText}" FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="Match buttons to wheel" Command="{Binding MatchVJoyButtonsCommand}"
                                        Height="26" Padding="10,0" Margin="8,0,0,0"
                                        Background="#FF21262D" Foreground="#FFE6EDF3"
                                        BorderThickness="0" Cursor="Hand" FontSize="11"
                                        ToolTip="Sets vJoy to 128 buttons (matches any racing wheel). One admin prompt, done forever." />
                                <Button Content="Open vJoyConf" Command="{Binding OpenVJoyConfCommand}"
                                        Height="26" Padding="10,0" Margin="8,0,0,0"
                                        Background="#FF21262D" Foreground="#FFE6EDF3"
                                        BorderThickness="0" Cursor="Hand" FontSize="11"
                                        ToolTip="Needs more vJoy buttons than the device offers? Change the count here (admin), Apply, then come back." />
                                <Button Content="Reset 1:1" Command="{Binding ResetVJoyButtonMapCommand}"
                                        Height="26" Padding="10,0" Margin="8,0,0,0"
                                        Background="#FF21262D" Foreground="#FFE6EDF3"
                                        BorderThickness="0" Cursor="Hand" FontSize="11"
                                        ToolTip="Repairs a scrambled map: every vJoy slot follows its own wheel button again. Task list is kept." />
                            </StackPanel>
                            <TextBlock Margin="18,0,0,4" FontSize="11" Foreground="{StaticResource TextDimBrush}">
                                <Run Text="Last wheel press: " /><Run Text="{Binding LastWheelButtonText, Mode=OneWay}" FontWeight="Bold" Foreground="#FFE6EDF3" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding AcTaskRows}" Margin="18,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding DisplayName}" Width="130" FontSize="12" Foreground="#FFE6EDF3" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Assignment, Mode=OneWay}" Width="190" FontSize="11" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Content="Press to assign" Command="{Binding DataContext.CaptureAcTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Section}"
                                                    Height="26" Padding="10,0" Margin="8,0,0,0"
                                                    Background="#FF21262D" Foreground="#FFE6EDF3"
                                                    BorderThickness="0" Cursor="Hand" FontSize="11" />
                                            <Button Content="Clear" Command="{Binding DataContext.ClearAcTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Section}"
                                                    Height="26" Padding="10,0" Margin="8,0,0,0"
                                                    Background="#FF21262D" Foreground="#FFE6EDF3"
                                                    BorderThickness="0" Cursor="Hand" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding VJoyTaskCapturePrompt}" FontSize="12" Foreground="#FF7EE787"
                                       TextWrapping="Wrap" Margin="18,4,0,10"
                                       Visibility="{Binding VJoyTaskCapturePrompt, Converter={StaticResource NotEmptyToVis}}" />

                            <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,0"
                                       Text="Then in the game's controls screen (stock options or Content Manager) check 'vJoy Device' owns steering, gas, brake, clutch and your tasks — and leave the game's force sliders at 100%. Its output goes nowhere, but this app reads the game's torque signal, which needs the gain up. After that, just drive." />
                        </StackPanel>
                    </Border>

                    <!-- Every other game: nothing to configure -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,14" Margin="0,0,0,16"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                            Visibility="{Binding IsAssettoCorsa, Converter={StaticResource InvertBoolToVis}}">
                        <StackPanel>
                            <TextBlock FontSize="13" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap">
                                <Run Text="{Binding GameDisplayName, Mode=OneWay, FallbackValue='This game'}" FontWeight="Bold" Foreground="#FFE6EDF3" />
                                <Run Text=" needs no extra setup — the app drives your wheel directly. Select the game and drive." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
