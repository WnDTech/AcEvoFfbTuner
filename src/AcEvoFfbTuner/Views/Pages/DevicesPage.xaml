                        <Border Grid.Column="2" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,12"
                                BorderThickness="1" BorderBrush="#33E08040">
                            <StackPanel>
                                <TextBlock Text="Back Lower Right" FontSize="11" FontWeight="SemiBold" Foreground="#FFC9D1D9" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                                    <Button Content="Copy from here" FontSize="11" Padding="6,1" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0" Foreground="#FFE08040"
                                            Visibility="{Binding Hf8CopyActive, Converter={StaticResource InvertBoolToVis}}"
                                            Command="{Binding Hf8SetCopySourceCommand}" CommandParameter="4">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
