<UserControl x:Class="AcEvoFfbTuner.Views.Pages.DevicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AcEvoFfbTuner.Controls"
             xmlns:converters="clr-namespace:AcEvoFfbTuner.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InvertBoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
        <converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370" MinWidth="320" MaxWidth="440" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: COMPACT DEVICE NAV (click a device → settings on the right) ═══ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,16,12,20">
            <StackPanel>

                <TextBlock Text="D E V I C E S" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,12" />

                <!-- WHEELBASE -->
                <controls:SectionCard Title="WHEELBASE"
                                      Tag="Wheelbase"
                                      SectionBrush="#FF47A1FF"
                                      Selectable="True" IsSelected="True">
                    <controls:SectionCard.SummaryContent>
                        <TextBlock FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap">
                            <Run Text="{Binding DeviceName, Mode=OneWay, FallbackValue='No device', TargetNullValue='No device'}" Foreground="#FFE6EDF3" />
                            <Run Text="  ·  " /><Run Text="{Binding IsDeviceConnected, Mode=OneWay, StringFormat='Connected: {0}'}" Foreground="#FF7EE787" />
                        </TextBlock>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

                <!-- LED EFFECTS -->
                <controls:SectionCard Title="LED EFFECTS"
                                      Tag="Led"
                                      SectionBrush="#FF79C0FF"
                                      Selectable="True">
                    <controls:SectionCard.SummaryContent>
                        <TextBlock FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap">
                            <Run Text="{Binding LedVisibleCount, Mode=OneWay, StringFormat='{}{0} LEDs'}" Foreground="#FF79C0FF" />
                            <Run Text="  ·  " /><Run Text="{Binding LedSupportedInfo, Mode=OneWay}" Foreground="#FF79C0FF" />
                        </TextBlock>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

                <!-- HAPTIC PAD -->
                <controls:SectionCard Title="HAPTIC PAD"
                                      Tag="Haptic"
                                      SectionBrush="#FFD2A8FF"
                                      Selectable="True">
                    <controls:SectionCard.SummaryContent>
                        <TextBlock FontSize="13" Foreground="#FFD2A8FF" TextWrapping="Wrap"
                                   Text="{Binding Hf8ConnectionStatus}" />
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

                <!-- BUTTONS -->
                <controls:SectionCard Title="BUTTONS"
                                      Tag="Buttons"
                                      SectionBrush="#FFE3B341"
                                      Selectable="True">
                    <controls:SectionCard.SummaryContent>
                        <TextBlock FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap">
                            <Run Text="Snapshot" Foreground="#FFE3B341" />
                            <Run Text=" · " /><Run Text="Panic Stop" Foreground="#FFE3B341" />
                        </TextBlock>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

                <!-- PEDALS -->
                <controls:SectionCard Title="PEDALS"
                                      Tag="Pedals"
                                      SectionBrush="#FF56D4A0"
                                      Selectable="True">
                    <controls:SectionCard.SummaryContent>
                        <StackPanel>
                            <TextBlock FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap">
                                <Run Text="Serial pedal haptics" />
                                <Run Text="  ·  " /><Run Text="{Binding OsoyooIsConnected, Mode=OneWay, StringFormat='Connected: {0}'}" Foreground="#FF7EE787" />
                            </TextBlock>
                            <Border Background="#33F0A030" CornerRadius="3" Padding="5,1" Margin="0,4,0,0"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="WIP" FontSize="9" FontWeight="Bold" Foreground="#FFF0A030" />
                            </Border>
                        </StackPanel>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

                <!-- GAME CONFIG -->
                <controls:SectionCard Title="GAME CONFIG"
                                       Tag="GameConfig"
                                       SectionBrush="#FF7EE787"
                                       Selectable="True">
                    <controls:SectionCard.SummaryContent>
                        <TextBlock FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap">
                            <Run Text="Per-game wheel setup" />
                            <Run Text="  ·  " /><Run Text="{Binding GameDisplayName, Mode=OneWay}" Foreground="#FF7EE787" />
                        </TextBlock>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ RIGHT: SELECTED DEVICE SETTINGS ═══ -->
        <Border Grid.Column="1" Margin="0,16,24,20"
                Background="{StaticResource BgPanel}"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Device header -->
                    <StackPanel Margin="24,20,24,0">
                        <DockPanel>
                            <Border x:Name="DetailHeaderAccent" DockPanel.Dock="Left" Width="4"
                                    CornerRadius="2" Background="#FF47A1FF"
                                    VerticalAlignment="Stretch" />
                            <TextBlock x:Name="DetailHeader" Text="WHEELBASE" FontSize="18" FontWeight="Bold"
                                       Foreground="#FF47A1FF"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,16" />
                    </StackPanel>

            <!-- ═══════════════════════════════════════════ -->
            <!-- PANEL 1: LED EFFECTS                      -->
            <!-- ═══════════════════════════════════════════ -->
            <ScrollViewer x:Name="WheelPanel" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>

                    <!-- Wheelbase connection info -->
                    <TextBlock FontSize="14" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4" TextWrapping="Wrap">
                        <Run Text="Wheelbase: " /><Run FontWeight="Bold" Foreground="#FFE6EDF3" Text="{Binding DeviceName}" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,16" TextWrapping="Wrap">
                        <Run Text="{Binding IsDeviceConnected, Mode=OneWay, StringFormat='Connected: {0}'}" />
                        <Run Text="   |   " /><Run Text="{Binding ForceInvertEnabled, Mode=OneWay, StringFormat='Force inversion: {0}'}" />
                        <Run Text="   |   " /><Run Text="{Binding SupportsPeriodicEffects, Mode=OneWay, StringFormat='Periodic effects: {0}'}" />
                    </TextBlock>

                    <!-- Logitech HID++ direct wheel settings (no G HUB) -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,14" Margin="0,0,0,16"
                            BorderThickness="1" BorderBrush="#33FF9800"
                            Visibility="{Binding LogitechCardsVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="LOGITECH WHEEL SETTINGS" FontSize="12" FontWeight="Bold" Foreground="#FFFF9800" VerticalAlignment="Center" />
                                <TextBlock Text="Direct HID++ — no G HUB needed" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding LogitechHidppStatus}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding LogitechModeInfo}" FontSize="12" Foreground="#FFFF9800"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />

                            <controls:LabeledSlider Value="{Binding LogitechFfbStrengthNm, Mode=TwoWay}" Minimum="1" Maximum="8" TickFrequency="0.1"
                                Label="FFB Strength" StringFormat="{}{0:F1}" Suffix=" Nm" LabelWidth="120"
                                Description="Wheel's own force gain (stored on the wheel). If force feels dead, this is usually the cause — set it high."
                                SectionColor="#FFFF9800" />
                            <controls:LabeledSlider Value="{Binding LogitechRotationDegrees, Mode=TwoWay}" Minimum="90" Maximum="2700" TickFrequency="10"
                                Label="Rotation" StringFormat="{}{0}" Suffix="°" LabelWidth="120"
                                Description="Steering rotation range stored on the wheel"
                                SectionColor="#FFFF9800" Margin="0,8,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Profile slot:" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding LogitechProfileSlotOptions}"
                                          SelectedValue="{Binding LogitechProfileSlot, Mode=TwoWay}"
                                          SelectedValuePath="Key" DisplayMemberPath="Value"
                                          IsEnabled="{Binding LogitechHidppConnected}"
                                          Width="260" Height="28" VerticalContentAlignment="Center"
                                          Background="#FF21262D" Foreground="#FFE6EDF3" BorderBrush="#3347A15C"
                                          Cursor="Hand" FontSize="12"
                                          ToolTip="Which wheel profile the app writes to. Onboard slots (1-5) store settings in the wheel and survive restarts; Desktop applies live but resets on wheel restart. Pick a slot you don't use for presets." />
                                <Button Content="Re-read Settings" Command="{Binding RefreshLogitechWheelCommand}"
                                        IsEnabled="{Binding LogitechHidppConnected}"
                                        Height="30" Padding="12,0" Margin="8,0,0,0"
                                        Background="#FF21262D" Foreground="#FFE6EDF3"
                                        BorderThickness="0" Cursor="Hand" FontSize="12" />
                                <Button Content="Desktop mode" Command="{Binding SwitchToDesktopModeCommand}"
                                        IsEnabled="{Binding LogitechHidppConnected}"
                                        Height="30" Padding="12,0" Margin="8,0,0,0"
                                        Background="#FF21262D" Foreground="#FFE6EDF3"
                                        BorderThickness="0" Cursor="Hand" FontSize="12"
                                        ToolTip="Switch the wheel to desktop mode so live changes apply immediately (resets on wheel restart)" />
                            </StackPanel>

                            <!-- Dynamic OLED screen (feature 0x8130 — experimental):
                                 live telemetry on the wheel's display. Kept inside the
                                 Logitech card with the other wheel-specific settings. -->
                            <DockPanel Margin="0,16,0,0">
                                <TextBlock Text="DYNAMIC OLED SCREEN" FontSize="11" FontWeight="Bold" Foreground="#FF47A1FF" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding OledStatus}" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding OledEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          IsEnabled="{Binding OledAvailable}"
                                          Content="Screen live" FontSize="12" Foreground="{StaticResource TextDimBrush}" Cursor="Hand" />
                                <TextBlock Grid.Column="2" Text="Screen:" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="3" SelectedIndex="{Binding OledScreen, Mode=TwoWay}"
                                          IsEnabled="{Binding OledAvailable}"
                                          Margin="8,0,0,0" Height="28" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Gear + Speed" />
                                    <ComboBoxItem Content="Speed only" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Wheel FFB Motor Test -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,14" Margin="0,0,0,16"
                            BorderThickness="1" BorderBrush="#3347A15C">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="WHEEL FFB TEST" FontSize="12" FontWeight="Bold" Foreground="#FF47A1FF" VerticalAlignment="Center" />
                                <TextBlock Text="Verifies the wheelbase executes force — telemetry paused" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="Hold the wheel loosely and press TEST FORCE — you should feel a clear pull for 3 seconds. If nothing happens, the wheel is not executing DirectInput force."
                                       FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Force %:" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.05"
                                        Value="{Binding WheelFfbTestIntensity, Mode=TwoWay}"
                                        VerticalAlignment="Center" Height="26" />
                                <TextBlock Grid.Column="2" Text="{Binding WheelFfbTestIntensity, StringFormat='{}{0:P0}'}"
                                           FontSize="12" FontWeight="Bold" Foreground="#FF47A1FF"
                                           VerticalAlignment="Center" Margin="8,0,0,0" Width="40" TextAlignment="Right" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="TEST FORCE" Command="{Binding StartWheelFfbTestCommand}"
                                        Height="32" Padding="12,0"
                                        Background="#FF47A1FF" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" />
                                <Button Content="STOP" Command="{Binding StopWheelFfbTestCommand}"
                                        Height="32" Padding="12,0" Margin="8,0,0,0"
                                        Background="#FF525252" Foreground="White"
                                        BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" />
                                <Button Content="BUZZ TEST" Command="{Binding TestBuzzCommand}"
                                        Height="32" Padding="12,0" Margin="8,0,0,0"
                                        Background="#FF21262D" Foreground="#FFE6EDF3"
                                        BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold"
                                        ToolTip="500ms 60Hz diagnostic vibration — verifies haptics path independently of telemetry" />
                            </StackPanel>
                            <TextBlock Text="{Binding WheelFfbTestStatus}" FontSize="12"
                                       Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- TrueForce stream (RS50 / G PRO — app is the FFB source, no G HUB) -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,14" Margin="0,0,0,16"
                            BorderThickness="1" BorderBrush="#3347A15C"
                            Visibility="{Binding LogitechCardsVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="TRUEFORCE STREAM" FontSize="12" FontWeight="Bold" Foreground="#FF47A15C" VerticalAlignment="Center" />
                                <TextBlock Text="Direct FFB channel — no G HUB needed" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding TrueForceStatus}" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding TrueForceEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="Enabled" FontSize="12" Foreground="{StaticResource TextDimBrush}" Cursor="Hand" />
                                <TextBlock Grid.Column="2" Text="Force scale:" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center" />
                                <Slider Grid.Column="3" Minimum="0.2" Maximum="2.0" TickFrequency="0.05"
                                        Value="{Binding TrueForceForceScale, Mode=TwoWay}"
                                        VerticalAlignment="Center" Height="26" Margin="8,0,0,0" />
                            </Grid>
                            <DockPanel Margin="0,10,0,0">
                                <CheckBox IsChecked="{Binding LogitechDiForceMode, Mode=TwoWay}" VerticalAlignment="Center"
                                          Content="Use DirectInput force instead (no TrueForce stream)" FontSize="12"
                                          Foreground="{StaticResource TextDimBrush}" Cursor="Hand"
                                          ToolTip="Experimental: force goes through DirectInput and the TrueForce stream never engages — no stream contention with the game, DI effects (incl. haptics) carry the force. Applies at the next connect." />
                                <TextBlock Text="Experimental — applies on reconnect" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="LedPanel" VerticalScrollBarVisibility="Auto" Padding="24,20" Visibility="Collapsed">
                <StackPanel>

                    <!-- Header -->
                    <TextBlock Text="{Binding LedSupportedInfo}" FontSize="14" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <!-- LED Strip Preview -->
                    <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,14" Margin="0,0,0,16"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <StackPanel>
                            <TextBlock Text="LED PREVIEW" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" />
                            <StackPanel x:Name="LedPreviewBar" Orientation="Horizontal" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Two columns -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Flash + Brightness -->
                        <StackPanel Grid.Column="0">

                            <!-- BRIGHTNESS -->
                            <StackPanel Visibility="{Binding LedBrightnessVisible, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="BRIGHTNESS" FontSize="12" FontWeight="Bold" Foreground="#FF79C0FF" Margin="0,0,0,8" />
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                    <controls:LabeledSlider Value="{Binding LedBrightness, Mode=TwoWay}" Minimum="5" Maximum="100" TickFrequency="1"
                                        Label="Brightness" StringFormat="{}{0}" Suffix="%"
                                        Description="LED brightness (SDK-connected wheels only)"
                                        SectionColor="#FF79C0FF" />
                                </Border>
                            </StackPanel>

                            <!-- FLASH EFFECTS -->
                            <TextBlock Text="FLASH EFFECTS" FontSize="12" FontWeight="Bold" Foreground="#FF79C0FF" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                <StackPanel>
                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Shift / Limiter Flash" FontSize="14" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <CheckBox IsChecked="{Binding LedShiftLimiterFlashEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="All LEDs flash at redline" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" />

                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="Pit Limiter Flash" FontSize="14" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <CheckBox IsChecked="{Binding LedPitLimiterFlashEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="Alternating outer LEDs when pit limiter active" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" />

                                    <DockPanel Margin="0,4">
                                        <TextBlock Text="ABS Flash" FontSize="14" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                        <CheckBox IsChecked="{Binding LedAbsFlashEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Text="First &amp; last LED when ABS active" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" />

                                    <StackPanel Visibility="{Binding LedFlagIndicatorsVisible, Converter={StaticResource BoolToVis}}">
                                        <DockPanel Margin="0,4">
                                            <TextBlock Text="Race Flag Indicators" FontSize="14" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                            <CheckBox IsChecked="{Binding LedFlagIndicatorsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Yellow, red, blue flags on LEDs" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,10" />
                                    </StackPanel>

                                    <Border Background="{StaticResource BgInput}" CornerRadius="6" Padding="12,10" Margin="0,4,0,0">
                                        <controls:LabeledSlider Value="{Binding LedFlashRate, Mode=TwoWay}" Minimum="2" Maximum="60" TickFrequency="1"
                                            Label="Flash Speed" StringFormat="{}{0}"
                                            Description="Lower = faster (2=very fast, 60=slow)"
                                            SectionColor="#FF79C0FF" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- COLOR SCHEME -->
                            <StackPanel Visibility="{Binding LedColorSchemeVisible, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                                <TextBlock Text="COLOR SCHEME" FontSize="12" FontWeight="Bold" Foreground="#FF79C0FF" Margin="0,0,0,8" />
                                <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Color Preset" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock Text="For wheels with per-LED RGB control" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8" />
                                        <ComboBox SelectedIndex="{Binding LedColorSchemeIndex}" Width="240" FontSize="14" Padding="6,4" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Traffic Light (Green/Yellow/Red)" />
                                            <ComboBoxItem Content="Blue Gradient" />
                                            <ComboBoxItem Content="Red Hot" />
                                            <ComboBoxItem Content="Monochrome" />
                                            <ComboBoxItem Content="Custom" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Column: RPM Thresholds -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RPM THRESHOLDS" FontSize="12" FontWeight="Bold" Foreground="#FF79C0FF" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="16,12"
                                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="Preset" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox SelectedIndex="{Binding LedRpmPresetIndex}" Width="240" FontSize="14" Padding="6,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Default (50-100%)" />
                                        <ComboBoxItem Content="Early (30-100%)" />
                                        <ComboBoxItem Content="Late (70-100%)" />
                                        <ComboBoxItem Content="Linear (10-100%)" />
                                        <ComboBoxItem Content="Custom" />
                                    </ComboBox>

                                    <Expander Style="{StaticResource SectionExpander}" Header="Individual RPM Thresholds" IsExpanded="True">
                                        <StackPanel>
                                            <TextBlock Text="Each LED lights up when RPM reaches its threshold (% of redline)" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8" />
                                            <controls:LabeledSlider Value="{Binding LedRpmThreshold1, Mode=TwoWay}" Minimum="5" Maximum="100" TickFrequency="1"
                                                Label="LED 1" LabelWidth="60" StringFormat="{}{0}" Suffix="%" ValueWidth="52"
                                                SectionColor="#FF79C0FF"
                                                Visibility="{Binding LedRpmThreshold1Visible, Converter={StaticResource BoolToVis}}" />
                                            <controls:LabeledSlider Value="{Binding LedRpmThreshold2, Mode=TwoWay}" Minimum="5" Maximum="100" TickFrequency="1"
                                                Label="LED 2" LabelWidth="60" StringFormat="{}{0}" Suffix="%" ValueWidth="52"
                                                SectionColor="#FF79C0FF"
                                                Visibility="{Binding LedRpmThreshold2Visible, Converter={StaticResource BoolToVis}}" />
                                            <controls:LabeledSlider Value="{Binding LedRpmThreshold3, Mode=TwoWay}" Minimum="5" Maximum="100" TickFrequency="1"
                                                Label="LED 3" LabelWidth="60" StringFormat="{}{0}" Suffix="%" ValueWidth="52"
                                                SectionColor="#FF79C0FF"
                                                Visibility="{Binding LedRpmThreshold3Visible, Converter={StaticResource BoolToVis}}" />
                                            <controls:LabeledSlider Value="{Binding LedRpmThreshold4, Mode=TwoWay}" Minimum="5" Maximum="100" TickFrequency="1"
                                                Label="LED 4" LabelWidth="60" StringFormat="{}{0}" Suffix="%" ValueWidth="52"
                                                SectionColor="#FF79C0FF"
                                                Visibility="{Binding LedRpmThreshold4Visible, Converter={StaticResource BoolToVis}}" />
                                            <controls:LabeledSlider Value="{Binding LedRpmThreshold5, Mode=TwoWay}" Minimum="5" Maximum="100" TickFrequency="1"
                                                Label="LED 5" LabelWidth="60" StringFormat="{}{0}" Suffix="%" ValueWidth="52"
                                                SectionColor="#FF79C0FF"
                                                Visibility="{Binding LedRpmThreshold5Visible, Converter={StaticResource BoolToVis}}" />
