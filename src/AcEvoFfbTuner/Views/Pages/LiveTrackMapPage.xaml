<UserControl x:Class="AcEvoFfbTuner.Views.Pages.LiveTrackMapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AcEvoFfbTuner.Controls"
             Background="{DynamicResource BgDark}"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="MapToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="MapToolButton" TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
            <Setter Property="Padding" Value="11,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Header: track, alignment status, map tools, live stats ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TrackTitle" Text="Waiting for a session" FontSize="20" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrackSubtitle" Text="Start driving to load the circuit" FontSize="12"
                               Foreground="{DynamicResource TextDimBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="LockPill" CornerRadius="11" Padding="10,3" Margin="0,0,4,0" Cursor="Hand"
                            Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            MouseLeftButtonUp="OnLockPillClick"
                            ToolTip="Click for alignment diagnostics">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LockDot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource TextDimBrush}" />
                            <TextBlock x:Name="LockText" Text="Waiting" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ToggleButton x:Name="SatelliteToggle" Content="Satellite" IsChecked="True" Style="{StaticResource MapToolToggle}"
                                  Checked="OnSatelliteToggled" Unchecked="OnSatelliteToggled"
                                  ToolTip="Satellite imagery under the track" />
                    <ToggleButton x:Name="CornersToggle" Content="Corners" IsChecked="True" Style="{StaticResource MapToolToggle}"
                                  Checked="OnCornersToggled" Unchecked="OnCornersToggled"
                                  ToolTip="Corner numbers (shown when zoomed in)" />
                    <ToggleButton x:Name="FieldToggle" Content="Field" IsChecked="True" Style="{StaticResource MapToolToggle}"
                                  Checked="OnFieldToggled" Unchecked="OnFieldToggled"
                                  ToolTip="Standings panel" />
                    <ToggleButton x:Name="FfbHeatToggle" Content="FFB Heatmap" Style="{StaticResource MapToolToggle}"
                                  IsChecked="{Binding ShowForceHeatmap}"
                                  ToolTip="Colour the driven line by wheel force: blue light, green/yellow working, red clipping" />
                    <ToggleButton x:Name="FfbDiagToggle" Content="FFB Diagnostics" Style="{StaticResource MapToolToggle}"
                                  IsChecked="{Binding ShowDiagnostics}"
                                  ToolTip="FFB event markers (snaps, oscillation, clipping), verdict and profile recommendations" />
                    <ToggleButton x:Name="CoachToggle" Content="Driver Coach" Style="{StaticResource MapToolToggle}"
                                  IsChecked="{Binding ShowCoach}"
                                  ToolTip="Each lap vs your best lap, corner by corner: time lost, braking point, apex and exit speed. Braking points on the map (white = best lap, orange = last lap)." />
                    <ToggleButton x:Name="FollowToggle" Content="Follow" Style="{StaticResource MapToolToggle}"
                                  ToolTip="Keep your car centred" />
                    <Button x:Name="FitBtn" Content="Fit track" Style="{StaticResource MapToolButton}" Click="OnFitClick"
                            ToolTip="Zoom to the whole circuit" />
                    <Button x:Name="RefreshDataBtn" Content="⟳" Style="{StaticResource MapToolButton}" Click="OnRefreshData"
                            ToolTip="Re-download the track layout" />
                </StackPanel>

                <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Rows="1" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="SPEED" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="SpeedValue" Text="--" Style="{StaticResource StatValue}" />
                    </StackPanel>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="LAP" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="LapValue" Text="--" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" ToolTip="Live gap to your best lap at this point (Driver Coach). Green = ahead, red = behind.">
                        <StackPanel>
                            <TextBlock Text="DELTA" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="DeltaValue" Text="--" Style="{StaticResource StatValue}" FontFamily="Consolas" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="SECTOR" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="SectorValue" Text="--" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="CORNER" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="CornerValue" Text="--" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="POSITION" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="RacePositionValue" Text="--" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Text="CLASS" Style="{StaticResource StatLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ClassDot" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                                <TextBlock x:Name="ClassValue" Text="--" Style="{StaticResource StatValue}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ═══ Map + field ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <controls:MapsuiMapControl x:Name="MapCtrl" />

                    <!-- Class legend -->
                    <Border x:Name="LegendCard" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                            Padding="10,6" CornerRadius="6" Background="#D0101418" Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <ItemsControl x:Name="LegendList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" MaxWidth="520" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                        <Ellipse Width="11" Height="11" Fill="{Binding DotFill}" Stroke="{Binding DotStroke}"
                                                 StrokeThickness="{Binding DotStrokeThickness}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#FFE6EDF3" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Count}" FontSize="12" Foreground="#FF8B949E"
                                                   VerticalAlignment="Center" Margin="5,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- FFB layers (from the former Track Map page) -->
                    <Border x:Name="FfbCard" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                            Padding="12,8" CornerRadius="6" Background="#E0101418" MaxWidth="340"
                            Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Visibility="{Binding ShowForceHeatmap, Converter={StaticResource BoolToVis}}" Margin="0,0,0,6">
                                <TextBlock Text="FFB HEATMAP" FontSize="11" FontWeight="Bold" Foreground="#FF79C0FF" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="18" Height="5" Fill="#FF0033FF" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="light" FontSize="11" Foreground="#FFB0B8C0" Margin="0,0,10,0" />
                                    <Rectangle Width="18" Height="5" Fill="#FF00E600" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="working" FontSize="11" Foreground="#FFB0B8C0" Margin="0,0,10,0" />
                                    <Rectangle Width="18" Height="5" Fill="#FFFF0000" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="clipping" FontSize="11" Foreground="#FFB0B8C0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowDiagnostics, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="FFB DIAGNOSTICS" FontSize="11" FontWeight="Bold" Foreground="#FF00E676" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="9" Height="9" Fill="#FF00E676" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="expected" FontSize="11" Foreground="#FFB0B8C0" Margin="0,0,10,0" />
                                    <Ellipse Width="9" Height="9" Fill="#FFFFD600" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="notable" FontSize="11" Foreground="#FFB0B8C0" Margin="0,0,10,0" />
                                    <Ellipse Width="9" Height="9" Fill="#FFFF3030" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Text="suspicious" FontSize="11" Foreground="#FFB0B8C0" />
                                </StackPanel>
                                <TextBlock Text="{Binding DiagnosticCoverage}" FontSize="11" Foreground="#FF00BCD4" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding DiagnosticSummary}" FontSize="11" Foreground="#FFB0B8C0" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding DiagnosticVerdict}" FontSize="12" Foreground="#FFF0883E" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding LastEventInfo}" FontSize="11" Foreground="#FFFF8A65" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,2,0,0" />
                                <TextBlock Text="WORST PLACES" FontSize="10" FontWeight="Bold" Foreground="#FF8B949E" Margin="0,6,0,2" />
                                <TextBlock Text="{Binding ProblemCornersText, TargetNullValue='', FallbackValue=''}" FontSize="11"
                                           Foreground="#FFE6EDF3" TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="#FF8B949E" Text="No events yet — keep driving.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProblemCornersText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Red on a straight = check FFB settings; green at corners = normal." FontSize="10"
                                           Foreground="#FF8B949E" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Loading / empty state -->
                    <Border x:Name="LoadingOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Padding="22,14" CornerRadius="8" Background="{DynamicResource BgPanel}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsHitTestVisible="False">
                        <StackPanel>
                            <TextBlock x:Name="LoadingTitle" Text="Waiting for a session" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="LoadingDetail" Text="The circuit appears here once the game reports a track."
                                       FontSize="12" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                                       MaxWidth="380" TextAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Field (standings) -->
            <Border x:Name="FieldPanel" Grid.Column="1" Width="250" Margin="10,0,0,0"
                    Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="0,10,0,6">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,0,14,8">
                        <TextBlock Text="FIELD" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="FieldCount" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{DynamicResource TextDimBrush}" />
                    </Grid>
                    <TextBlock x:Name="FieldEmpty" DockPanel.Dock="Top" Margin="14,4,14,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDimBrush}"
                               Text="No other cars reported yet. LMU and RaceRoom list the full field; AC EVO shares positions only." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="FieldList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Padding="10,4,12,4" Cursor="Hand" Background="Transparent"
                                            MouseLeftButtonUp="OnFieldRowClick" Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Fill="{Binding ClassBrush}" RadiusX="2" RadiusY="2" Height="18" />
                                            <TextBlock Grid.Column="1" Text="{Binding Place}" FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Number, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding ClassLabel, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="3" CornerRadius="3" Padding="4,0" Margin="6,0,0,0"
                                                    VerticalAlignment="Center" Background="{DynamicResource BgInput}"
                                                    Visibility="{Binding TagVisibility}">
                                                <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="Bold"
                                                           Foreground="{Binding TagBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentDimBg}" />
                                        </DataTrigger>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ FFB recommendations (FFB Diagnostics layer) ═══ -->
        <Border x:Name="RecommendationsPanel" Grid.Row="2" Margin="0,10,0,0" Padding="12,8"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding ShowDiagnostics, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Apply Profile Changes" Command="{Binding ApplyRecommendationsCommand}"
                        Style="{StaticResource MapToolButton}" VerticalAlignment="Top"
                        ToolTip="Applies the recommendations to the active profile" />
                <StackPanel>
                    <TextBlock Text="FFB RECOMMENDATIONS" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <TextBox IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}"
                             FontFamily="Consolas" FontSize="12" Text="{Binding RecommendationsText, Mode=OneWay}"
                             TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Driver Coach: last lap vs best lap, worst corners first ═══ -->
        <Border x:Name="CoachPanel" Grid.Row="3" Margin="0,10,0,0" Padding="12,8"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding ShowCoach, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="DRIVER COACH" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Rectangle Width="9" Height="9" Fill="#FFFFFFFF" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="best lap brake" FontSize="11" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,10,0" />
                        <Rectangle Width="9" Height="9" Fill="#FFFF9F43" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="last lap brake" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                    </StackPanel>
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="{Binding CoachHeader}" FontSize="13" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,6" />
                <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CoachRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding DeltaText}" FontSize="12" FontWeight="Bold"
                                               FontFamily="Consolas" Foreground="{Binding DeltaColor}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Advice}" FontSize="12" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <!-- An empty advice line must not push the figures down. -->
                                                        <DataTrigger Binding="{Binding Advice}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ Diagnostics (click the status pill) ═══ -->
        <Border x:Name="DiagPanel" Grid.Row="4" Visibility="Collapsed" Margin="0,10,0,0"
                Background="{DynamicResource BgPanel}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="6" Padding="10,6">
            <TextBlock x:Name="DiagText" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
