<UserControl x:Class="AcEvoFfbTuner.Views.Pages.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AcEvoFfbTuner.Converters"
             xmlns:help="clr-namespace:AcEvoFfbTuner.Help">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InvertBoolToVis" />

        <!-- ── Block templates (declared before the selector that references them) ── -->
        <DataTemplate x:Key="HelpParagraphTemplate">
            <TextBlock Text="{Binding Text}" FontSize="14" Foreground="#FFE6EDF3"
                       TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,12" />
        </DataTemplate>

        <DataTemplate x:Key="HelpBulletsTemplate">
            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Ellipse Width="6" Height="6" Fill="#FFF0883E" Margin="0,6,10,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding}" FontSize="14" Foreground="#FFE6EDF3"
                                       TextWrapping="Wrap" LineHeight="22" MaxWidth="820" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="HelpNoteTemplate">
            <Border Background="#1AF0883E" BorderBrush="#55F0883E" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                               Foreground="#FFF0883E" Margin="0,0,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#FFE6EDF3"
                               TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HelpSliderTemplate">
            <Border Background="#FF1C2128" CornerRadius="6" Padding="14,10" Margin="0,0,0,8"
                    BorderThickness="1" BorderBrush="#FF30363D">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#FFE6EDF3" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="#FF30363D" CornerRadius="3" Padding="7,2" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Range}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FF8B949E" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Feel}" FontSize="13" Foreground="#FF8B949E"
                               TextWrapping="Wrap" LineHeight="20" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <converters:HelpBlockTemplateSelector x:Key="BlockTemplateSelector"
                                              ParagraphTemplate="{StaticResource HelpParagraphTemplate}"
                                              BulletsTemplate="{StaticResource HelpBulletsTemplate}"
                                              NoteTemplate="{StaticResource HelpNoteTemplate}"
                                              SliderTemplate="{StaticResource HelpSliderTemplate}" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: SEARCH + ARTICLE LIST ═══ -->
        <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="HELP GUIDE" FontSize="12" FontWeight="Bold"
                           Foreground="#FFF0883E" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Text="Search or pick a topic" FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12" />

                <Border Grid.Row="2" Background="#FF161B22" CornerRadius="8"
                        BorderThickness="1" BorderBrush="#FF30363D">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="#FF1C2128" CornerRadius="6" Padding="8,4"
                                BorderThickness="1" BorderBrush="#FF30363D" Margin="8,8,8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#x1F50D;" FontSize="12"
                                           Foreground="#FF8B949E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox x:Name="SearchBox" Grid.Column="1" FontSize="13"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFE6EDF3" CaretBrush="#FFF0883E"
                                         TextChanged="OnSearchTextChanged"
                                         ToolTip="Search the guide — try 'kerb', 'damping' or 'pedals'" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="ArticleList" Grid.Row="1" Margin="4,0,4,4"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="OnArticleSelected">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,9" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBd" Background="Transparent" CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}" Margin="0,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#1AFFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBd" Property="Background" Value="#1AF0883E" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type help:HelpArticle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#FFE6EDF3" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                   Foreground="#FF8B949E" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <TextBlock x:Name="CountText" Grid.Row="3" FontSize="11"
                           Foreground="{StaticResource TextDimBrush}" Margin="4,8,0,0" />
            </Grid>
        </Border>

        <!-- ═══ RIGHT: ARTICLE CONTENT ═══ -->
        <ScrollViewer Grid.Column="1" x:Name="ContentScroller" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="32,26,32,26">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock x:Name="ArticleTitle" FontSize="28" FontWeight="Black"
                           Foreground="#FFF0883E" TextWrapping="Wrap" />
                <TextBlock x:Name="ArticleSubtitle" FontSize="15" Foreground="#FF8B949E"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
                <Border Background="#FF30363D" Height="1" Margin="0,18,0,20" />

                <ItemsControl x:Name="SectionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="Bold"
                                           Foreground="#FFE6EDF3" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Blocks}"
                                              ItemTemplateSelector="{StaticResource BlockTemplateSelector}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
