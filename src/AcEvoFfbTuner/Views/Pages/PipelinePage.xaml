<UserControl x:Class="AcEvoFfbTuner.Views.Pages.PipelinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AcEvoFfbTuner.Controls"
             Background="#FF0F1117"
             Foreground="#FFE6EDF3"
             FontFamily="Segoe UI"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF161B22" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF30363D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style x:Key="Arrow" TargetType="TextBlock">
            <Setter Property="Text" Value="→" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="#FF484F58" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
        <Style x:Key="BranchLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ═══ HEADER BAR ═══ -->
        <Border DockPanel.Dock="Top" Background="#FF1C2128" CornerRadius="6" Padding="14,8" Margin="8,8,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="GAME  " FontSize="11" FontWeight="Bold" Foreground="#FF8B949E" VerticalAlignment="Center" />
                        <TextBlock x:Name="GameNameLabel" Text="No game" FontSize="15" FontWeight="Bold" Foreground="#FF79C0FF" VerticalAlignment="Center" />
                        <TextBlock x:Name="PipelineClassLabel" Text="" FontSize="12" FontFamily="Consolas" Foreground="#FF8B949E" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="LiveStatusLabel" Text="Click any stage to inspect it." FontSize="12" Foreground="#FF8B949E" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="FreezeCheck" Content="Freeze" FontSize="13" Foreground="#FFE6EDF3" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Reset peaks" Click="OnResetPeaks" Cursor="Hand" Padding="10,4" FontSize="12"
                            Background="#FF30363D" Foreground="#FFE6EDF3" BorderThickness="1" BorderBrush="#FF484F58" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ DETAIL PANEL (bottom, collapsible) ═══ -->
        <Border x:Name="DetailPanel" DockPanel.Dock="Bottom" Background="#FF161B22" CornerRadius="8"
                Padding="18,14" Margin="8,0,8,8" Visibility="Collapsed" BorderThickness="1" BorderBrush="#FFF0883E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock x:Name="DetailNum" Text="" FontSize="48" FontWeight="Black" Foreground="#FF30363D" HorizontalAlignment="Center" />
                    <controls:LedVuMeter x:Name="DetailMeter" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock x:Name="DetailSign" Text="" FontSize="20" FontWeight="Bold" Foreground="#FF8B949E" Margin="0,0,8,0" />
                        <TextBlock x:Name="DetailVal" Text="0.000" FontSize="20" FontFamily="Consolas" Foreground="#FFE6EDF3" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock x:Name="DetailTitle" Text="" FontSize="20" FontWeight="Bold" Foreground="#FFE6EDF3" VerticalAlignment="Center" />
                        <Border x:Name="DetailBadge" Background="#1A7EE787" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailBadgeText" Text="ACTIVE" FontSize="12" FontWeight="Bold" Foreground="#FF7EE787" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DetailField" Text="" FontSize="13" FontFamily="Consolas" Foreground="#FF00E676" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailDesc" Text="" FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailLane" Text="" FontSize="11" Foreground="#FF607D8B" />
                    <TextBlock x:Name="DetailGameNote" Text="" FontSize="12" Foreground="#FFF0883E" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN FLOW ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,4,8,0">
            <StackPanel>

                <!-- LEGEND -->
                <TextBlock FontSize="11" Foreground="#FF607D8B" Margin="8,0,0,6" TextWrapping="Wrap">
                    <Run Text="Click any stage to expand. " FontWeight="Bold" />
                    <Run Foreground="#FF00E676" Text="Green = active " />
                    <Run Foreground="#FF8B949E" Text="| " />
                    <Run Text="dim = bypassed for this game " />
                    <Run Foreground="#FF8B949E" Text="| " />
                    <Run Text="white outline = peak-hold. " />
                    <Run Foreground="#FFFF1744" Text="Red segment = hot." />
                </TextBlock>

                <!-- ═══ ROW 1: INPUT → MIX → NORM → LUT (linear head) ═══ -->
                <TextBlock Text="SIGNAL CHAIN" FontSize="11" FontWeight="Bold" Foreground="#FF8B949E" Margin="8,0,0,4" />
                <UniformGrid x:Name="HeadRow" Rows="1" Margin="0,0,0,2">
                    <Border x:Name="Card01" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="01" Margin="0,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="01" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                <TextBlock Text="INPUT" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <controls:LedVuMeter x:Name="Meter01" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Val01" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="Raw Mz/Fx/Fy" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="→" Style="{StaticResource Arrow}" />
                    <Border x:Name="Card02" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="02" Margin="0,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="02" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                <TextBlock Text="MIX" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <controls:LedVuMeter x:Name="Meter02" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Val02" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="Blend to centre" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="→" Style="{StaticResource Arrow}" />
                    <Border x:Name="Card03" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="03" Margin="0,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="03" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                <TextBlock Text="NORM" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <controls:LedVuMeter x:Name="Meter03" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Val03" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="Gain ÷ scale" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="→" Style="{StaticResource Arrow}" />
                    <Border x:Name="Card04" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="04" Margin="0,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="04" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                <TextBlock Text="LUT" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <controls:LedVuMeter x:Name="Meter04" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Val04" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="33-pt curve" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- SPLIT INDICATOR -->
                <Border Background="#FF21262D" CornerRadius="6" Padding="8,4" Margin="0,4,0,4" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SPLIT ──  same tick feeds BOTH branches  ── MERGE" FontSize="11" Foreground="#FF8B949E" />
                    </StackPanel>
                </Border>

                <!-- ═══ ROW 2: TWO PARALLEL BRANCHES ═══ -->
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- CORE branch label -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CORE PATH — zero-latency centering" Style="{StaticResource BranchLabel}" Foreground="#FF7EE787" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="DETAIL PATH — filtered texture + effects" Style="{StaticResource BranchLabel}" Foreground="#FF79C0FF" />

                    <!-- CORE: 05 → 06 → 07 -->
                    <UniformGrid Grid.Row="1" Grid.Column="0" Rows="1" Margin="0,0,4,0">
                        <Border x:Name="Card05" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="05" Margin="0,0,4,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="05" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                    <TextBlock Text="DAMP" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <controls:LedVuMeter x:Name="Meter05" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Val05" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="Viscous + friction" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" Style="{StaticResource Arrow}" />
                        <Border x:Name="Card06" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="06" Margin="0,0,4,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="06" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                    <TextBlock Text="GAIN" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <controls:LedVuMeter x:Name="Meter06" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Val06" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="OutputGain" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" Style="{StaticResource Arrow}" />
                        <Border x:Name="Card07" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="07" Margin="0,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="07" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                    <TextBlock Text="CORE" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <controls:LedVuMeter x:Name="Meter07" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Val07" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="Self-align torque" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Divider -->
                    <Border Grid.Row="1" Grid.Column="1" Width="1" Background="#FF30363D" Margin="4,12,4,12" />

                    <!-- DETAIL: 08 → 09 → 10 → 11 → 12 -->
                    <UniformGrid Grid.Row="1" Grid.Column="2" Rows="1" Margin="4,0,0,0">
                        <Border x:Name="Card08" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="08" Margin="0,0,3,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="08" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                    <TextBlock Text="SLIP" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <controls:LedVuMeter x:Name="Meter08" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Val08" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="Slip enhancer" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" Style="{StaticResource Arrow}" />
                        <Border x:Name="Card09" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="09" Margin="0,0,3,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="09" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                    <TextBlock Text="DYN" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <controls:LedVuMeter x:Name="Meter09" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Val09" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="G + flex" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" Style="{StaticResource Arrow}" />
                        <Border x:Name="Card10" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="10" Margin="0,0,3,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="10" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                    <TextBlock Text="VIB" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <controls:LedVuMeter x:Name="Meter10" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Val10" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="Curb/slip/road" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" Style="{StaticResource Arrow}" />
                        <Border x:Name="Card11" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="11" Margin="0,0,3,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="11" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                    <TextBlock Text="MODS" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <controls:LedVuMeter x:Name="Meter11" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Val11" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="ABS/road/LFE" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="→" Style="{StaticResource Arrow}" />
                        <Border x:Name="Card12" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="12" Margin="0,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="12" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                    <TextBlock Text="DETAIL" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <controls:LedVuMeter x:Name="Meter12" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Val12" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <TextBlock Text="EQ + slew" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>

                <!-- ═══ ROW 3: MERGE → PRE → CLIP → WHEEL (linear tail) ═══ -->
                <TextBlock Text="MERGE" FontSize="11" FontWeight="Bold" Foreground="#FF8B949E" Margin="8,4,0,4" HorizontalAlignment="Center" />
                <UniformGrid x:Name="TailRow" Rows="1" Margin="0,0,0,2">
                    <Border x:Name="Card13" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="13" Margin="0,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="13" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                <TextBlock Text="PRE" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <controls:LedVuMeter x:Name="Meter13" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Val13" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="Core + detail" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="→" Style="{StaticResource Arrow}" />
                    <Border x:Name="Card14" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="14" Margin="0,0,4,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="14" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                <TextBlock Text="CLIP" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <controls:LedVuMeter x:Name="Meter14" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Val14" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="Soft-clip + gate" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="→" Style="{StaticResource Arrow}" />
                    <Border x:Name="Card15" Style="{StaticResource Card}" MouseLeftButtonDown="OnStageClick" Tag="15" Margin="0,0,0,0" BorderBrush="#FFF0883E">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="15" FontSize="11" FontWeight="Bold" Foreground="#FF30363D" VerticalAlignment="Center" />
                                <TextBlock Text="WHEEL" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <controls:LedVuMeter x:Name="Meter15" HorizontalAlignment="Center" />
                            <TextBlock x:Name="Val15" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock x:Name="SubWheel" Text="DirectInput" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ═══ PARALLEL OUTPUTS ═══ -->
                <TextBlock Text="SAME TICK — PARALLEL OUTPUTS" FontSize="11" FontWeight="Bold" Foreground="#FFF0883E" Margin="8,8,0,4" />
                <UniformGrid Rows="1" Margin="0,0,0,6">
                    <Border x:Name="SideHf8" Style="{StaticResource Card}" Margin="0,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="HF8 PAD" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" />
                            <controls:LedVuMeter x:Name="MeterHf8" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ValHf8" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock x:Name="SubHf8" Text="8-motor haptic" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SidePedal" Style="{StaticResource Card}" Margin="0,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PEDALS" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" />
                            <controls:LedVuMeter x:Name="MeterPedal" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ValPedal" Text="0%" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock x:Name="SubPedal" Text="Brake + Gas" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SideLed" Style="{StaticResource Card}" Margin="0,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="WHEEL LEDs" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" />
                            <controls:LedVuMeter x:Name="MeterLed" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ValLed" Text="0%" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock x:Name="SubLed" Text="RPM" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- GAME NOTES -->
                <Border Background="#FF161B22" CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
                    <TextBlock x:Name="GameNotesText" TextWrapping="Wrap" FontSize="12" Foreground="#FF8B949E" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
