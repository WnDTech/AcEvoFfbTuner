<UserControl x:Class="AcEvoFfbTuner.Views.Pages.PipelinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AcEvoFfbTuner.Controls"
             Background="#FF0F1117"
             Foreground="#FFE6EDF3"
             FontFamily="Segoe UI"
             UseLayoutRounding="True">
    <!-- Layout: serpentine swimlanes (one lane per pipeline section, stacked
         vertically, left→right flow inside each lane). Nodes are FIXED 190px,
         connectors are FIXED 24px — they never stretch or squash. Each lane
         scrolls horizontally on narrow windows instead of crushing its cards.
         This follows the standard layered-DAG / audio-signal-chain convention:
         fixed node size + fixed edge size + explicit fork/join bars. -->
    <UserControl.Resources>
        <Style x:Key="FlowCard" TargetType="Border">
            <Setter Property="Background" Value="#FF161B22" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF30363D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="190" />
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="OutCard" TargetType="Border">
            <Setter Property="Background" Value="#FF161B22" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF30363D" />
            <Setter Property="MinWidth" Value="190" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="FlowArrow" TargetType="TextBlock">
            <Setter Property="Text" Value="→" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#FF484F58" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="24" />
        </Style>
        <Style x:Key="LaneBox" TargetType="Border">
            <Setter Property="Background" Value="#FF12161D" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF30363D" />
        </Style>
        <Style x:Key="LaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="8,10,0,4" />
        </Style>
        <Style x:Key="CardNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FF3D444D" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#FFE6EDF3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CardVal" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Foreground" Value="#FFE6EDF3" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="CardSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#FF607D8B" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ForkJoin" TargetType="Border">
            <Setter Property="Background" Value="#FF21262D" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="ForkJoinText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FF8B949E" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">

        <!-- ═══ HEADER BAR ═══ -->
        <Border DockPanel.Dock="Top" Background="#FF1C2128" CornerRadius="6" Padding="14,8" Margin="8,8,8,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="GAME  " FontSize="11" FontWeight="Bold" Foreground="#FF8B949E" VerticalAlignment="Center" />
                        <TextBlock x:Name="GameNameLabel" Text="No game" FontSize="15" FontWeight="Bold" Foreground="#FF79C0FF" VerticalAlignment="Center" />
                        <TextBlock x:Name="PipelineClassLabel" Text="" FontSize="12" FontFamily="Consolas" Foreground="#FF8B949E" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="LiveStatusLabel" Text="Click any stage to inspect it." FontSize="12" Foreground="#FF8B949E" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="FreezeCheck" Content="Freeze" FontSize="13" Foreground="#FFE6EDF3" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Reset peaks" Click="OnResetPeaks" Cursor="Hand" Padding="10,4" FontSize="12"
                            Background="#FF30363D" Foreground="#FFE6EDF3" BorderThickness="1" BorderBrush="#FF484F58" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ DETAIL PANEL (bottom, collapsible) ═══ -->
        <Border x:Name="DetailPanel" DockPanel.Dock="Bottom" Background="#FF161B22" CornerRadius="8"
                Padding="18,14" Margin="8,0,8,8" Visibility="Collapsed" BorderThickness="1" BorderBrush="#FFF0883E">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock x:Name="DetailNum" Text="" FontSize="48" FontWeight="Black" Foreground="#FF30363D" HorizontalAlignment="Center" />
                    <controls:LedVuMeter x:Name="DetailMeter" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock x:Name="DetailSign" Text="" FontSize="20" FontWeight="Bold" Foreground="#FF8B949E" Margin="0,0,8,0" />
                        <TextBlock x:Name="DetailVal" Text="0.000" FontSize="20" FontFamily="Consolas" Foreground="#FFE6EDF3" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock x:Name="DetailTitle" Text="" FontSize="20" FontWeight="Bold" Foreground="#FFE6EDF3" VerticalAlignment="Center" />
                        <Border x:Name="DetailBadge" Background="#1A7EE787" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailBadgeText" Text="ACTIVE" FontSize="12" FontWeight="Bold" Foreground="#FF7EE787" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DetailField" Text="" FontSize="13" FontFamily="Consolas" Foreground="#FF00E676" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailDesc" Text="" FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock x:Name="DetailLane" Text="" FontSize="11" Foreground="#FF607D8B" />
                    <TextBlock x:Name="DetailGameNote" Text="" FontSize="12" Foreground="#FFF0883E" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN FLOW (vertical page scroll; each lane scrolls horizontally) ═══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4,8,0">
            <StackPanel>

                <!-- LEGEND -->
                <TextBlock FontSize="11" Foreground="#FF607D8B" Margin="8,0,0,2" TextWrapping="Wrap">
                    <Run Text="Flow runs left → right inside each lane, top → bottom across lanes. Click any stage to expand. " FontWeight="Bold" />
                    <Run Foreground="#FF00E676" Text="Green = active " />
                    <Run Foreground="#FF8B949E" Text="| " />
                    <Run Text="dim = bypassed for this game " />
                    <Run Foreground="#FF8B949E" Text="| " />
                    <Run Text="white outline = peak-hold. " />
                    <Run Foreground="#FFFF1744" Text="Red segment = hot." />
                </TextBlock>

                <!-- ═══ LANE 1: SIGNAL CHAIN ═══ -->
                <TextBlock Text="1 · SIGNAL CHAIN — input conditioning" Style="{StaticResource LaneTitle}" Foreground="#FF8B949E" />
                <Border Style="{StaticResource LaneBox}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Border x:Name="Card01" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="01">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="01" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="INPUT" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter01" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val01" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="Raw Mz/Fx/Fy" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card02" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="02">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="02" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="MIX" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter02" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val02" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="Blend to centre" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card03" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="03">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="03" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="NORM" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter03" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val03" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="Gain ÷ scale" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card04" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="04">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="04" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="LUT" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter04" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val04" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="33-pt curve" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- FORK -->
                <Border Style="{StaticResource ForkJoin}">
                    <TextBlock Style="{StaticResource ForkJoinText}" Text="▼  FORK — the same tick feeds BOTH lanes below in parallel" />
                </Border>

                <!-- ═══ LANE 2: BRANCH A — CORE ═══ -->
                <TextBlock Text="2A · BRANCH A — CORE PATH · zero-latency centering" Style="{StaticResource LaneTitle}" Foreground="#FF7EE787" />
                <Border Style="{StaticResource LaneBox}" BorderBrush="#FF1F3D2B">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Border x:Name="Card05" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="05">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="05" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="DAMP" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter05" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val05" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="Viscous + friction" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card06" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="06">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="06" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="GAIN" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter06" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val06" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="OutputGain" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card07" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="07">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="07" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="CORE" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter07" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val07" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="Self-align torque" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ═══ LANE 3: BRANCH B — DETAIL ═══ -->
                <TextBlock Text="2B · BRANCH B — DETAIL PATH · filtered texture + effects" Style="{StaticResource LaneTitle}" Foreground="#FF79C0FF" />
                <Border Style="{StaticResource LaneBox}" BorderBrush="#FF1E3A52">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Border x:Name="Card08" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="08">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="08" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="SLIP" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter08" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val08" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="Slip enhancer" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card09" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="09">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="09" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="DYN" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter09" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val09" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="G + flex" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card10" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="10" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="VIB" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter10" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val10" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="Curb/slip/road" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card11" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="11">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="11" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="MODS" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter11" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val11" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="ABS/road/LFE" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card12" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="12" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="DETAIL" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter12" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val12" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="EQ + slew" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- JOIN -->
                <Border Style="{StaticResource ForkJoin}">
                    <TextBlock Style="{StaticResource ForkJoinText}" Text="▲  JOIN — filtered core + detail summed below" />
                </Border>

                <!-- ═══ LANE 4: OUTPUT ═══ -->
                <TextBlock Text="3 · OUTPUT — merge + limit + wheel" Style="{StaticResource LaneTitle}" Foreground="#FFF0883E" />
                <Border Style="{StaticResource LaneBox}" BorderBrush="#FF4A3520">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Border x:Name="Card13" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="13">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="13" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="PRE" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter13" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val13" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="Core + detail" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card14" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="14" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="CLIP" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter14" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val14" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock Text="Soft-clip + gate" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource FlowArrow}" />
                            <Border x:Name="Card15" Style="{StaticResource FlowCard}" MouseLeftButtonDown="OnStageClick" Tag="15" BorderBrush="#FFF0883E">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="15" Style="{StaticResource CardNum}" />
                                        <TextBlock Text="WHEEL" Style="{StaticResource CardName}" />
                                    </Grid>
                                    <controls:LedVuMeter x:Name="Meter15" Compact="True" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Val15" Text="0.000" Style="{StaticResource CardVal}" />
                                    <TextBlock x:Name="SubWheel" Text="DirectInput" Style="{StaticResource CardSub}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ═══ PARALLEL OUTPUTS ═══ -->
                <TextBlock Text="SAME TICK — PARALLEL OUTPUTS" FontSize="11" FontWeight="Bold" Foreground="#FFF0883E" Margin="8,12,0,4" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SideHf8" Grid.Column="0" Style="{StaticResource OutCard}" Margin="0,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="HF8 PAD" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" />
                            <controls:LedVuMeter x:Name="MeterHf8" Compact="True" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock x:Name="ValHf8" Text="0.000" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock x:Name="SubHf8" Text="8-motor haptic" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SidePedal" Grid.Column="1" Style="{StaticResource OutCard}" Margin="4,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PEDALS" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" />
                            <controls:LedVuMeter x:Name="MeterPedal" Compact="True" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock x:Name="ValPedal" Text="0%" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock x:Name="SubPedal" Text="Brake + Gas" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SideLed" Grid.Column="2" Style="{StaticResource OutCard}" Margin="4,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="WHEEL LEDs" FontSize="11" FontWeight="Bold" Foreground="#FFE6EDF3" HorizontalAlignment="Center" />
                            <controls:LedVuMeter x:Name="MeterLed" Compact="True" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <TextBlock x:Name="ValLed" Text="0%" FontSize="11" FontFamily="Consolas" Foreground="#FFE6EDF3" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock x:Name="SubLed" Text="RPM" FontSize="9" Foreground="#FF607D8B" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- GAME NOTES -->
                <Border Background="#FF161B22" CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
                    <TextBlock x:Name="GameNotesText" TextWrapping="Wrap" FontSize="12" Foreground="#FF8B949E" />
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
