<UserControl x:Class="AcEvoFfbTuner.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AcEvoFfbTuner.Converters"
             xmlns:models="clr-namespace:AcEvoFfbTuner.Models">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <converters:DeviceIconTypeToGeometryConverter x:Key="IconTypeToGeometry" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <converters:BoolToGlowColorConverter x:Key="BoolToGlow" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24">
        <StackPanel>

            <!-- Update Available Banner (prominent — top priority) -->
            <Border Background="{DynamicResource UiC_55FFD600}" CornerRadius="{DynamicResource UiR8}" Padding="16,12" Margin="0,0,0,8"
                    BorderThickness="1" BorderBrush="{DynamicResource UiC_88FFD600}"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource UiWarn}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⏫ Update available" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                            <Setter Property="Text" Value="⏬ Downloading update..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" Foreground="{DynamicResource UiText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{Binding LatestVersionText, StringFormat='Install {0}'}"
                            Command="{Binding DownloadAndInstallUpdateCommand}" Cursor="Hand"
                            FontSize="13" FontWeight="Bold" Padding="18,8" Margin="12,0,0,0"
                            Background="{DynamicResource UiBgDeep}" Foreground="{DynamicResource UiWarn}" BorderThickness="0"
                            ToolTip="Download the latest version" />
                </Grid>
            </Border>

            <!-- Test Drive beta offer (testers on full releases only) -->
            <Border Background="{DynamicResource UiC_339E6BFF}" CornerRadius="{DynamicResource UiR8}" Padding="16,12" Margin="0,0,0,8"
                    BorderThickness="1" BorderBrush="{DynamicResource UiC_889E6BFF}"
                    Visibility="{Binding IsBetaOfferAvailable, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource UiC_FFC9B3FF}"
                                   Text="{Binding BetaOfferVersionText, StringFormat='🧪 Test Drive beta {0} is available'}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource UiText}" TextWrapping="Wrap"
                                   Text="You're on full releases. Installing the beta moves you back to the Test Drive channel." />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Install beta"
                            Command="{Binding InstallBetaOfferCommand}" Cursor="Hand"
                            FontSize="13" FontWeight="Bold" Padding="18,8" Margin="12,0,0,0"
                            Background="{DynamicResource UiBgDeep}" Foreground="{DynamicResource UiC_FFC9B3FF}" BorderThickness="0"
                            ToolTip="Download and install the latest Test Drive beta build" />
                </Grid>
            </Border>

            <!-- ═══ DEVICE STATUS VISUALIZER ═══ -->
            <Border Background="{DynamicResource UiBgDeep}" CornerRadius="{DynamicResource UiR8}" Padding="20,14" Margin="0,0,0,8"
                    BorderThickness="1" BorderBrush="{DynamicResource UiBorder}">
                <ItemsControl ItemsSource="{Binding DeviceStatuses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DeviceStatus}">
                            <Border ToolTip="{Binding TooltipText}" Cursor="Hand"
                                    Background="Transparent" CornerRadius="{DynamicResource UiR8}" Padding="14,8"
                                    Width="120">
                                <StackPanel HorizontalAlignment="Center">
                                    <Viewbox Width="52" Height="52" Margin="0,0,0,6">
                                        <Path Data="{Binding IconType, Converter={StaticResource IconTypeToGeometry}}"
                                              Fill="{DynamicResource UiText}"
                                              Stretch="Uniform"
                                              Opacity="{Binding IsConnected, Converter={StaticResource BoolToOpacity}}">
                                            <Path.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="16"
                                                                  Color="{Binding IsConnected, Converter={StaticResource BoolToGlow}}"
                                                                  Opacity="0.6"/>
                                            </Path.Effect>
                                        </Path>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource UiTextDim}"
                                               TextAlignment="Center" TextWrapping="Wrap"
                                               MaxWidth="110" MaxHeight="28"
                                               Opacity="{Binding IsConnected, Converter={StaticResource BoolToOpacity}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Status Message -->
            <Border Background="{DynamicResource UiCard}" CornerRadius="{DynamicResource UiR8}" Padding="14,10" Margin="0,0,0,16"
                    BorderThickness="1" BorderBrush="{DynamicResource UiBorder}"
                    Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVis}}">
                <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" />
            </Border>

            <!-- ═══ GLASS COCKPIT PFD ═══ (seamless instrument panel) -->
            <Border Background="{DynamicResource UiBgDeep}" CornerRadius="{DynamicResource UiR8}" Padding="20,16" Margin="0,0,0,16"
                    BorderThickness="1" BorderBrush="{DynamicResource UiBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top strip: speed + status -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SpeedKmh, StringFormat='{}{0:F0}'}"
                                       FontSize="40" FontWeight="Black" Foreground="{DynamicResource UiWarn}" />
                            <TextBlock Text="km/h" FontSize="13" Foreground="{DynamicResource UiTextDim}" Margin="6,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource UiBorderStrong}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource UiLime}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="IDLE" />
                                        <Setter Property="Foreground" Value="{DynamicResource UiBorderStrong}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="RUNNING" />
                                                <Setter Property="Foreground" Value="{DynamicResource UiLime}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding PacketsPerSecond, StringFormat='  {0} pkt/s'}" FontSize="11" Foreground="{DynamicResource UiTextDim}" VerticalAlignment="Center" Margin="14,0,0,0" />
                            <Ellipse Width="3" Height="3" Fill="{DynamicResource UiBorder}" Margin="8,0" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource UiBorderStrong}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClipping}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource UiSalmon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource UiTextDim}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="OK" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsClipping}" Value="True">
                                                <Setter Property="Text" Value="CLIP" />
                                                <Setter Property="Foreground" Value="{DynamicResource UiSalmon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Main 3-column instrument panel (equal widths) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="Border" x:Key="PanelBorder">
                                <Setter Property="Background" Value="{DynamicResource UiBgDeep}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource UiInput}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Padding" Value="16,12" />
                            </Style>
                        </Grid.Resources>

                        <!-- LEFT: G-Force (G-G diagram with trail) -->
                        <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,6,0" MinHeight="252">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="G-FORCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource UiTextDim}"
                                               VerticalAlignment="Center"
                                               ToolTip="Lateral vs longitudinal grip load. Trail shows the last ~1 second." />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GTotal, StringFormat='{}{0:F2}'}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{DynamicResource UiText}" FontFamily="{DynamicResource UiMono}" VerticalAlignment="Center" />
                                        <TextBlock Text="G" FontSize="11" Foreground="{DynamicResource UiTextDim}" Margin="2,3,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <Canvas Grid.Row="1" x:Name="GCanvas" Width="160" Height="160"
                                        HorizontalAlignment="Center" Margin="0,0,0,8"
                                        ToolTip="Dot = current load. Outer ring = full scale (auto 2G / 3G / 5G). Fading line = recent history.">
                                    <Ellipse Canvas.Left="0" Canvas.Top="0" Width="160" Height="160"
                                             Stroke="{DynamicResource UiInput}" StrokeThickness="1" Fill="{DynamicResource UiC_FF11161C}" />
                                    <Ellipse Canvas.Left="40" Canvas.Top="40" Width="80" Height="80"
                                             Stroke="{DynamicResource UiC_FF2A3138}" StrokeThickness="1" Fill="Transparent" />
                                    <Line X1="80" Y1="8" X2="80" Y2="152" Stroke="{DynamicResource UiInput}" StrokeThickness="1" />
                                    <Line X1="8" Y1="80" X2="152" Y2="80" Stroke="{DynamicResource UiInput}" StrokeThickness="1" />
                                    <TextBlock x:Name="GInnerLabel" Canvas.Left="84" Canvas.Top="42" Text="1G" FontSize="9" Foreground="{DynamicResource UiBorderStrong}" />
                                    <TextBlock x:Name="GOuterLabel" Canvas.Left="84" Canvas.Top="4" Text="2G" FontSize="9" Foreground="{DynamicResource UiBorderStrong}" />
                                    <Polyline x:Name="GTrail" Stroke="{DynamicResource UiC_5579C0FF}" StrokeThickness="2"
                                              StrokeLineJoin="Round" Opacity="0.7" />
                                    <Ellipse x:Name="GForceDot" Width="12" Height="12" Fill="{DynamicResource UiInfo}"
                                             Canvas.Left="74" Canvas.Top="74">
                                        <Ellipse.Effect>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#FF79C0FF" Opacity="0.8" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Canvas>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <TextBlock Text="LAT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource UiTextDim}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LatG, StringFormat='{}{0:+0.00;-0.00;0.00}G'}" FontSize="13" Foreground="{DynamicResource UiInfo}"
                                                   FontFamily="{DynamicResource UiMono}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Ellipse Grid.Column="1" Width="4" Height="4" Fill="{DynamicResource UiBorder}" Margin="6,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="LON" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource UiTextDim}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LongG, StringFormat='{}{0:+0.00;-0.00;0.00}G'}" FontSize="13" Foreground="{DynamicResource UiInfo}"
                                                   FontFamily="{DynamicResource UiMono}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- CENTER: Output torque (real Nm, bidirectional) -->
                        <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="3,0" MinHeight="252"
                                ToolTip="Estimated steering torque at the wheel rim: output × wheel max torque.">
                            <Grid VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="OUTPUT TORQUE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource UiTextDim}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ForceDirectionText}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="{Binding ForceNm, StringFormat='{}{0:F1}'}"
                                               FontSize="44" FontWeight="Black" Foreground="{DynamicResource UiText}" FontFamily="{DynamicResource UiMono}" />
                                    <TextBlock Text="Nm" FontSize="16" Foreground="{DynamicResource UiTextDim}" Margin="6,14,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,8" FontSize="11" Foreground="{DynamicResource UiTextDim}">
                                    <Run Text="{Binding ForcePercent, Mode=OneWay, StringFormat='{}{0:F0}% of '}" /><Run Text="{Binding WheelMaxTorqueText, Mode=OneWay}" />
                                </TextBlock>
                                <Border Grid.Row="3" Background="{DynamicResource UiPanel}" CornerRadius="{DynamicResource UiR4}" Height="22"
                                        Margin="0,0,0,8" BorderThickness="1" BorderBrush="{DynamicResource UiInput}"
                                        ToolTip="Center = zero. Bar grows left or right with pull direction. White tick = recent peak.">
                                    <Canvas x:Name="ForceTrack" Height="20" ClipToBounds="True">
                                        <Rectangle x:Name="ForceCenterTick" Width="2" Height="20" Fill="{DynamicResource UiBorderStrong}" />
                                        <Border x:Name="ForceBarLeft" Height="14" CornerRadius="{DynamicResource UiR2}" Background="{DynamicResource UiAccent}" Visibility="Collapsed" />
                                        <Border x:Name="ForceBarRight" Height="14" CornerRadius="{DynamicResource UiR2}" Background="{DynamicResource UiAccent}" Visibility="Collapsed" />
                                        <Rectangle x:Name="ForcePeakLeft" Width="2" Height="18" Fill="{DynamicResource UiC_FFFFFFFF}" Opacity="0.85" Visibility="Collapsed" />
                                        <Rectangle x:Name="ForcePeakRight" Width="2" Height="18" Fill="{DynamicResource UiC_FFFFFFFF}" Opacity="0.85" Visibility="Collapsed" />
                                    </Canvas>
                                </Border>
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CurrentRawForce, StringFormat='raw {0:F2}'}"
                                               FontSize="10" Foreground="{DynamicResource UiBorderStrong}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                               ToolTip="Raw game torque before shaping. Compare with output above to see how much shaping is applied." />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource UiLime}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsClipping}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource UiSalmon}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OK" />
                                                    <Setter Property="Foreground" Value="{DynamicResource UiTextDim}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsClipping}" Value="True">
                                                            <Setter Property="Text" Value="CLIPPING" />
                                                            <Setter Property="Foreground" Value="{DynamicResource UiSalmon}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- RIGHT: Steering (wheel + lock position) -->
                        <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="6,0,0,0" MinHeight="252">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="STEERING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource UiTextDim}"
                                           HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <Grid Grid.Row="1" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,4"
                                      ToolTip="Live wheel position. Marker shows 12 o'clock.">
                                    <Image x:Name="DashboardWheelImage"
                                           Source="{Binding DashboardWheelImageSource}"
                                           Width="88" Height="88" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <RotateTransform Angle="{Binding SteerAngle}" />
                                        </Image.RenderTransform>
                                    </Image>
                                    <TextBlock Text="▼" Foreground="{DynamicResource UiAccent}" FontSize="13" FontWeight="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-1,0,0"
                                               IsHitTestVisible="False" />
                                </Grid>
                                <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource UiInput}" CornerRadius="{DynamicResource UiR3}" Padding="7,2"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                            Visibility="{Binding IsSteeringLeft, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="L" FontSize="14" FontWeight="Black"
                                                   Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding SteerAbsDegrees, StringFormat='{}{0:F0}'}" FontSize="26" FontWeight="Black"
                                                   Foreground="{DynamicResource UiText}" FontFamily="{DynamicResource UiMono}" VerticalAlignment="Center" />
                                        <TextBlock Text="°" FontSize="18" Foreground="{DynamicResource UiTextDim}" Margin="1,2,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{DynamicResource UiInput}" CornerRadius="{DynamicResource UiR3}" Padding="7,2"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                                            Visibility="{Binding IsSteeringRight, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="R" FontSize="14" FontWeight="Black"
                                                   Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="3" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource UiTextDim}" Margin="0,0,0,6">
                                    <Run Text="{Binding SteerPercentOfLock, Mode=OneWay, StringFormat='{}{0:F0}% of '}" /><Run Text="{Binding SteerLockText, Mode=OneWay}" />
                                </TextBlock>
                                <Border Grid.Row="4" Background="{DynamicResource UiPanel}" CornerRadius="{DynamicResource UiR4}" Height="12"
                                        BorderThickness="1" BorderBrush="{DynamicResource UiInput}"
                                        ToolTip="Wheel position across full lock: center = straight ahead.">
                                    <Canvas x:Name="SteerTrack" Height="10" ClipToBounds="True">
                                        <Rectangle x:Name="SteerCenterTick" Width="2" Height="10" Fill="{DynamicResource UiBorderStrong}" />
                                        <Ellipse x:Name="SteerMarker" Width="10" Height="10" Fill="{DynamicResource UiAccent}" />
                                    </Canvas>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>

                </Grid>
            </Border>

            <!-- ═══ SETUP WIZARD ═══ -->
            <Border x:Name="SetupWizardCard"
                    CornerRadius="{DynamicResource UiR10}" Padding="28,22"
                    BorderThickness="2" BorderBrush="{DynamicResource UiAccent}" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF2D1F00" Offset="0" />
                        <GradientStop Color="#FF1C2128" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                            Background="{DynamicResource UiC_33F0883E}" CornerRadius="{DynamicResource UiR20}" Width="56" Height="56"
                            VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="&#x26A1;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="SETUP WIZARD" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource UiAccent}" Margin="0,0,0,2" />
                        <TextBlock Text="Guided FFB Tuning for AC EVO, RaceRoom, Assetto Corsa &amp; Le Mans Ultimate" FontSize="20" FontWeight="Black" Foreground="{DynamicResource UiText}" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource UiTextDim}" MaxWidth="400">
                            Step-by-step wheel setup · Works with your game running · Tune, test, and save profiles
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                            x:Name="LaunchSetupWizardBtn"
                            Content="&#x26A1;  LAUNCH WIZARD"
                            FontSize="16" FontWeight="Bold" Cursor="Hand"
                            Padding="28,14" VerticalAlignment="Center"
                            ToolTip="Open the guided Setup Wizard overlay"
                            Click="OnLaunchSetupWizard">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource UiAccent}" />
                                <Setter Property="Foreground" Value="{DynamicResource UiCard}" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="{DynamicResource UiR8}" Padding="{TemplateBinding Padding}"
                                                    SnapsToDevicePixels="True">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           FontWeight="{TemplateBinding FontWeight}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UiC_FFE6B800}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource UiC_FFCC8800}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>