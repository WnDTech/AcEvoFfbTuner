<UserControl x:Class="AcEvoFfbTuner.Views.Pages.TestDrivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#FF161B22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,20,24,0">
            <TextBlock Text="TEST DRIVE" FontSize="24" FontWeight="Black" Foreground="#FFF0883E" Margin="0,0,0,4" />
            <TextBlock Text="Sign in with Discord to check your application status and testing tasks, send task-linked diagnostic packs, and climb The Podium — the program's credit wall." FontSize="15" Foreground="#FF8B949E" Margin="0,0,0,16" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,0,24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="MyTestingHost" Grid.Column="0" />

                <StackPanel x:Name="PodiumHost" Grid.Column="2" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
