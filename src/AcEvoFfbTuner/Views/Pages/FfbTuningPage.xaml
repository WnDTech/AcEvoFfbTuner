                            <controls:LabeledSlider Value="{Binding AbsPulseAmplitude, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="ABS Pulse Punch" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="How sharp each pulse is. Gentle cars ~0.10, aggressive ~0.25-0.50."
