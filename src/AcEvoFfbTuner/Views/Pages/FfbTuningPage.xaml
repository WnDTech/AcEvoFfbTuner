                                DefaultValue="{Binding BuiltInDefaults.TyreCondition.MaxBlowoutAmplitude}"
                                SectionColor="{DynamicResource SectionCrash}" Margin="0,0,0,22" />
                        </StackPanel>

                        <!-- WET WEATHER -->
                        <StackPanel x:Name="DtlWetWeather" Visibility="Collapsed">
                            <TextBlock Text="Rain: less road and kerb detail, wider slip curves, hydroplaning." FontSize="13" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <DockPanel Margin="0,6,0,10" Visibility="{Binding IsWetWeatherSectionVisible, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding WetWeatherEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Enable Wet Weather" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Adjusts FFB for wet track conditions." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,10" Visibility="{Binding IsWetWeatherSectionVisible, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding WetWeatherAutoDetect}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Auto-Detect Wet Conditions" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Uses game wetness. Off = use Manual Intensity." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Visibility="{Binding IsWetWeatherSectionVisible, Converter={StaticResource BoolToVis}}" FontSize="13" Foreground="{DynamicResource UiSky}" Margin="0,4,0,10">
                                <Run Text="Current wetness (live): " /><Run Text="{Binding WetWeatherCurrentFactor, StringFormat='{}{0:P0}'}" FontSize="16" FontWeight="Bold" />
                            </TextBlock>
                            <controls:LabeledSlider Value="{Binding WetWeatherRoadVibSuppression, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Road Detail Reduction" StringFormat="{}{0:P0}" LabelAbove="True"
                                Description="How much road vibration is removed in the wet."
                                LowLabel="Full road feel" HighLabel="Road feel removed"
                                DefaultValue="{Binding BuiltInDefaults.WetWeather.RoadVibSuppression}"
                                SectionColor="{DynamicResource SectionWetWeather}" Visibility="{Binding IsWetWeatherSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding WetWeatherCurbSuppression, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Kerb Reduction" StringFormat="{}{0:P0}" LabelAbove="True"
                                Description="How much kerb vibration is removed in the wet."
                                LowLabel="Full kerbs" HighLabel="Kerbs removed"
                                DefaultValue="{Binding BuiltInDefaults.WetWeather.CurbSuppression}"
                                SectionColor="{DynamicResource SectionWetWeather}" Visibility="{Binding IsWetWeatherSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding WetWeatherScrubSuppression, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Scrub Reduction" StringFormat="{}{0:P0}" LabelAbove="True"
                                Description="How much tyre scrub texture is removed in the wet."
                                LowLabel="Full scrub" HighLabel="Scrub removed"
                                DefaultValue="{Binding BuiltInDefaults.WetWeather.ScrubSuppression}"
                                SectionColor="{DynamicResource SectionWetWeather}" Visibility="{Binding IsWetWeatherSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Detailed wet weather" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" Visibility="{Binding IsWetWeatherSectionVisible, Converter={StaticResource BoolToVis}}" />
                            <controls:LabeledSlider Value="{Binding WetWeatherManualIntensity, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Manual Intensity" StringFormat="{}{0:P0}" LabelAbove="True"
                                Description="Wetness when auto-detect is off."
                                LowLabel="Dry" HighLabel="Heavy rain"
                                DefaultValue="{Binding BuiltInDefaults.WetWeather.ManualIntensity}"
                                SectionColor="{DynamicResource SectionWetWeather}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding WetWeatherPeakSlipAngleMultiplier, Mode=TwoWay}" Minimum="1" Maximum="3" TickFrequency="0.05"
                                Label="Wet Slip Curve Width" StringFormat="{}{0:F2}x" LabelAbove="True"
                                Description="Peak grip arrives at bigger slip angles in the wet."
                                LowLabel="Dry curve" HighLabel="Wide wet curve"
                                DefaultValue="{Binding BuiltInDefaults.WetWeather.PeakSlipAngleMultiplier}"
                                SectionColor="{DynamicResource SectionWetWeather}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding WetWeatherDampingReduction, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Damping Reduction" StringFormat="{}{0:P0}" LabelAbove="True"
                                Description="Less speed damping in the wet."
                                LowLabel="Same as dry" HighLabel="Much lighter"
                                DefaultValue="{Binding BuiltInDefaults.WetWeather.DampingReduction}"
                                SectionColor="{DynamicResource SectionWetWeather}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding WetWeatherNoiseFloorSuppression, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Noise Floor Boost" StringFormat="{}{0:P0}" LabelAbove="True"
                                Description="Masks fine detail lost on a wet surface."
                                LowLabel="Keep detail" HighLabel="Mask detail"
                                DefaultValue="{Binding BuiltInDefaults.WetWeather.NoiseFloorSuppression}"
                                SectionColor="{DynamicResource SectionWetWeather}" Margin="0,0,0,22" />
                            <DockPanel Margin="0,6,0,10">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding WetWeatherHydroplaningEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Enable Hydroplaning Feel" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Steering goes light at high speed in standing water." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <controls:LabeledSlider Value="{Binding WetWeatherHydroplaningSpeedThreshold, Mode=TwoWay}" Minimum="60" Maximum="250" TickFrequency="5"
                                Label="Hydroplaning From" StringFormat="{}{0:F0} km/h" LabelAbove="True"
                                Description="Speed above which hydroplaning builds."
                                LowLabel="Early onset" HighLabel="Only very fast"
                                DefaultValue="{Binding BuiltInDefaults.WetWeather.HydroplaningSpeedThreshold}"
                                SectionColor="{DynamicResource SectionWetWeather}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding WetWeatherHydroplaningMaxAttenuation, Mode=TwoWay}" Minimum="0" Maximum="0.8" TickFrequency="0.01"
                                Label="Hydroplaning Lightness" StringFormat="{}{0:P0}" LabelAbove="True"
                                Description="Max force loss while hydroplaning."
                                LowLabel="Subtle" HighLabel="Severe"
                                DefaultValue="{Binding BuiltInDefaults.WetWeather.HydroplaningMaxAttenuation}"
                                SectionColor="{DynamicResource SectionWetWeather}" Margin="0,0,0,22" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>