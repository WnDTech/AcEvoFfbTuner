                            <controls:LabeledSlider Value="{Binding TcWheelGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.05"
                                Label="TC Feel Strength" StringFormat="{}{0:F2}" LabelAbove="True"
