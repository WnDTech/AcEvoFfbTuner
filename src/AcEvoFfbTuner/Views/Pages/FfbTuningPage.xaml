                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="Traction control" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <DockPanel Margin="0,6,0,10">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding TcWheelEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
