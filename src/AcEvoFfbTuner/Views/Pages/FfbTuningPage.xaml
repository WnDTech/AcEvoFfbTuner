                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding UseMixerSuspRoad}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Suspension Road Layer on (LMU)" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Off = only the built-in kerb/road envelopes." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
