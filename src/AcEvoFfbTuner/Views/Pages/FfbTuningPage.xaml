                            <controls:LabeledSlider Value="{Binding RoadTextureDecayMs, Mode=TwoWay}" Minimum="3" Maximum="80" TickFrequency="1"
                                Label="Knock Sharpness (LMU)" StringFormat="{}{0:F0} ms" LabelAbove="True"
                                Description="How long each knock lasts. 15 = crisp; 40+ feels lazy."
                                LowLabel="Sharp, rigid hits" HighLabel="Soft, rounded rumble"
                                DefaultValue="15"
                                SectionColor="{DynamicResource SectionVibration}" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Road surface &amp; bumps" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <controls:LabeledSlider Value="{Binding RoadGain, Mode=TwoWay}" Minimum="0" Maximum="5" TickFrequency="0.05"
                                Label="Road Vibration" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Road surface vibration."
                                LowLabel="Smooth road" HighLabel="Rough road"
                                DefaultValue="{Binding BuiltInDefaults.Vibrations.RoadGain}"
                                SectionColor="{DynamicResource SectionVibration}" Visibility="{Binding IsVibrationSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding SuspensionRoadGain, Mode=TwoWay}" Minimum="0" Maximum="5" TickFrequency="0.05"
                                Label="Suspension Road Texture" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Road texture from suspension movement, mixed into the main force."
                                LowLabel="Smooth" HighLabel="Bumpy"
                                DefaultValue="{Binding BuiltInDefaults.Vibrations.SuspensionRoadGain}"
                                SectionColor="{DynamicResource SectionVibration}" Visibility="{Binding IsVibrationSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding RoadCompressionGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.05"
                                Label="Road Compression (RaceRoom)" StringFormat="{}{0:F2}" LabelAbove="True"
