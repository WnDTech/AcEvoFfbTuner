                                DefaultValue="{Binding BuiltInDefaults.StaticFriction.OutputSmoothAlpha}"
                                SectionColor="{DynamicResource SectionDamping}" Margin="0,0,0,22" />
                            <TextBlock Text="Stationary detail (tyre twist texture)" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <controls:LabeledSlider Value="{Binding StaticFrictionBreakoutGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
