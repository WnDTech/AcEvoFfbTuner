                        <!-- CRASHES & TYRE DAMAGE -->
                        <StackPanel x:Name="DtlCrashes" Visibility="Collapsed">
                            <TextBlock Text="Wall and car impacts, blowouts, pressure loss and damage pull." FontSize="13" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="Crash impacts" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" Visibility="{Binding IsCrashSectionVisible, Converter={StaticResource BoolToVis}}" />
                            <DockPanel Margin="0,6,0,10" Visibility="{Binding IsCrashSectionVisible, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding CrashEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Enable Crash Forces" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Directional kick on wall/car impacts, detected from G-force spikes." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <controls:LabeledSlider Value="{Binding CrashImpactGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Impact Kick" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="0.3 subtle nudge, 0.6 noticeable, 1.0 full."
                                LowLabel="Nudge" HighLabel="Full kick"
                                DefaultValue="{Binding BuiltInDefaults.Crash.ImpactGain}"
                                SectionColor="{DynamicResource SectionCrash}" Visibility="{Binding IsCrashSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding CrashSafetyClamp, Mode=TwoWay}" Minimum="0.1" Maximum="1.0" TickFrequency="0.01"
                                Label="Safety Clamp" StringFormat="{}{0:P0}" LabelAbove="True"
                                Description="Hard cap on kick size. Has no effect if it is above Impact Kick."
                                LowLabel="Tight cap (safer)" HighLabel="Loose cap"
                                DefaultValue="{Binding BuiltInDefaults.Crash.SafetyClamp}"
                                SectionColor="{DynamicResource SectionCrash}" Visibility="{Binding IsCrashSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding CrashTriggerThresholdG, Mode=TwoWay}" Minimum="1" Maximum="10" TickFrequency="0.1"
                                Label="Trigger Threshold" StringFormat="{}{0:F1} G" LabelAbove="True"
                                Description="G spike needed to count as a crash. 3 G typical contact, 5 G heavy."
                                LowLabel="Triggers on light taps" HighLabel="Only big hits"
                                DefaultValue="{Binding BuiltInDefaults.Crash.TriggerThresholdG}"
                                SectionColor="{DynamicResource SectionCrash}" Visibility="{Binding IsCrashSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding CrashDecayRate, Mode=TwoWay}" Minimum="0.5" Maximum="0.98" TickFrequency="0.01"
                                Label="Kick Length" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="How quickly the kick fades. 0.88 quick punch, 0.95 longer shake."
                                LowLabel="Short punch" HighLabel="Long shake"
                                DefaultValue="{Binding BuiltInDefaults.Crash.DecayRate}"
                                SectionColor="{DynamicResource SectionCrash}" Visibility="{Binding IsCrashSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Safety override (hazard mode)" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" Visibility="{Binding IsCrashSectionVisible, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{DynamicResource UiC_33FF4444}" CornerRadius="{DynamicResource UiR6}" Padding="12,10" Margin="0,4,0,8">
                                <StackPanel>
                                    <TextBlock Text="&#x26A0; HAZARD WARNING" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource UiC_FFFF4444}" Margin="0,0,0,4" />
                                    <TextBlock Text="Removing the safety clamp allows crash forces up to 100% of wheel output. This can generate sudden, powerful torque spikes that may cause injury or damage equipment." FontSize="13" Foreground="{DynamicResource UiC_FFB0B0B0}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <DockPanel Margin="0,6,0,10">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding CrashSafetyOverride}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Remove Safety Clamp" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Crash forces then limited only by Output Gain and Max Force Limit." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <controls:LabeledSlider Value="{Binding CrashMinSpeedKmh, Mode=TwoWay}" Minimum="0" Maximum="50" TickFrequency="1"
                                Label="Min Speed" StringFormat="{}{0:F0} km/h" LabelAbove="True"
                                Description="No crash forces below this speed (stops pit-lane false triggers)."
                                LowLabel="Always active" HighLabel="Only at speed"
                                DefaultValue="{Binding BuiltInDefaults.Crash.MinSpeedKmh}"
                                SectionColor="{DynamicResource SectionCrash}" Margin="0,0,0,22" />
                            <TextBlock Text="Tyre condition" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" Visibility="{Binding IsCrashSectionVisible, Converter={StaticResource BoolToVis}}" />
                            <DockPanel Margin="0,6,0,10" Visibility="{Binding IsCrashSectionVisible, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding TyreConditionEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Enable Tyre Condition Effects" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Blowout shake, slow pressure-loss rumble and uneven-damage pull." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <controls:LabeledSlider Value="{Binding TyreConditionBlowoutGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Blowout Shake" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Shake when a tyre bursts."
                                LowLabel="Off" HighLabel="Violent"
                                DefaultValue="{Binding BuiltInDefaults.TyreCondition.BlowoutVibrationGain}"
                                SectionColor="{DynamicResource SectionCrash}" Visibility="{Binding IsCrashSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding TyreConditionPressureLossGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Pressure Loss Rumble" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Low rumble as pressure drops."
