                            <controls:LabeledSlider Value="{Binding TyreConditionBlowoutThreshold, Mode=TwoWay}" Minimum="0.2" Maximum="0.7" TickFrequency="0.01"
                                Label="Blowout Pressure" StringFormat="{}{0:P0}" LabelAbove="True"
                                Description="Pressure (vs normal) below which a blowout can occur."
