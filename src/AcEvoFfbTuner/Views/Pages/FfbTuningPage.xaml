<UserControl x:Class="AcEvoFfbTuner.Views.Pages.FfbTuningPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AcEvoFfbTuner.Controls"
             xmlns:converters="clr-namespace:AcEvoFfbTuner.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        <converters:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ PROFILE SUMMARY BAR ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource BgCard}" Padding="24,10"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CAR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <!-- One text: the placeholder used to stay visible under the car name and overlap it. -->
                <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"
                           MaxWidth="320" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding DetectedCarDisplayName}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding DetectedCarDisplayName}" />
                            <Setter Property="Foreground" Value="{DynamicResource UiInfo}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DetectedCarDisplayName}" Value="">
                                    <Setter Property="Text" Value="No car detected" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DetectedCarDisplayName}" Value="{x:Null}">
                                    <Setter Property="Text" Value="No car detected" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,2,24,2" />

                <TextBlock Text="WHEEL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                            <Setter Property="Text" Value="{Binding DeviceName, FallbackValue='No device', TargetNullValue='No device'}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeviceConnected}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource UiLime}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,2,24,2" />

                <TextBlock Text="PROFILE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue='No profile', TargetNullValue='No profile'}"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,24,0" />

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,2,24,2" />

                <TextBlock Text="PEAK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding OutputGainNmText}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center" />

                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="0,2,24,2" />

                <TextBlock Text="MIX" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedMixMode}" Value="Replace">
                                    <Setter Property="Foreground" Value="{DynamicResource UiInfo}" />
                                    <Setter Property="Text" Value="Replace" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedMixMode}" Value="Overlay">
                                    <Setter Property="Foreground" Value="{DynamicResource UiTeal}" />
                                    <Setter Property="Text" Value="Overlay" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ═══ MAIN CONTENT: Section Nav (left) + Detail Panel (right) ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" MinWidth="320" MaxWidth="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ LEFT: COMPACT SECTION NAV (click a section → sliders on the right) ═══ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,16,12,20">
                <StackPanel>

                    <!-- ═══ FILTER BAR: current game + search + section counter ═══ -->
                    <Border Background="{DynamicResource BgPanel}" CornerRadius="{DynamicResource UiR6}"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                            Padding="14,10" Margin="0,0,0,16">
                        <DockPanel>
                            <Border DockPanel.Dock="Left"
                                    Background="{DynamicResource UiAccentDim}" BorderBrush="{DynamicResource UiC_66F0883E}" BorderThickness="1"
                                    CornerRadius="{DynamicResource UiR12}" Padding="10,4" Margin="0,0,14,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource UiAccent}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding GameDisplayName}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource UiAccent}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="FilterCounter" DockPanel.Dock="Right"
                                       Text="" FontSize="12" Foreground="{DynamicResource TextDimBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                            <TextBox x:Name="SearchBox" FontSize="13" Padding="6,4" MinHeight="26"
                                     Background="{DynamicResource BgCard}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     CaretBrush="{DynamicResource TextBrush}"
                                     SelectionBrush="#66F0883E"
                                     TextChanged="SearchBox_TextChanged"
                                     ToolTip="Filter sections by title (e.g. 'flatspot', 'curb', 'wet')"
                                     VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <controls:SectionCard Title="OVERALL STRENGTH &amp; WHEEL" Tag="Output"
                                          SectionBrush="{DynamicResource SectionOutput}"
                                          Selectable="True" IsSelected="True" ToolTip="How strong the wheel is overall, clipping, your wheelbase, end-stops and force direction.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="How strong the wheel is overall, clipping, your wheelbase, end-stops and force direction." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                    <controls:SectionCard Title="STEERING WEIGHT &amp; CENTRE" Tag="Steering"
                                          SectionBrush="{DynamicResource SectionTyreForces}"
                                          Selectable="True" ToolTip="How heavy the steering is, how it feels around straight-ahead, and straight-line stability.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="How heavy the steering is, how it feels around straight-ahead, and straight-line stability." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                    <controls:SectionCard Title="CORNERING &amp; FRONT GRIP" Tag="Grip"
                                          SectionBrush="{DynamicResource SectionTyreSlip}"
                                          Selectable="True" ToolTip="Feeling the front tyres load up, reach the limit and start to understeer.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="Feeling the front tyres load up, reach the limit and start to understeer." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                    <controls:SectionCard Title="OVERSTEER &amp; SLIDES" Tag="Oversteer"
                                          SectionBrush="{DynamicResource SectionGripFeel}"
                                          Selectable="True" ToolTip="The rear stepping out, slide warnings, and how the wheel self-steers into countersteer.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="The rear stepping out, slide warnings, and how the wheel self-steers into countersteer." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                    <controls:SectionCard Title="BRAKING &amp; ACCELERATION" Tag="Braking"
                                          SectionBrush="{DynamicResource SectionCrash}"
                                          Selectable="True" ToolTip="Steering weight under braking, lock-ups, ABS, wheelspin and traction control.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="Steering weight under braking, lock-ups, ABS, wheelspin and traction control." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                    <controls:SectionCard Title="KERBS, ROAD &amp; OFF-TRACK" Tag="Surfaces"
                                          SectionBrush="{DynamicResource SectionVibration}"
                                          Selectable="True" ToolTip="Rumble strips, bumps, road texture, grass, gravel and dirt.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="Rumble strips, bumps, road texture, grass, gravel and dirt." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                    <controls:SectionCard Title="ENGINE &amp; CHASSIS RUMBLE" Tag="Engine"
                                          SectionBrush="{DynamicResource SectionLfe}"
                                          Selectable="True" ToolTip="Low-frequency rumble from engine and suspension (LFE), and gear shifts.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="Low-frequency rumble from engine and suspension (LFE), and gear shifts." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                    <controls:SectionCard Title="SMOOTHNESS &amp; DAMPING" Tag="Smoothness"
                                          SectionBrush="{DynamicResource SectionDamping}"
                                          Selectable="True" ToolTip="Grainy, notchy, oscillating or twitchy wheel? Resistance and filtering live here.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="Grainy, notchy, oscillating or twitchy wheel? Resistance and filtering live here." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                    <controls:SectionCard Title="PARKED &amp; LOW SPEED" Tag="Parked"
                                          SectionBrush="{DynamicResource SectionDamping}"
                                          Selectable="True" ToolTip="Steering resistance when stopped or crawling (pits, grid). Fades out by ~1.2 km/h. All games.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="Steering resistance when stopped or crawling (pits, grid). Fades out by ~1.2 km/h. All games." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                    <controls:SectionCard Title="CRASHES &amp; TYRE DAMAGE" Tag="Crashes"
                                          SectionBrush="{DynamicResource SectionCrash}"
                                          Selectable="True" ToolTip="Wall and car impacts, blowouts, pressure loss and damage pull.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="Wall and car impacts, blowouts, pressure loss and damage pull." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                    <controls:SectionCard Title="WET WEATHER" Tag="WetWeather"
                                          SectionBrush="{DynamicResource SectionWetWeather}"
                                          Selectable="True" ToolTip="Rain: less road and kerb detail, wider slip curves, hydroplaning.">
                        <controls:SectionCard.SummaryContent>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Text="Rain: less road and kerb detail, wider slip curves, hydroplaning." />
                        </controls:SectionCard.SummaryContent>
                    </controls:SectionCard>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ RIGHT: SELECTED SECTION DETAIL (sliders for the clicked section) ═══ -->
            <Border Grid.Column="1" Margin="0,16,24,20"
                    Background="{DynamicResource BgPanel}"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                    CornerRadius="{DynamicResource UiR10}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,20">
                    <StackPanel>
                        <!-- Section header -->
                        <DockPanel>
                            <Border x:Name="DetailHeaderAccent" DockPanel.Dock="Left" Width="4"
                                    CornerRadius="{DynamicResource UiR2}" Background="{DynamicResource SectionOutput}"
                                    VerticalAlignment="Stretch" />
                            <TextBlock x:Name="DetailHeader" Text="OVERALL STRENGTH &amp; WHEEL" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SectionOutput}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,16" />

                        <!-- OVERALL STRENGTH & WHEEL -->
                        <StackPanel x:Name="DtlOutput">
                            <TextBlock Text="How strong the wheel is overall, clipping, your wheelbase, end-stops and force direction." FontSize="13" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="Start here. Set overall strength first, then shape the feel in the sections below." FontSize="13" Foreground="{DynamicResource UiTextDim}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <controls:LabeledSlider Value="{Binding OutputGain, Mode=TwoWay}" Minimum="0" Maximum="20" TickFrequency="0.001"
                                Label="Output Gain" StringFormat="{}{0:F3}" LabelAbove="True"
                                DisplayText="{Binding OutputGainNmText}" ValueWidth="110"
                                Description="Final multiplier for every force. Shown with the peak torque your wheelbase can deliver at the current limit."
                                LowLabel="Lighter wheel" HighLabel="Heavier wheel"
                                DefaultValue="{Binding BuiltInDefaults.OutputGain}"
                                SectionColor="{DynamicResource SectionOutput}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding MaxForceLimit, Mode=TwoWay}" Minimum="0.1" Maximum="1.0" TickFrequency="0.01"
                                Label="Max Force Limit (clipping knee)" StringFormat="{}{0:F2}" LabelAbove="True"
                                DisplayText="{Binding MaxForceLimitNmText}" ValueWidth="110"
                                Description="Forces above this are rounded off smoothly instead of hard-clipping. The real ceiling is halfway between this and 100% (0.80 → peak 90%). On ACC, Force Gain is applied after this limit."
                                LowLabel="Compresses earlier, more headroom" HighLabel="Compresses later, more peak force"
                                DefaultValue="{Binding BuiltInDefaults.SoftClipThreshold}"
                                SectionColor="{DynamicResource SectionOutput}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding ForceSensitivity, Mode=TwoWay}" Minimum="1" Maximum="1000" TickFrequency="1"
                                Label="Sensitivity (input divisor)" StringFormat="{}{0:F0}" LabelAbove="True"
                                IsLogarithmic="True"
                                Description="First gain stage. This divides the incoming force, so a LOWER number gives a STRONGER wheel. 1000 = neutral."
                                LowLabel="Stronger (more amplified)" HighLabel="Weaker (neutral at 1000)"
                                DefaultValue="{Binding BuiltInDefaults.NormalizationScale}"
                                SectionColor="{DynamicResource SectionOutput}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding CoreForceMultiplier, Mode=TwoWay}" Minimum="0" Maximum="4" TickFrequency="0.05"
                                Label="Main Force Gain" StringFormat="{}{0:F2}x" LabelAbove="True"
                                Description="Scales the game's steering-column torque (RaceRoom SteeringForce, LMU shaft torque, AC1 FFB). 1.0 = game force as-is."
                                LowLabel="Lighter" HighLabel="Heavier"
                                SectionColor="{DynamicResource SectionOutput}" Visibility="{Binding IsCoreForceVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding ForceScale, Mode=TwoWay}" Minimum="0.1" Maximum="200" TickFrequency="0.1"
                                Label="LMU Force Scale" StringFormat="{}{0:F1}" LabelAbove="True"
                                IsLogarithmic="True"
                                Description="LMU only. Normalises LMU's shaft torque. HIGHER = HEAVIER here (it is used as 120 / value). Values of 120 or more all behave the same."
                                LowLabel="Lighter" HighLabel="Heavier"
                                SectionColor="{DynamicResource SectionOutput}" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding ForceGain, Mode=TwoWay}" Minimum="0" Maximum="5" TickFrequency="0.05"
                                Label="Force Gain (ACC)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="ACC only. Multiplies the whole output AFTER the force limiter, so high values hard-clip at the wheel."
                                LowLabel="Lighter" HighLabel="Heavier (clips above ~1 output)"
                                DefaultValue="{Binding BuiltInDefaults.Slip.ForceGain}"
                                SectionColor="{DynamicResource SectionOutput}" Visibility="{Binding IsAssettoCorsaCompetizione, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Your wheelbase" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <controls:LabeledSlider Value="{Binding WheelMaxTorqueNm, Mode=TwoWay}" Minimum="1" Maximum="25" TickFrequency="0.5"
                                Label="Wheelbase Max Torque" StringFormat="{}{0:F1} Nm" LabelAbove="True"
                                Description="Only used to show Nm readouts. 5.5 = Moza R5, 9 = R9, 12 = R12, 15 = R15."
                                LowLabel="" HighLabel=""
                                DefaultValue="{Binding BuiltInDefaults.WheelMaxTorqueNm}"
                                SectionColor="{DynamicResource SectionOutput}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding SteeringLockDegrees, Mode=TwoWay}" Minimum="180" Maximum="1080" TickFrequency="10"
                                Label="Steering Rotation" StringFormat="{}{0:F0}°" LabelAbove="True"
                                Description="Your wheel's total rotation, lock to lock. Match it to the game/car."
                                LowLabel="Quicker steering" HighLabel="Slower steering"
                                DefaultValue="{Binding BuiltInDefaults.SteeringLockDegrees}"
                                SectionColor="{DynamicResource SectionOutput}" Margin="0,0,0,22" />
                            <DockPanel Margin="0,6,0,10">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding SoftLockEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Soft Lock (end-stop wall)" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Pushes back progressively past 92% of steering lock so you feel the end of the rack." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <controls:LabeledSlider Value="{Binding SoftLockStrength, Mode=TwoWay}" Minimum="0" Maximum="1.5" TickFrequency="0.05"
                                Label="Soft Lock Strength" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="0.5 = gentle cushion, 1.0 = firm end-stop. Above ~1.2 it is already at full force."
                                LowLabel="Soft cushion" HighLabel="Hard wall"
                                DefaultValue="{Binding BuiltInDefaults.SoftLock.Strength}"
                                SectionColor="{DynamicResource SectionOutput}" Margin="0,0,0,22" />
                            <TextBlock Text="Auto-Gain (make every car feel similar)" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" />
                            <DockPanel Margin="0,6,0,10" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding AutoGainEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Enable Auto-Gain" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Automatically compensates for cars with very strong or very weak FFB so they land at a similar level." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <controls:LabeledSlider Value="{Binding AutoGainScale, Mode=TwoWay}" Minimum="0.1" Maximum="5" TickFrequency="0.01"
                                Label="Auto-Gain Target" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Target level Auto-Gain aims for. Only used while Auto-Gain is on."
                                LowLabel="Lighter target" HighLabel="Heavier target"
                                DefaultValue="{Binding BuiltInDefaults.AutoGain.Scale}"
                                SectionColor="{DynamicResource SectionOutput}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Mix mode, response curve &amp; direction fixes" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <TextBlock Text="Mix Mode" Style="{StaticResource SubSectionHeader}" Margin="0,4,0,4" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}">
                                <RadioButton Content="Replace (app builds the force)" GroupName="MixMode" Margin="0,0,20,0" FontSize="14">
                                    <RadioButton.IsChecked>
                                        <Binding Path="SelectedMixMode" Converter="{StaticResource EnumToBoolConverter}" ConverterParameter="Replace" Mode="TwoWay" />
                                    </RadioButton.IsChecked>
                                </RadioButton>
                                <RadioButton Content="Overlay (on top of game FFB)" GroupName="MixMode" FontSize="14">
                                    <RadioButton.IsChecked>
                                        <Binding Path="SelectedMixMode" Converter="{StaticResource EnumToBoolConverter}" ConverterParameter="Overlay" Mode="TwoWay" />
                                    </RadioButton.IsChecked>
                                </RadioButton>
                            </StackPanel>
                            <TextBlock Text="Response Curve" Style="{StaticResource SubSectionHeader}" Margin="0,10,0,2" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}">
                                <ComboBox SelectedIndex="{Binding SelectedLutPresetIndex}" Width="160" FontSize="15" Padding="6,4">
                                    <ComboBoxItem Content="Linear" />
                                    <ComboBoxItem Content="Soft Center" />
                                    <ComboBoxItem Content="Progressive" />
                                    <ComboBoxItem Content="Dead Zone" />
                                </ComboBox>
                                <Button Content="Apply" Command="{Binding ApplyLutPresetCommand}" Margin="12,0,0,0" Padding="20,6" ToolTip="Apply the selected response curve preset" />
                            </StackPanel>
                            <DockPanel Margin="0,6,0,10">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding SignCorrectionEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Sign Correction" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Keeps self-centering forces pointing toward centre near straight-ahead." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,10">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding ForceInvertEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Invert Force" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Flips ALL forces at the wheel. Use only if the wheel pushes away from centre." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,10" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding FyInverted}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Invert Lateral Force" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Fixes a left/right pull under braking caused by the lateral-force sign." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <!-- STEERING WEIGHT & CENTRE -->
                        <StackPanel x:Name="DtlSteering" Visibility="Collapsed">
                            <TextBlock Text="How heavy the steering is, how it feels around straight-ahead, and straight-line stability." FontSize="13" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="Steering weight (self-aligning)" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" />
                            <controls:LabeledSlider Value="{Binding MzFrontGain, Mode=TwoWay}" Minimum="-2" Maximum="2" TickFrequency="0.01"
                                Label="Self-Aligning Torque (Mz)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="The main steering weight: the tyres pulling the wheel back to centre. Each channel saturates around 1.0. Tick the box to switch it on/off."
                                LowLabel="Lighter, less centring" HighLabel="Heavier, stronger centring"
                                ShowCheckBox="True" IsChecked="{Binding MzFrontEnabled}"
                                DefaultValue="{Binding BuiltInDefaults.MzFront.Gain}"
                                SectionColor="{DynamicResource SectionTyreForces}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding MzScale, Mode=TwoWay}" Minimum="1" Maximum="300" TickFrequency="0.5"
                                Label="Mz Scale (divisor)" StringFormat="{}{0:F1}" LabelAbove="True"
                                IsLogarithmic="True"
                                Description="Divides the raw Mz from the game. LOWER = HEAVIER. Below the car's own peak it stops mattering because auto-normalisation takes over. Forced to 5 on ACC."
                                LowLabel="Heavier" HighLabel="Lighter"
                                DefaultValue="{Binding BuiltInDefaults.MzScale}"
                                SectionColor="{DynamicResource SectionTyreForces}" Visibility="{Binding IsAcEvo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding FyFrontGain, Mode=TwoWay}" Minimum="-2" Maximum="2" TickFrequency="0.01"
                                Label="Cornering Load (Fy)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Adds the weight of the car leaning on the front tyres in corners. Faded out near centre (see Centre Blend)."
                                LowLabel="Less cornering weight" HighLabel="More cornering weight"
                                ShowCheckBox="True" IsChecked="{Binding FyFrontEnabled}"
                                DefaultValue="{Binding BuiltInDefaults.FyFront.Gain}"
                                SectionColor="{DynamicResource SectionTyreForces}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding FyScale, Mode=TwoWay}" Minimum="100" Maximum="20000" TickFrequency="100"
                                Label="Fy Scale (divisor)" StringFormat="{}{0:F0}" LabelAbove="True"
                                IsLogarithmic="True"
                                Description="Divides raw lateral force. LOWER = HEAVIER cornering load."
                                LowLabel="Heavier" HighLabel="Lighter"
                                DefaultValue="{Binding BuiltInDefaults.FyScale}"
                                SectionColor="{DynamicResource SectionTyreForces}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding WheelLoadWeighting, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Wheel Load Weighting" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="How much tyre load shapes the force. 0 = simple average, 1 = scales with how loaded each axle is (heavier under braking/downforce)."
                                LowLabel="Even, consistent" HighLabel="Follows load transfer"
                                DefaultValue="{Binding BuiltInDefaults.WheelLoadWeighting}"
                                SectionColor="{DynamicResource SectionTyreForces}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <DockPanel Margin="0,6,0,10" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding UseNativeTorqueSign}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Native Torque Direction (LMU)" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="On = force follows LMU's own torque direction (self-steers into countersteer, real road/camber feel). Off = legacy always-pull-to-centre. Leave on." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,6,0,10" Visibility="{Binding IsRaceroom, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding SteeringAngleCompensationEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Steering Angle Comp (RaceRoom)" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="On = legacy +15% high-steer boost. Off = feel the Historic Update's own SAT curve (recommended)." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10" Visibility="{Binding IsRaceroom, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding UseNativeTorqueSign}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Game Torque Direction (RaceRoom)" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="On = use the game's own torque direction (real self-steer, camber and crown through centre). Off = legacy: force always points back toward centre (uses Core Floor + Direction Blend)." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="Around centre" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <controls:LabeledSlider Value="{Binding CenterKneePower, Mode=TwoWay}" Minimum="1" Maximum="3" TickFrequency="0.01"
                                Label="Centre Softness (knee)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Shapes how force builds from straight-ahead. 1.0 = linear; higher = lighter at centre with a sharper build-up."
                                LowLabel="Linear, direct" HighLabel="Soft centre, progressive"
                                DefaultValue="{Binding BuiltInDefaults.Advanced.CenterKneePower}"
                                SectionColor="{DynamicResource SectionTyreForces}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding CenterBlendDegrees, Mode=TwoWay}" Minimum="0" Maximum="10" TickFrequency="0.1"
                                Label="Centre Blend" StringFormat="{}{0:F1}°" LabelAbove="True"
                                Description="Steering angle over which cornering load (Fy) fades in. Stops Fy buzz on the straights."
                                LowLabel="Fy right from centre" HighLabel="Fy only once turned in"
                                DefaultValue="{Binding BuiltInDefaults.Advanced.CenterBlendDegrees}"
                                SectionColor="{DynamicResource SectionTyreForces}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding CenterSharpnessDegrees, Mode=TwoWay}" Minimum="0" Maximum="10" TickFrequency="0.1"
                                Label="Centre Sharpness" StringFormat="{}{0:F1}°" LabelAbove="True"
                                Description="Steering angle at which centring reaches full strength. 0 = crispest. (RaceRoom reports road-wheel angle, so values act stronger there.)"
                                LowLabel="Crisp, notchy centre" HighLabel="Soft, vague centre"
                                DefaultValue="{Binding BuiltInDefaults.Advanced.CenterSharpnessDegrees}"
                                SectionColor="{DynamicResource SectionTyreForces}" Visibility="{Binding IsColumnForceGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Straight-line stability" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <DockPanel Margin="0,6,0,10">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding GyroEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Gyro Stabilizer" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Torque that opposes the car's yaw rate. Calms high-speed nervousness and wander." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <controls:LabeledSlider Value="{Binding GyroGain, Mode=TwoWay}" Minimum="-2" Maximum="2" TickFrequency="0.05"
                                Label="Gyro Gain" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Start around 0.3. Output is capped, so above ~1 there is little change. Flip negative if it feels wrong in your game."
                                LowLabel="Less / reversed" HighLabel="More stable"
                                DefaultValue="{Binding BuiltInDefaults.Gyro.Gain}"
                                SectionColor="{DynamicResource SectionTyreForces}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding StraightGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.05"
                                Label="Straight Stability" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Extra damping near centre above 80 km/h. Does not touch corner feel."
                                LowLabel="Off" HighLabel="Planted straights"
                                DefaultValue="0"
                                SectionColor="{DynamicResource SectionTyreForces}" Visibility="{Binding IsDampingSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding CenterDampFloor, Mode=TwoWay}" Minimum="0" Maximum="0.1" TickFrequency="0.005"
                                Label="Centre Damping Floor" StringFormat="{}{0:F3}" LabelAbove="True"
                                Description="Minimum damping right at centre. 0 = legacy. LMU profiles use 0.03 for on-centre stability."
                                LowLabel="Free on centre" HighLabel="Settled on centre"
                                SectionColor="{DynamicResource SectionTyreForces}" Visibility="{Binding IsDampingSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                        </StackPanel>

                        <!-- CORNERING & FRONT GRIP -->
                        <StackPanel x:Name="DtlGrip" Visibility="Collapsed">
                            <TextBlock Text="Feeling the front tyres load up, reach the limit and start to understeer." FontSize="13" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="Grip limit / understeer" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <controls:LabeledSlider Value="{Binding SlipAngleGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                Label="Slip Angle Feel" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Adds force as the tyres slide sideways. Lets you feel the limit approaching."
                                LowLabel="Subtle" HighLabel="Pronounced"
                                DefaultValue="{Binding BuiltInDefaults.Slip.SlipAngleGain}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsSlipEnhancerVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding SlipAngleShapeGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                Label="Peak Grip Bump" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Adds a small rise in force just before peak grip, then a drop-off past it — the classic &quot;going light&quot; understeer cue."
                                LowLabel="Linear, no bump" HighLabel="Clear peak and drop-off"
                                DefaultValue="{Binding BuiltInDefaults.Slip.SlipAngleShapeGain}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsSlipEnhancerVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding SlipThreshold, Mode=TwoWay}" Minimum="0" Maximum="0.3" TickFrequency="0.005"
                                Label="Slip Trigger Point" StringFormat="{}{0:F3}" LabelAbove="True"
                                Description="How much slip is needed before slip effects start. Above ~0.3 they never fire."
                                LowLabel="Reacts early" HighLabel="Only at big slides"
                                DefaultValue="{Binding BuiltInDefaults.Slip.SlipThreshold}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsSlipEnhancerVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <DockPanel Margin="0,6,0,10" Visibility="{Binding IsSlipEnhancerVisible, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding SlipUseFrontOnly}" VerticalAlignment="Top" Margin="0,3,12,0" />
                                <StackPanel>
                                    <TextBlock Text="Front Wheels Only" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Slip effects use only the front tyres (pure understeer feel; rear slides handled in Oversteer)." FontSize="12.5" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <controls:LabeledSlider Value="{Binding ScrubGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Front Tyre Scrub (texture)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Grainy 30-50 Hz texture as the fronts reach the limit — the rubber tearing before steering goes light. 0.15 subtle, 0.5 strong."
                                LowLabel="Off" HighLabel="Strong grain"
                                DefaultValue="{Binding BuiltInDefaults.Vibrations.ScrubGain}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsAcEvo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding SlipGain, Mode=TwoWay}" Minimum="0" Maximum="5" TickFrequency="0.05"
                                Label="Tyre Slip Vibration" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Vibration when tyres are slipping. Scaled by Vibration Master (Kerbs section)."
                                LowLabel="Off" HighLabel="Strong buzz"
                                DefaultValue="{Binding BuiltInDefaults.Vibrations.SlipGain}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsSlipVibrationVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding TyreGripScale, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.05"
                                Label="Grip Loss Lightening (RaceRoom)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="How much the wheel lightens as front grip falls. 1 = full grip = full force, no grip = 10%. (Capped at 1 — higher values inverted the force.)"
                                LowLabel="Constant weight" HighLabel="Goes light on understeer"
                                DefaultValue="1"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsRaceroom, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding GripScaleGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Lock/Spin Lightening (LMU)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="How much centring fades when the fronts lock or spin. LMU's own torque already lightens for normal understeer."
                                LowLabel="Always full force" HighLabel="Fades fully at hard lock-up"
                                DefaultValue="0.6"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding TyreTempGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Cold/Hot Tyre Texture (LMU)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Faint texture from tyres under 75°C or over 105°C. Very subtle even at 1."
                                LowLabel="Off" HighLabel="Max (still subtle)"
                                DefaultValue="0"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Cornering weight from G-force" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" Visibility="{Binding IsDynamicEffectsSectionVisible, Converter={StaticResource BoolToVis}}" />
                            <controls:LabeledSlider Value="{Binding CorneringForce, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                Label="Lateral G Weight" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Adds force from lateral G — a sense of how hard the car is cornering. Capped, so above ~1 changes little."
                                LowLabel="Off" HighLabel="More corner load"
                                DefaultValue="{Binding BuiltInDefaults.Dynamic.LateralGGain}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsDynamicEffectsSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Tyre flex (sidewall &amp; contact patch)" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" Visibility="{Binding IsLoadFlexVisible, Converter={StaticResource BoolToVis}}" />
                            <controls:LabeledSlider Value="{Binding TyreFlexGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                Label="Sidewall Flex" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Subtle force from the tyre carcass flexing on fast weight shifts: turn-in, braking, kerbs."
                                LowLabel="Rigid tyre" HighLabel="Rubbery, alive"
                                DefaultValue="{Binding BuiltInDefaults.TyreFlex.FlexGain}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsAcEvo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding LoadFlexGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                Label="Contact Patch Feel" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Feel the tyre footprint growing/shrinking under load and slip."
                                LowLabel="Off" HighLabel="More load texture"
                                DefaultValue="{Binding BuiltInDefaults.TyreFlex.LoadFlexGain}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsLoadFlexVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Detailed tyre flex" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" Visibility="{Binding IsLoadFlexVisible, Converter={StaticResource BoolToVis}}" />
                            <controls:LabeledSlider Value="{Binding CarcassStiffness, Mode=TwoWay}" Minimum="0.1" Maximum="3" TickFrequency="0.01"
                                Label="Carcass Stiffness" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Higher = stiffer tyre, less flex feel."
                                LowLabel="Soft, more flex" HighLabel="Stiff, less flex"
                                DefaultValue="{Binding BuiltInDefaults.TyreFlex.CarcassStiffness}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsAcEvo, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding FlexSmoothing, Mode=TwoWay}" Minimum="0" Maximum="0.9" TickFrequency="0.01"
                                Label="Flex Smoothing" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Smoothing on flex forces."
                                LowLabel="Raw, responsive" HighLabel="Smooth, laggy"
                                DefaultValue="{Binding BuiltInDefaults.TyreFlex.FlexSmoothing}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsLoadFlexVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding ContactPatchWeight, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Weight Transfer Influence" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="How much lateral load transfer changes the contact-patch feel."
                                LowLabel="Less" HighLabel="More"
                                DefaultValue="{Binding BuiltInDefaults.TyreFlex.ContactPatchWeight}"
                                SectionColor="{DynamicResource SectionTyreSlip}" Visibility="{Binding IsContactPatchWeightVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                        </StackPanel>

                        <!-- OVERSTEER & SLIDES -->
                        <StackPanel x:Name="DtlOversteer" Visibility="Collapsed">
                            <TextBlock Text="The rear stepping out, slide warnings, and how the wheel self-steers into countersteer." FontSize="13" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <controls:LabeledSlider Value="{Binding RearSlipGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Rear Slip Warning" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Low rumble (12-25 Hz) when the rear tyres lose grip — early oversteer warning."
                                LowLabel="Off" HighLabel="Strong warning"
                                DefaultValue="{Binding BuiltInDefaults.Vibrations.RearSlipGain}"
                                SectionColor="{DynamicResource SectionGripFeel}" Visibility="{Binding IsRearSlipWarningVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding SelfSteerGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.05"
                                Label="Slide Self-Steer (LMU)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="How much of LMU's slide torque you feel pulling into countersteer. 1 = full game force (can yank to lock in a spin)."
                                LowLabel="Wheel goes light in slides" HighLabel="Full countersteer pull"
                                DefaultValue="0.5"
                                SectionColor="{DynamicResource SectionGripFeel}" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding RearFyScale, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.05"
                                Label="Rear Slip Texture (LMU)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Oversteer texture from rear lateral force + yaw acceleration. Capped, so above ~1 adds little."
                                LowLabel="Off" HighLabel="Strong"
                                DefaultValue="0"
                                SectionColor="{DynamicResource SectionGripFeel}" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding RearGripDetailGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.05"
                                Label="Rear Grip Drop (LMU)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Adds to the rear warning as rear grip falls."
                                LowLabel="Off" HighLabel="Strong"
                                DefaultValue="0"
                                SectionColor="{DynamicResource SectionGripFeel}" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding YawOnsetGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.05"
                                Label="Slide Onset Kick (LMU)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Short steering kick as a slide starts. Needs Onset Threshold above 0."
                                LowLabel="Off" HighLabel="Bigger kick"
                                DefaultValue="0"
                                SectionColor="{DynamicResource SectionGripFeel}" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding YawOnsetThreshold, Mode=TwoWay}" Minimum="0" Maximum="10" TickFrequency="0.1"
                                Label="Onset Threshold (LMU)" StringFormat="{}{0:F1} rad/s²" LabelAbove="True"
                                Description="Yaw acceleration needed to fire the kick. 0 = never. Start near 2."
                                LowLabel="Fires on small twitches" HighLabel="Only big snaps"
                                DefaultValue="0"
                                SectionColor="{DynamicResource SectionGripFeel}" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding CarRotationForce, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.01"
                                Label="Yaw Rate Force" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Adds force from how fast the car is rotating. Helps feel slides and direction changes."
                                LowLabel="Off" HighLabel="More rotation feel"
                                DefaultValue="{Binding BuiltInDefaults.Dynamic.YawRateGain}"
                                SectionColor="{DynamicResource SectionGripFeel}" Visibility="{Binding IsDynamicEffectsSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Rear axle channels" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" />
                            <controls:LabeledSlider Value="{Binding MzRearGain, Mode=TwoWay}" Minimum="-2" Maximum="2" TickFrequency="0.01"
                                Label="Rear Self-Aligning (Mz)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Rear tyre aligning torque. Usually off; adds rear feel but more noise."
                                LowLabel="Off/reversed" HighLabel="More rear feel"
                                ShowCheckBox="True" IsChecked="{Binding MzRearEnabled}"
                                DefaultValue="{Binding BuiltInDefaults.MzRear.Gain}"
                                SectionColor="{DynamicResource SectionGripFeel}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding FyRearGain, Mode=TwoWay}" Minimum="-2" Maximum="2" TickFrequency="0.01"
                                Label="Rear Lateral Load (Fy)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Rear cornering force."
                                LowLabel="Off/reversed" HighLabel="More"
                                ShowCheckBox="True" IsChecked="{Binding FyRearEnabled}"
                                DefaultValue="{Binding BuiltInDefaults.FyRear.Gain}"
                                SectionColor="{DynamicResource SectionGripFeel}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                        </StackPanel>

                        <!-- BRAKING & ACCELERATION -->
                        <StackPanel x:Name="DtlBraking" Visibility="Collapsed">
                            <TextBlock Text="Steering weight under braking, lock-ups, ABS, wheelspin and traction control." FontSize="13" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="Weight under braking" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <controls:LabeledSlider Value="{Binding FxFrontGain, Mode=TwoWay}" Minimum="-2" Maximum="2" TickFrequency="0.01"
                                Label="Braking/Drive Force (Fx)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Front longitudinal tyre force — braking load and drive through the wheel."
                                LowLabel="Less" HighLabel="More brake weight"
                                ShowCheckBox="True" IsChecked="{Binding FxFrontEnabled}"
                                DefaultValue="{Binding BuiltInDefaults.FxFront.Gain}"
                                SectionColor="{DynamicResource SectionCrash}" Visibility="{Binding IsTyreChannelGame, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding FxScale, Mode=TwoWay}" Minimum="100" Maximum="20000" TickFrequency="100"
                                Label="Fx Scale (divisor)" StringFormat="{}{0:F0}" LabelAbove="True"
                                IsLogarithmic="True"
                                Description="Divides raw Fx. LOWER = stronger braking/accel feel."
                                LowLabel="Stronger" HighLabel="Weaker"
