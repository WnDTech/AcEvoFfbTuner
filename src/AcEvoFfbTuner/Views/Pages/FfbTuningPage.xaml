                                DefaultValue="1"
                                SectionColor="{DynamicResource SectionLfe}" Visibility="{Binding IsRaceroom, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <TextBlock Text="Detailed LFE" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <controls:LabeledSlider Value="{Binding LfeSuspensionDrive, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
                                Label="Suspension Drive" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="How much suspension movement drives the rumble."
                                LowLabel="Less" HighLabel="More reactive to bumps"
                                DefaultValue="{Binding BuiltInDefaults.Lfe.SuspensionDrive}"
                                SectionColor="{DynamicResource SectionLfe}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding LfeSpeedScaling, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
