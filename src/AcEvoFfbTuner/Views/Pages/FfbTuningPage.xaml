                                DefaultValue="{Binding BuiltInDefaults.StaticFriction.BreakoutFrequencyHz}"
                                SectionColor="{DynamicResource SectionDamping}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding StaticFrictionScrubGain, Mode=TwoWay}" Minimum="0" Maximum="1" TickFrequency="0.01"
