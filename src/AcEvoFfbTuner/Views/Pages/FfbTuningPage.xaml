                                DefaultValue="{Binding BuiltInDefaults.Vibrations.AbsPulseAmplitude}"
                                SectionColor="{DynamicResource SectionCrash}" Visibility="{Binding IsVibrationSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding BrakePressureGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.05"
                                Label="Brake Bite Texture (RaceRoom)" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Subtle texture from brake pressure telemetry."
                                LowLabel="Off" HighLabel="More bite"
                                DefaultValue="1"
                                SectionColor="{DynamicResource SectionCrash}" Visibility="{Binding IsRaceroom, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <DockPanel Margin="0,6,0,10" Visibility="{Binding IsLeMansUltimate, Converter={StaticResource BoolToVis}}">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding SynthAbsEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
