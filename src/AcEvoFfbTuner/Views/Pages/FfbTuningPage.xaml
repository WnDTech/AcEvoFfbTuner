                            <TextBlock Text="Rumble strips, bumps, road texture, grass, gravel and dirt." FontSize="13" Foreground="{DynamicResource UiTextDim}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <controls:LabeledSlider Value="{Binding VibrationMasterGain, Mode=TwoWay}" Minimum="0" Maximum="5" TickFrequency="0.05"
                                Label="Vibration Master" StringFormat="{}{0:F2}" LabelAbove="True"
                                Description="Volume knob for all vibrations (kerbs, slip, road, ABS)."
                                LowLabel="Quiet" HighLabel="Loud"
                                DefaultValue="{Binding BuiltInDefaults.Vibrations.MasterGain}"
                                SectionColor="{DynamicResource SectionVibration}" Visibility="{Binding IsVibrationSectionVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
