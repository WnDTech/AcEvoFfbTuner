                                DefaultValue="{Binding BuiltInDefaults.Lfe.SpeedScaling}"
                                SectionColor="{DynamicResource SectionLfe}" Margin="0,0,0,22" />
                            <TextBlock Text="Gear shifts" Style="{StaticResource SubSectionHeader}" Margin="0,18,0,8" />
                            <DockPanel Margin="0,6,0,10">
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding GearChangeMuteEnabled}" VerticalAlignment="Top" Margin="0,3,12,0" />
