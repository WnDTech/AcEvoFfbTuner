                                DefaultValue="1"
                                SectionColor="{DynamicResource SectionVibration}" Visibility="{Binding IsRaceroom, Converter={StaticResource BoolToVis}}" Margin="0,0,0,22" />
                            <controls:LabeledSlider Value="{Binding BumpTwistGain, Mode=TwoWay}" Minimum="0" Maximum="2" TickFrequency="0.05"
