<UserControl x:Class="AcEvoFfbTuner.Views.Pages.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AcEvoFfbTuner.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="FilterPillStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF8B949E" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FFF0883E" />
                    <Setter Property="Foreground" Value="#FF000000" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF30363D" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FF8B949E" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#FF2D333B" />
                    <Setter Property="Foreground" Value="#FFE6EDF3" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF30363D" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="370" MinWidth="320" MaxWidth="440" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: COMPACT PROFILE NAV (click a section → details on the right) ═══ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="24,16,12,20">
            <StackPanel>

                <TextBlock Text="P R O F I L E S" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,8" />
                <TextBlock Text="Manage your FFB profiles for different cars and tracks." FontSize="12"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />

                <!-- CURRENT PROFILE -->
                <controls:SectionCard Title="CURRENT PROFILE"
                                      Tag="Current"
                                      SectionBrush="#FFF0883E"
                                      Selectable="True" IsSelected="True">
                    <controls:SectionCard.SummaryContent>
                        <TextBlock FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap">
                            <Run Text="{Binding SelectedProfile.Name, FallbackValue='No profile', TargetNullValue='No profile'}" Foreground="#FFF0883E" />
                            <Run Text="{Binding ProfileCarMatch, StringFormat='  ·  Car: {0}'}" Foreground="#FF8B949E" />
                            <Run Text="{Binding ProfileTrackMatch, StringFormat='  ·  Track: {0}'}" Foreground="#FF8B949E" />
                        </TextBlock>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

                <!-- DETECTION -->
                <controls:SectionCard Title="DETECTION"
                                      Tag="Detection"
                                      SectionBrush="#FF79C0FF"
                                      Selectable="True">
                    <controls:SectionCard.SummaryContent>
                        <TextBlock FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap">
                            <Run Text="{Binding DetectedCarModel, StringFormat='Car: {0}'}" Foreground="#FF79C0FF" />
                            <Run Text="  ·  " /><Run Text="{Binding DetectedTrackName, StringFormat='Track: {0}'}" Foreground="#FF79C0FF" />
                            <Run Text="  ·  " /><Run Text="{Binding IsPerCarAutoLoadEnabled, StringFormat='Auto-load: {0}'}" Foreground="#FF79C0FF" />
                        </TextBlock>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

                <!-- ACTIONS -->
                <controls:SectionCard Title="ACTIONS"
                                      Tag="Actions"
                                      SectionBrush="#FF56D4A0"
                                      Selectable="True">
                    <controls:SectionCard.SummaryContent>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="13" Foreground="#FF8B949E">
                                <Run Text="Save · Save As · Rename · Delete" Foreground="#FF56D4A0" />
                            </TextBlock>
                            <Border Background="#30363D" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                    Visibility="{Binding IsBuiltInProfileSelected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="BUILT-IN" FontSize="10" FontWeight="Bold" Foreground="#FF8B949E" />
                            </Border>
                        </StackPanel>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

                <!-- IMPORT / EXPORT -->
                <controls:SectionCard Title="IMPORT / EXPORT"
                                      Tag="Import"
                                      SectionBrush="#FFD2A8FF"
                                      Selectable="True">
                    <controls:SectionCard.SummaryContent>
                        <TextBlock FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap">
                            <Run Text="JSON export · Import · " Foreground="#FFD2A8FF" />
                            <Run Text="Share to Hub" />
                        </TextBlock>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

                <!-- PROFILE BROWSER -->
                <controls:SectionCard Title="PROFILE BROWSER"
                                       Tag="Browser"
                                       SectionBrush="#FFE3B341"
                                       Selectable="True">
                    <controls:SectionCard.SummaryContent>
                        <TextBlock FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap">
                            <Run Text="{Binding Profiles.Count, Mode=OneWay, StringFormat='{}{0} profiles'}" Foreground="#FFE3B341" />
                            <Run Text="  ·  " /><Run Text="search, filter, group by track or car" Foreground="#FFE3B341" />
                        </TextBlock>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

                <!-- A/B COMPARE -->
                <controls:SectionCard Title="A/B COMPARE"
                                       Tag="AbCompare"
                                       SectionBrush="#FF4FC3F7"
                                       Selectable="True">
                    <controls:SectionCard.SummaryContent>
                        <TextBlock FontSize="13" Foreground="#FF8B949E" TextWrapping="Wrap">
                            <Run Text="{Binding AbActiveSlot, Mode=OneWay, StringFormat='Active: {0}', FallbackValue='Active: —'}" Foreground="#FF4FC3F7" />
                            <Run Text="  ·  " /><Run Text="capture two setups, toggle, diff" Foreground="#FF4FC3F7" />
                        </TextBlock>
                    </controls:SectionCard.SummaryContent>
                </controls:SectionCard>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ RIGHT: SELECTED PROFILE SECTION ═══ -->
        <Border Grid.Column="1" Margin="0,16,24,20"
                Background="{StaticResource BgPanel}"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Section header -->
                    <StackPanel Margin="24,20,24,0">
                        <DockPanel>
                            <Border x:Name="DetailHeaderAccent" DockPanel.Dock="Left" Width="4"
                                    CornerRadius="2" Background="#FFF0883E"
                                    VerticalAlignment="Stretch" />
                            <TextBlock x:Name="DetailHeader" Text="CURRENT PROFILE" FontSize="18" FontWeight="Bold"
                                       Foreground="#FFF0883E"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </DockPanel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,12,0,16" />
                    </StackPanel>

                    <!-- CURRENT PROFILE -->
                    <StackPanel x:Name="DtlCurrent">
                        <TextBlock Text="Select and configure the active FFB profile." FontSize="14" Foreground="#FF8B949E" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <Border Background="#FF1C2128" CornerRadius="8" Padding="16,14"
                                BorderThickness="1" BorderBrush="#FF30363D">
                            <StackPanel>
                                <TextBlock Text="Active Profile" FontSize="15" Foreground="#FFE6EDF3" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                          DisplayMemberPath="Name" FontSize="14" Padding="6,4" Margin="0,0,0,12" />

                                <TextBlock Text="Car Match" FontSize="14" Foreground="#FFE6EDF3" Margin="0,0,0,4" />
                                <TextBlock Text="Auto-load this profile when the detected car matches." FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ProfileCarMatch, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="14" Padding="6,4" Margin="0,0,6,0"
                                             ToolTip="AC EVO car model name for auto-loading this profile" />
                                    <Button Grid.Column="1" Content="Use Detected" Command="{Binding SetCarMatchFromDetectedCommand}"
                                            Padding="10,4" FontSize="13" Style="{StaticResource OutlinedButton}"
                                            ToolTip="Fill from detected car model" />
                                </Grid>

                                <TextBlock Text="Track Match" FontSize="14" Foreground="#FFE6EDF3" Margin="0,0,0,4" />
                                <TextBlock Text="Organise profiles by track for easy browsing." FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding ProfileTrackMatch, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="14" Padding="6,4" Margin="0,0,6,0"
                                             ToolTip="AC EVO track name for organising profiles by track" />
                                    <Button Grid.Column="1" Content="Use Detected" Command="{Binding SetTrackMatchFromDetectedCommand}"
                                            Padding="10,4" FontSize="13" Style="{StaticResource OutlinedButton}"
                                            ToolTip="Fill from detected track name" />
                                </Grid>

                                <TextBlock Text="Auto Setup" FontSize="14" Foreground="#FFE6EDF3" Margin="0,12,0,4" />
                                <TextBlock Text="Generate a wheel-matched profile from the connected device." FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,4" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Auto Setup from Wheel" Command="{Binding AutoSetupCommand}"
                                            IsEnabled="{Binding IsAutoSetupAvailable}"
                                            Padding="10,4" FontSize="13" Style="{StaticResource OutlinedButton}"
                                            ToolTip="Create a profile tuned to the connected wheelbase torque" />
                                    <TextBlock Text="{Binding AutoSetupStatus}" FontSize="12" Foreground="#FF8B949E"
                                               VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- DETECTION -->
                    <StackPanel x:Name="DtlDetection" Visibility="Collapsed">
                        <TextBlock Text="Live telemetry detection from AC EVO." FontSize="14" Foreground="#FF8B949E" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <Border Background="#FF1C2128" CornerRadius="8" Padding="16,14"
                                BorderThickness="1" BorderBrush="#FF30363D">
                            <StackPanel>
                                <TextBlock Text="Detected Car" FontSize="14" Foreground="#FF8B949E" Margin="0,0,0,4" />
                                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF66BB6A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetectedCarModel}" Value="">
                                                    <Setter Property="Foreground" Value="#FF484F58" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Text" Value="No car detected — start a session" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Text>
                                        <Binding Path="DetectedCarModel" />
                                    </TextBlock.Text>
                                </TextBlock>

                                <Border Background="#FF30363D" Height="1" Margin="0,0,0,14" />

                                <TextBlock Text="Detected Track" FontSize="14" Foreground="#FF8B949E" Margin="0,0,0,4" />
                                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF66BB6A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DetectedTrackName}" Value="">
                                                    <Setter Property="Foreground" Value="#FF484F58" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Setter Property="Text" Value="No track detected — start a session" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Text>
                                        <Binding Path="DetectedTrackName" />
                                    </TextBlock.Text>
                                </TextBlock>

                                <Border Background="#FF30363D" Height="1" Margin="0,0,0,14" />

                                <CheckBox Content="Auto-load profile when car changes" IsChecked="{Binding IsPerCarAutoLoadEnabled}"
                                          FontSize="13" Foreground="#FFE6EDF3" Margin="0,0,0,4"
                                          ToolTip="Automatically switch profiles when a different car is detected in-game" />
                                <TextBlock Text="When enabled, switching cars in-game will automatically load the matching profile." FontSize="12" Foreground="#FF8B949E" Margin="28,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ACTIONS -->
                    <StackPanel x:Name="DtlActions" Visibility="Collapsed">
                        <TextBlock Text="Save, rename, or delete the current profile." FontSize="14" Foreground="#FF8B949E" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <Border Background="#FF1C2128" CornerRadius="8" Padding="16,14"
                                BorderThickness="1" BorderBrush="#FF30363D">
                            <StackPanel>
                                <Button Content="Save Current Profile" Command="{Binding SaveCurrentProfileCommand}" Margin="0,0,0,6" Padding="16,6" HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="ToolTip" Value="Save current profile" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuiltInProfileSelected}" Value="True">
                                                    <Setter Property="Content" Value="Save Current Profile (Built-in → Save As)" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Save As New Profile..." Command="{Binding SaveAsNewProfileCommand}" Margin="0,0,0,6" Padding="16,6" HorizontalAlignment="Stretch" ToolTip="Save current settings as a new profile" />
                                <Button Content="Rename Profile" Command="{Binding RenameProfileCommand}" Margin="0,0,0,6" Padding="16,6" HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuiltInProfileSelected}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="ToolTip" Value="Built-in profiles cannot be renamed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Delete Profile" Command="{Binding DeleteProfileCommand}" Padding="16,6" HorizontalAlignment="Stretch">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#FFDA3633" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBuiltInProfileSelected}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Setter Property="ToolTip" Value="Built-in profiles cannot be deleted" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- IMPORT / EXPORT -->
                    <StackPanel x:Name="DtlImport" Visibility="Collapsed">
                        <TextBlock Text="Share profiles or back them up to file." FontSize="14" Foreground="#FF8B949E" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <Border Background="#FF1C2128" CornerRadius="8" Padding="16,14"
                                BorderThickness="1" BorderBrush="#FF30363D">
                            <StackPanel>
                                <TextBlock Text="Export saves the current profile as a JSON file you can share. Import loads a profile from file and adds it to your collection." FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <Button Content="Export Profile" Command="{Binding ExportProfileCommand}" Margin="0,0,0,6" Padding="16,6" HorizontalAlignment="Stretch" Style="{StaticResource OutlinedButton}" ToolTip="Export current profile to a JSON file" />
                                <Button Content="Import Profile" Command="{Binding ImportProfileCommand}" Margin="0,0,0,6" Padding="16,6" HorizontalAlignment="Stretch" Style="{StaticResource OutlinedButton}" ToolTip="Import a profile from a JSON file" />
                                <Button Content="Share to Hub..." Command="{Binding ShareProfileToHubCommand}" Padding="16,6" HorizontalAlignment="Stretch" ToolTip="Submit the current profile to the community Profile Hub for review" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PROFILE BROWSER -->
                    <StackPanel x:Name="DtlBrowser" Visibility="Collapsed">
                        <TextBlock Text="Browse and organise your profiles by list, track, or car." FontSize="14" Foreground="#FF8B949E" Margin="0,0,0,12" TextWrapping="Wrap" />

                        <!-- Modern filter bar -->
                        <Border Background="#FF1C2128" CornerRadius="8" BorderThickness="1" BorderBrush="#FF30363D" Padding="0" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Row 1: Search + View mode -->
                                <Grid Margin="8,6,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Search box -->
                                    <Border Background="#FF161B22" CornerRadius="6" Padding="8,4" BorderThickness="1" BorderBrush="#FF30363D">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="&#x1F50D;" FontSize="11" Foreground="#FF8B949E" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="#FFE6EDF3" FontSize="12"
                                                     TextChanged="OnSearchTextChanged"
                                                     ToolTip="Search profiles by name" />
                                        </Grid>
                                    </Border>

                                    <!-- View mode toggle -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                        <RadioButton x:Name="ViewList" GroupName="ProfileViewMode" IsChecked="True"
                                                     Checked="OnViewModeChanged" ToolTip="List View"
                                                     Style="{StaticResource IconRadioButton}"
                                                     FontFamily="Segoe MDL2 Assets" Content="&#xE8FD;" />
                                        <RadioButton x:Name="ViewByTrack" GroupName="ProfileViewMode"
                                                     Checked="OnViewModeChanged" ToolTip="Group by Track"
                                                     Style="{StaticResource IconRadioButton}"
                                                     FontSize="16" Content="⎔" />
                                        <RadioButton x:Name="ViewByCar" GroupName="ProfileViewMode"
                                                     Checked="OnViewModeChanged" ToolTip="Group by Car"
                                                     Style="{StaticResource IconRadioButton}"
                                                     FontFamily="Segoe MDL2 Assets" Content="&#xE804;" />
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Background="#FF30363D" Height="1" Margin="0,0,0,4" />

                                <!-- Row 2: Game filter pills -->
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,8">
                                    <RadioButton x:Name="GameFilterAll" Content="All Games" GroupName="GameFilter" IsChecked="True"
                                                 Style="{StaticResource FilterPillStyle}"
                                                 Checked="OnGameFilterChanged" />
                                    <RadioButton x:Name="GameFilterAcEvo" Content="AC EVO" GroupName="GameFilter"
                                                 Style="{StaticResource FilterPillStyle}"
                                                 Checked="OnGameFilterChanged" />
                                    <RadioButton x:Name="GameFilterRaceroom" Content="RaceRoom" GroupName="GameFilter"
                                                 Style="{StaticResource FilterPillStyle}"
                                                 Checked="OnGameFilterChanged" />
                                    <RadioButton x:Name="GameFilterAssettoCorsa" Content="Assetto Corsa" GroupName="GameFilter"
                                                 Style="{StaticResource FilterPillStyle}"
                                                 Checked="OnGameFilterChanged" />
                                    <RadioButton x:Name="GameFilterLeMansUltimate" Content="Le Mans Ultimate" GroupName="GameFilter"
                                                 Style="{StaticResource FilterPillStyle}"
                                                 Checked="OnGameFilterChanged" />
                                    <RadioButton x:Name="GameFilterAcc" Content="ACC" GroupName="GameFilter"
                                                 Style="{StaticResource FilterPillStyle}"
                                                 Checked="OnGameFilterChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Profile list / tree -->
                        <Border Background="#FF161B22" CornerRadius="8" BorderThickness="1" BorderBrush="#FF30363D">
                            <StackPanel x:Name="ProfileBrowserPanel" />
                        </Border>
                    </StackPanel>

                    <!-- A/B COMPARE -->
                    <StackPanel x:Name="DtlAbCompare" Visibility="Collapsed">
                        <TextBlock Text="Capture two live setups, toggle between them, and see exactly what differs." FontSize="14" Foreground="#FF8B949E" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <Border Background="#FF1C2128" CornerRadius="8" Padding="16,14"
                                BorderThickness="1" BorderBrush="#FF30363D">
                            <StackPanel>
                                <TextBlock Text="{Binding AbSlotAName, FallbackValue='A: (empty)'}" FontSize="13" Foreground="#FF4FC3F7" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding AbSlotBName, FallbackValue='B: (empty)'}" FontSize="13" Foreground="#FF4FC3F7" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Button Content="Capture A" Command="{Binding CaptureAbSlotACommand}" Padding="10,4" FontSize="13" Style="{StaticResource OutlinedButton}" Margin="0,0,6,0" ToolTip="Snapshot current settings into slot A" />
                                    <Button Content="Capture B" Command="{Binding CaptureAbSlotBCommand}" Padding="10,4" FontSize="13" Style="{StaticResource OutlinedButton}" Margin="0,0,6,0" ToolTip="Snapshot current settings into slot B" />
                                    <Button Content="Toggle A/B" Command="{Binding ToggleAbSlotCommand}" Padding="10,4" FontSize="13" ToolTip="Switch live FFB between slot A and slot B" />
                                </StackPanel>
                                <TextBlock Text="{Binding AbActiveSlot, StringFormat='Active slot: {0}', FallbackValue='Active slot: —'}" FontSize="12" Foreground="#FF8B949E" Margin="0,0,0,6" />
                                <TextBox Text="{Binding AbDiffText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" FontSize="12" MinHeight="120" MaxHeight="240"
                                         VerticalScrollBarVisibility="Auto" Background="#FF161B22" Foreground="#FFE6EDF3"
                                         BorderThickness="1" BorderBrush="#FF30363D" Padding="8" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="LAP DELTA" FontSize="12" FontWeight="Bold" Foreground="#FF4FC3F7" VerticalAlignment="Center" />
                                    <Button Content="Refresh" Command="{Binding RefreshAbLapSummaryCommand}" Padding="10,2" FontSize="12" Style="{StaticResource OutlinedButton}" Margin="8,0,0,0" ToolTip="Re-read completed laps grouped by setup" />
                                </StackPanel>
                                <TextBox Text="{Binding AbLapSummaryText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" FontSize="12" MinHeight="80" MaxHeight="200"
                                         VerticalScrollBarVisibility="Auto" Background="#FF161B22" Foreground="#FFE6EDF3"
                                         BorderThickness="1" BorderBrush="#FF30363D" Padding="8" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>