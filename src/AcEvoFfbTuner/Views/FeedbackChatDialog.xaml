<Window x:Class="AcEvoFfbTuner.Views.FeedbackChatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Support Chat — Feedback Reports"
        Width="640"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Support Chat" FontSize="18" FontWeight="Bold" Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Report:" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF888888" />
            <ComboBox x:Name="ReportCombo" Width="220" FontSize="14" DisplayMemberPath="ReportId" SelectionChanged="OnReportSelected" />
            <Button Content="Refresh" Width="80" Margin="10,0,0,0" Padding="10,4" Click="OnRefresh" />
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#FF888888" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <ListBox Grid.Row="2" x:Name="ConversationBox" FontSize="14"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#FF14171B" BorderBrush="#FF2A2E35"
                 Padding="8" />

        <TextBox Grid.Row="3" x:Name="ReplyBox" FontSize="14" TextWrapping="Wrap"
                 Height="64" Margin="0,10,0,0" Padding="8,6" KeyDown="OnReplyKeyDown" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Send Reply" Width="110" Margin="0,0,10,0" Padding="16,6" Click="OnSend" IsDefault="True" />
            <Button Content="Close" Width="90" Padding="16,6" Style="{StaticResource OutlinedButton}" Click="OnClose" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
